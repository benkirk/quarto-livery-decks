# build/livery.mplstyle: GENERATED by livery_build.py from livery.json charts; do not edit.
# livery nasa, light; sizes in points on its 10 x 5.625 in canvas: draw at charts.figsize.
font.family: sans-serif
font.sans-serif: Public Sans, DejaVu Sans
font.size: 9
mathtext.fontset: custom
mathtext.rm: Public Sans
mathtext.sf: Public Sans
mathtext.it: Public Sans:italic
mathtext.bf: Public Sans:bold
mathtext.fallback: stixsans
text.color: 1C1C1C
axes.labelcolor: 1C1C1C
axes.edgecolor: 5C5E62
axes.facecolor: none
axes.labelsize: 12
axes.titlesize: 12
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['1159CD', 'EF483F', 'E8892E', '386470', 'B0A26A', '3F83EF', '8F0800', '79A3AD', '3E1C99', 'E09D00', '387D00', '0CC9AC'])
grid.color: B0B1B2
grid.linewidth: 0.5
xtick.color: 5C5E62
ytick.color: 5C5E62
xtick.labelcolor: 1C1C1C
ytick.labelcolor: 1C1C1C
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10
legend.title_fontsize: 10
legend.frameon: False
lines.linewidth: 2.0
patch.edgecolor: FFFFFF
figure.facecolor: none
figure.edgecolor: none
figure.titlesize: 16
figure.figsize: 8.8, 4.25
figure.constrained_layout.use: True
savefig.facecolor: none
savefig.edgecolor: none
savefig.transparent: True
savefig.dpi: 200
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: path
