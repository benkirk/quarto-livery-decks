#!/usr/bin/env bash
# new-deck [--bare] DIR: a deck directory building against this checkout (docs/container.md
# "Sharing an installation"):
#   DIR/<name>.qmd   the quickstart deck, renamed for DIR (make names the outputs after DIR)
#   DIR/images/      its picture
#   DIR/Makefile     QUARTO_DECKS ?= <this checkout>, then include $(QUARTO_DECKS)/Make.common
#   DIR/.gitignore   the links and outputs a build writes
# --bare writes only the Makefile and .gitignore, into a directory that may hold files already (a
# repository's own deck): it refuses an existing Makefile, and adds to an existing .gitignore only
# the lines it lacks. Then: cd DIR && make pptx. Bash only, so it runs before any toolchain is set
# up; a link to it anywhere finds this checkout, as bin/livery does.
set -euo pipefail
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do   # follow links to this file
  dir=$(cd "$(dirname "$src")" && pwd -P)
  src=$(readlink "$src")
  [[ $src == /* ]] || src=$dir/$src
done
fw=$(cd "$(dirname "$src")/.." && pwd -P)

bare=
[ "${1:-}" = --bare ] && { bare=1; shift; }
if [ $# -ne 1 ] || [[ $1 == -* ]]; then
  echo "usage: new-deck [--bare] DIR   (a new deck from $fw/decks/quickstart; --bare: Makefile and .gitignore only)" >&2
  exit 2
fi
deck=$1
name=$(basename "$deck")
case $name in
  ""|.|..|*[!A-Za-z0-9._-]*) [ -n "$bare" ] || { echo "new-deck: '$name' names the deck's files: letters, digits, '.', '_' and '-' only" >&2; exit 2; } ;;
esac
case $fw in
  *[[:space:]%#]*) echo "new-deck: the framework's path '$fw' has a space, % or #, which make and LaTeX cannot take" >&2; exit 1 ;;
esac
if [ -n "$bare" ]; then
  if [ -e "$deck/Makefile" ]; then
    echo "new-deck: $deck/Makefile exists; add QUARTO_DECKS ?= $fw and include \$(QUARTO_DECKS)/Make.common to it" >&2
    exit 1
  fi
elif [ -e "$deck" ] && [ -n "$(ls -A "$deck")" ]; then
  echo "new-deck: $deck exists and is not empty (new-deck --bare $deck adds only a Makefile and .gitignore)" >&2
  exit 1
fi

mkdir -p "$deck"
if [ -z "$bare" ]; then
  cp "$fw/decks/quickstart/quickstart.qmd" "$deck/$name.qmd"
  cp -R "$fw/decks/quickstart/images" "$deck/images"
fi
cat > "$deck/Makefile" <<EOF
# A deck on the framework at $fw (docs/container.md "Sharing an installation").
# make pptx | html | pdf | all | qa: natively in its conda env, else in its image (DECKS_RUNTIME).
# Another framework checkout: make QUARTO_DECKS=<checkout>.
QUARTO_DECKS ?= $fw
include \$(QUARTO_DECKS)/Make.common

# Rules of the deck's own run where the deck builds, never again on the host (docs/container.md
# "From your deck's Makefile"):
# ifeq (\$(DECKS_RUNTIME_USED),native)
# ingest:
# 	python3 -m mypackage.ingest
# endif
EOF
# Quarto's own spellings (/.quarto/, **/*.quarto_ipynb): it appends them to a .gitignore that lacks them
ignore=$(cat <<'EOF'
# links Make.common creates, and its livery stamp
_quarto.yml
_extensions
_livery
.livery

# Quarto's caches and the build outputs
/.quarto/
**/*.quarto_ipynb
*_files/
_qa/
*.pptx
*.html
*.pdf
~$*
EOF
)
if [ -s "$deck/.gitignore" ]; then
  missing=$(printf '%s\n' "$ignore" | grep -v '^#' | grep . | grep -vxF -f "$deck/.gitignore" || true)
  [ -z "$missing" ] || printf '\n# what a deck build writes (new-deck)\n%s\n' "$missing" >> "$deck/.gitignore"
else
  printf '%s\n' "$ignore" > "$deck/.gitignore"
fi
if [ -n "$bare" ]; then
  echo "new deck: $deck/Makefile and .gitignore, on $fw"
  echo "next:     cd $deck && make pptx      (builds $name.qmd; for other names, DECKS := a b above the include)"
else
  echo "new deck: $deck/$name.qmd, on $fw"
  echo "next:     cd $deck && make pptx      (or html, pdf, all, qa)"
fi
