# Shared recipes for decks (pptx, revealjs, beamer). A deck Makefile includes
# this file by a path relative to the deck directory: `include ../../Make.common`
# for decks/<deck>/ here, `include ../framework/Make.common` in a repo that
# has this framework as a submodule (docs/other-repos.md). Include it; a symlink to it would point FRAMEWORK_ROOT at the
# link's own directory. One deck per directory by default, named after the
# directory (OUT); a directory holding several decks lists them in DECKS (each
# <name>.qmd builds <name>.{pptx,html,pdf}). `site` gathers the HTML decks into
# one static site and `publish` pushes it to a GitHub Pages branch (docs/other-repos.md
# "Publishing the HTML decks"). With no Makefile at all, `make -f <framework>/Make.common
# DECKS="a b"` works the same (the container's entrypoint does that, docs/container.md): this file reads its own location from MAKEFILE_LIST.
# DECKS_RUNTIME picks where the toolchain comes from (docs/container.md "From your deck's Makefile"):
# native, the activated conda env, runs the recipes below; docker, podman or apptainer run the same
# make once in the published image (common/Make.container); auto, the default, is native when
# quarto is on PATH, else the first of apptainer, docker, podman installed. A deck's own Python
# packages: a pinned requirements.txt beside its Makefile, installed once by `make deps`.
# Names (the GNU make manual's rule): UPPER CASE is a knob you set (`?=`, `override`, an export)
# or a documented read-out (DECKS_RUNTIME_USED, FRAMEWORK_ROOT); lower case is this file's own,
# like its defines. tests/test_make_names.py holds both, and that no name expands undefined.

.PHONY: pptx html pdf all qa shot measure site publish overleaf charts-zip deps clean distclean

# Every deck in a directory shares one .quarto/ project cache.
.NOTPARALLEL:
# A failed post-render step must not leave a "finished" output behind.
.DELETE_ON_ERROR:

FRAMEWORK_ROOT := $(dir $(lastword $(MAKEFILE_LIST)))
# An installation's own settings (untracked; docs/container.md "Sharing an installation"): its
# site's file systems (DECKS_BINDS), a default runtime. Read before anything uses them, with `?=`
# in it, so a user's environment or command line still wins.
-include $(FRAMEWORK_ROOT)site.mk

# Where the toolchain comes from. The image runs its make with DECKS_RUNTIME=native on the
# command line (and in its ENV), so a build inside it never dispatches again. With no quarto on
# PATH, the framework checkout's own conda-env/ (when it exists and conda is on PATH) comes
# before the image: common/Make.conda runs the same make under `conda run` (#143).
DECKS_RUNTIME ?= auto
ifeq ($(DECKS_RUNTIME),auto)
DECKS_RUNTIME_USED := $(if $(shell command -v quarto 2>/dev/null),native,$(if $(and $(wildcard \
  $(FRAMEWORK_ROOT)conda-env/bin/quarto),$(shell command -v conda 2>/dev/null)),conda,$(firstword \
  $(foreach r,apptainer docker podman,$(if $(shell command -v $(r) 2>/dev/null),$(r))))))
ifeq ($(DECKS_RUNTIME_USED),)
$(error no toolchain: activate the framework's conda env or build it (`make conda-env`, docs/formats.md), or install Docker, Podman or Apptainer to build in its image (docs/container.md))
endif
else
DECKS_RUNTIME_USED := $(DECKS_RUNTIME)
endif

OUT   ?= $(notdir $(CURDIR))
DECKS ?= $(OUT)
QFILE ?= $(OUT).qmd

# The static site (`site`) and where `publish` pushes it. SITE_EXTRA lists
# directories of hand-written pages to ship beside the decks; SITE_NOINDEX (any
# value) marks every page noindex for search engines; PUBLISH_PREFIX is the
# site's path under the Pages root (empty: the root itself).
SITE           ?= _site
SITE_EXTRA     ?=
SITE_NOINDEX   ?=
PUBLISH_BRANCH ?= gh-pages
PUBLISH_REMOTE ?= origin
PUBLISH_PREFIX ?=

# Push the site as the ONE commit on PUBLISH_BRANCH. The branch is a build artifact,
# not a record: every publish replaces it, so nothing accumulates. A parentless commit
# gives git no edge to delta against, so each publish uploads the whole site (the
# shared libs/ plus ~1 MB per deck); fetching the old tip first does not change that.
# Shared by both runtimes: the push always runs on the host, with its git credentials.
define publish_push
	set -e; tmp=$$(mktemp -d); url=$$(git remote get-url $(PUBLISH_REMOTE)); \
	git -C $$tmp init -q; \
	mkdir -p $$tmp/$(PUBLISH_PREFIX); rsync -a $(SITE)/ $$tmp/$(PUBLISH_PREFIX)/; \
	touch $$tmp/.nojekyll; \
	git config user.email >/dev/null || ident="-c user.name=make-publish -c user.email=publish@localhost"; \
	git -C $$tmp add -A; \
	git -C $$tmp $$ident commit -q -m "Publish $(OUT) $$(date -u +%Y-%m-%dT%H:%MZ)"; \
	git -C $$tmp push -q --force $$url HEAD:refs/heads/$(PUBLISH_BRANCH); \
	rm -rf $$tmp; \
	echo "pushed $(PUBLISH_BRANCH) to $$url"; \
	echo "$$url" | sed -n -E -e 's#\.git$$##' \
	  -e 's#^(git@github\.com:|https://github\.com/)([^/]+)/(.+)$$#https://\2.github.io/\3/$(if $(PUBLISH_PREFIX),$(PUBLISH_PREFIX)/)#p'
endef

ifeq ($(DECKS_RUNTIME_USED),conda)
include $(FRAMEWORK_ROOT)common/Make.conda
else ifneq ($(DECKS_RUNTIME_USED),native)
include $(FRAMEWORK_ROOT)common/Make.container
else
# ---- native: the activated conda env (or the image itself) ----

pptx_post          := $(FRAMEWORK_ROOT)_extensions/engine/pptx_post.py
livery_py          := $(FRAMEWORK_ROOT)_extensions/engine/livery.py
deck_qa            := $(FRAMEWORK_ROOT)common/utils/deck_qa.py
slide_shot         := $(FRAMEWORK_ROOT)common/utils/slide_shot.py
comp_measure       := $(FRAMEWORK_ROOT)common/utils/comp_measure.py
site_index         := $(FRAMEWORK_ROOT)common/utils/site_index.py
deck_deps       := $(FRAMEWORK_ROOT)common/utils/deck_deps.py
shared_quarto_yml  := $(FRAMEWORK_ROOT)common/_quarto.yml
shared_extensions  := $(FRAMEWORK_ROOT)_extensions
shared_liveries    := $(FRAMEWORK_ROOT)liveries
livery_mpl_dir     := $(abspath $(FRAMEWORK_ROOT)_extensions/engine/mpl)

# The brand: a directory under liveries/ (design/engine-and-liveries.md,
# section 4). `make LIVERY=cu` switches it; LIVERY_DIR is exported for the post-render
# steps (pptx_post.py), which read $(LIVERY_DIR)/build/livery.json through the engine's livery.py.
LIVERY     ?= ncar
LIVERY_DIR ?= $(shared_liveries)/$(LIVERY)
# A sub-make inherits the exported LIVERY_DIR, which `?=` would keep: an explicit
# LIVERY= on its command line must win (gallery.py's `make html LIVERY=cu` once
# stamped cu and linked ncar).
ifeq ($(origin LIVERY),command line)
override LIVERY_DIR := $(shared_liveries)/$(LIVERY)
endif
export LIVERY_DIR

# Included fragments, frozen data, images, deck-local Lua filters, bibliographies, CSL styles and
# directory metadata: {{< include >}}, ![](...), filters:, bibliography: and _metadata.yml are
# invisible to make, so an edit to any of them rebuilds every deck in the directory.
fragments := $(wildcard _*.qmd) $(wildcard data/*) $(wildcard images/*) $(wildcard *.lua) $(wildcard *.bib) $(wildcard *.csl)
# The livery's files (build/, template, fonts, logos, art, its parent's too): the _livery link's
# mtime does not change when a file in the livery does.
livery_files := $(shell python3 $(livery_py) deps $(LIVERY_DIR))
# the livery's code face (typography.monospace): pandoc's pptx writer takes it as monofont
livery_mono  := $(shell python3 $(livery_py) mono $(LIVERY_DIR))
# Plots (design/charts-and-plots.md): matplotlib reads the livery's style with no code at all,
# `import livery_mpl` finds the helper (fonts, colormaps, figsize(), dark()), and a figure's
# default size is the content area in canvas inches (charts.figsize.full), so its text is the
# slide's size. A cell's own fig-width/fig-height still wins. Not for beamer, whose fig-width is
# paper inches and sizes its baked diagrams; there livery_mpl sets the plots' size itself.
export MATPLOTLIBRC := $(abspath $(LIVERY_DIR))/build/livery.mplstyle
# gnuplot's: `load 'livery.gp'` finds the livery's style (livery_gp.plot() loads it itself)
export GNUPLOT_LIB  := $(abspath $(LIVERY_DIR))/build
# A deck's own Python packages (docs/container.md "From your deck's Makefile"): requirements.txt
# beside the Makefile, pinned, installed once by `make deps` (deck_deps.py) into a venv on this
# env's site-packages under DECKS_DEPS, keyed by the engine, the Python, the platform and the
# file, so a container's folder is the image's and a native one the env's; in a container HOME
# is DECKS_HOME, so it lands there. Its site-packages link goes on PYTHONPATH (the kernel
# inherits it) and is a prerequisite: a missing folder stops the build before quarto (the rule
# below), an edit re-keys it.
DECKS_DEPS ?= $(HOME)/.cache/quarto-livery-decks
requirements  := $(wildcard requirements.txt)
deps_site  := $(if $(requirements),$(shell python3 $(deck_deps) dir $(DECKS_DEPS) $(requirements))/site-packages)
export PYTHONPATH   := $(livery_mpl_dir)$(if $(deps_site),:$(deps_site))$(if $(PYTHONPATH),:$(PYTHONPATH))
livery_figsize := $(shell python3 $(livery_py) figsize $(LIVERY_DIR))
fig_size = $(if $(livery_figsize),-M fig-width:$(word 1,$(livery_figsize)) -M fig-height:$(word 2,$(livery_figsize)))
# DECK_META: a metadata file every render reads (quarto's --metadata-file), filling keys the deck's
# front matter leaves out: gallery.py's placeholder markings, so no image we commit reads as a real
# restricted deck. A prerequisite too, so a different file rebuilds.
meta_file = $(if $(DECK_META),--metadata-file=$(abspath $(DECK_META)))
# DETAILS=show|hide: the deck's `details:` from the command line (docs/authoring.md "Details slides"):
# `make pptx DETAILS=show` is the deck with its {.details} slides shown, no edit of the deck
details_meta = $(if $(DETAILS),-M details:$(DETAILS))
# The engine's sources (the filters, the themes, the pptx steps, the plot helper): the _extensions
# link's target is a directory, whose mtime an edit inside it never moves, so an engine change
# left every deck up to date (#133). The Lua and theme files serve all three formats.
engine_dir   := $(FRAMEWORK_ROOT)_extensions/engine
engine_files := $(wildcard $(engine_dir)/*.lua $(engine_dir)/*.py $(engine_dir)/*.sty $(engine_dir)/*.scss $(engine_dir)/*.js \
                $(engine_dir)/*.html $(engine_dir)/*.theme $(engine_dir)/_extension.yml $(engine_dir)/pptx_steps/*.py \
                $(engine_dir)/mpl/*.py)
# Movies (docs/authoring.md "Movies"): each frames/<name>/ directory of stills makes movies/<name>.mp4
# and its poster (frames2movie.py: even dimensions, yuv420p, H.264, the livery's background behind a
# transparent frame; frames/<name>/movie.yml its fps, crf, width, background and poster-time), and every
# movie brought into movies/ gets its poster beside it too, <name>.poster.png, the
# picture pptx and the PDF show (the engine's filters make a missing one too, wherever the movie is).
# MOVIES lists the frame directories' names (default: every frames/*/); a deck whose frames a script
# draws names them and adds the script as a prerequisite of movies/<name>.mp4 (decks/movies/Makefile).
# A livery switch remakes a frames movie (its background); all of them are prerequisites of every
# deck in the directory, like the fragments. Without ffmpeg on PATH (a host: brew or apt install it)
# Make makes no poster, so a brought movie with a poster of its own builds as the guide says and one
# without is warned by the filters (ensure_poster); a frames movie still needs it (frames2movie.py says so).
frames2movie   := $(FRAMEWORK_ROOT)common/utils/frames2movie.py
MOVIES         ?= $(patsubst frames/%/,%,$(wildcard frames/*/))
movie_made     := $(MOVIES:%=movies/%.mp4)
movie_all      := $(sort $(movie_made) $(wildcard movies/*.mp4 movies/*.m4v movies/*.mov movies/*.webm))
ffmpeg_found   := $(if $(movie_all),$(shell command -v ffmpeg 2>/dev/null))
$(if $(movie_all),$(if $(ffmpeg_found),,$(warning ffmpeg not found: no movie poster is made (docs/authoring.md "Movies"))))
movie_posters  := $(if $(ffmpeg_found),$(addsuffix .poster.png,$(basename $(movie_all))))
define movie_rule
movies/$(1).mp4: $$(wildcard frames/$(1)/*) $$(frames2movie) .livery
	python3 $$(frames2movie) frames frames/$(1) $$@ --poster movies/$(1).poster.png
endef
$(foreach m,$(MOVIES),$(eval $(call movie_rule,$(m))))
movies/%.poster.png: movies/%.mp4 ; python3 $(frames2movie) poster $< $@
movies/%.poster.png: movies/%.m4v ; python3 $(frames2movie) poster $< $@
movies/%.poster.png: movies/%.mov ; python3 $(frames2movie) poster $< $@
movies/%.poster.png: movies/%.webm ; python3 $(frames2movie) poster $< $@
# a poster-time= poster (<name>.poster-<seconds>.png, which the filters make when it is missing) is
# remade with its movie
movie_timed    := $(if $(ffmpeg_found),$(wildcard $(addsuffix .poster-*.png,$(basename $(movie_all)))))
define timed_poster_rule
$(1): $(2) ; python3 $$(frames2movie) poster $(2) $(1) --time $(3)
endef
$(foreach p,$(movie_timed),$(eval $(call timed_poster_rule,$(p),$(filter $(firstword $(subst .poster-, ,$(p))).%,\
  $(movie_all)),$(patsubst %.png,%,$(lastword $(subst .poster-, ,$(p)))))))
# DETAILS on the command line rebuilds the decks when it changes (and when it is dropped again): a
# stamp holding it, phony until it matches, as .livery is. No stamp until DETAILS is first given.
DETAILS ?=
details_stamp :=
ifneq ($(DETAILS)$(wildcard .details),)
details_stamp := .details
ifneq ($(shell cat .details 2>/dev/null),$(DETAILS))
.PHONY: .details
endif
.details:
	@echo $(DETAILS) > $@
endif
prereqs      := $(fragments) $(wildcard _metadata.yml) _quarto.yml _extensions .livery $(details_stamp) $(livery_files) $(engine_files) $(DECK_META) \
             $(requirements) $(deps_site) $(movie_all) $(movie_posters) $(movie_timed)

pptx: $(DECKS:=.pptx)
html: $(DECKS:=.html)
pdf:  $(DECKS:=.pdf)
all:  pptx html pdf

# Layout checks on the built decks: overflow, slide-count parity, short slides, contact
# sheets in _qa/ (deck_qa.py). `make qa DECKS=name` checks one deck of a directory.
qa: all
	python3 $(deck_qa) $(DECKS)

# One slide as a PNG, found by its title, from the built deck (slide_shot.py; docs/authoring.md
# "A picture of one slide"): make shot TITLE="Columns" [FORMAT=html|pdf|pptx|all] [SHOT_OUT=dir]
# [SHOT_WIDTH=px] [DECKS=name]. TITLE="" is the title slide. Only the formats shot are built.
FORMAT      ?= html
SHOT_OUT    ?= _qa/shots
SHOT_WIDTH  ?=
TITLE       ?=
shot: $(foreach f,$(if $(filter all,$(FORMAT)),html pdf pptx,$(FORMAT)),$(DECKS:=.$(f)))
	@test "$(origin TITLE)" = "command line" || { echo 'usage: make shot TITLE="text in the slide title" [FORMAT=html|pdf|pptx|all] [SHOT_OUT=dir] [SHOT_WIDTH=px]' >&2; exit 2; }
	for d in $(DECKS); do python3 $(slide_shot) $$d "$(TITLE)" --format $(FORMAT) --out $(SHOT_OUT) $(if $(SHOT_WIDTH),--width $(SHOT_WIDTH)) || exit 1; done

# The title, divider, closing and feature slides of every format against the livery's
# compositions (comp_measure.py): _qa/measure.tsv and the contact sheet
# _qa/compositions-<livery>.png. MEASURE_FAIL lists the formats whose deltas fail (empty: report).
MEASURE_FAIL ?= html,pdf,pptx
measure: all
	python3 $(comp_measure) --fail-on "$(MEASURE_FAIL)" $(DECKS)

# A pure-LaTeX project of the livery (`livery zip`): the theme, the livery's
# files and a starter, compiling with `latexmk -xelatex talk.tex` alone, or opened on Overleaf.
# release.yml attaches one per livery to a GitHub Release; a consumer repo's own livery too
# (`make overleaf LIVERY_DIR=path/to/livery`).
overleaf:
	python3 $(livery_py) zip $(LIVERY_DIR) -o $(LIVERY)-overleaf.zip

# The livery's plot style for matplotlib outside the decks (`livery zip --charts`): the style,
# the livery_mpl helper, livery.json, the fonts and their licenses, the colors' contact sheet.
# release.yml attaches one per livery beside the Overleaf zips.
charts-zip:
	python3 $(livery_py) zip --charts $(LIVERY_DIR) -o $(LIVERY)-charts.zip

# One static site of the HTML decks, servable as is (`python3 -m http.server -d _site`).
# Every deck's <deck>_files/libs/ is a subset of one union, so the site keeps a single
# libs/ and rewrites the references; images/ and SITE_EXTRA ship verbatim; index.html
# lists the decks by their front matter.
site: html
	rm -rf $(SITE)
	mkdir -p $(SITE)/libs
	for d in $(DECKS); do \
	  rsync -a $${d}_files/libs/ $(SITE)/libs/ && \
	  rsync -a --exclude libs --prune-empty-dirs $${d}_files/ $(SITE)/$${d}_files/ && \
	  sed -e "s#$${d}_files/libs/#libs/#g" $(noindex_sed) $$d.html > $(SITE)/$$d.html || exit 1; \
	done
	find $(SITE) -type d -empty -delete
	test ! -d images || rsync -a images/ $(SITE)/images/
	test ! -d movies || rsync -a movies/ $(SITE)/movies/
	for x in $(SITE_EXTRA); do rsync -a $$x/ $(SITE)/$$x/ || exit 1; done
	python3 $(site_index) --out $(SITE) $(if $(SITE_NOINDEX),--noindex) \
	  $(foreach x,$(SITE_EXTRA),--extra $(x)) $(DECKS)

noindex_sed = $(if $(SITE_NOINDEX),-e 's#<head>#<head><meta name="robots" content="noindex">#')

publish: site
	$(publish_push)

# Auto-symlink the shared _quarto.yml into the deck dir. A deck that
# needs custom config can commit a real _quarto.yml; make will see the
# file exists and skip this rule. Make also runs it for a DANGLING link,
# which it cannot stat: the one a build in the container left (pointing
# into /opt/quarto-livery-decks, invisible on the host), or a host build
# left for the container. So -f re-points such a link, while a real file
# or a link that resolves (to any framework checkout) is never touched.
_quarto.yml:
	ln -sfn $(shared_quarto_yml) $@

# Same for the shared Quarto extensions (the engine: engine-pptx, engine-beamer and
# engine-revealjs, with their filters): each deck dir is its own project root, and quarto
# does not look above it. Every format needs it -- _quarto.yml names all three, and quarto
# resolves all listed formats even when rendering one.
_extensions:
	ln -sfn $(shared_extensions) $@

# The livery link follows LIVERY (or LIVERY_DIR). A missing-only rule like the three above
# would silently keep the old livery after `make LIVERY=cu`, so the link is remade whenever
# the .livery stamp (whose content is the livery's directory, so a LIVERY_DIR switch under
# one name counts too) changes, and the stamp is phony until it matches.
ifneq ($(shell cat .livery 2>/dev/null),$(LIVERY_DIR))
.PHONY: .livery
endif
.livery:
	@test -d $(LIVERY_DIR) || { echo "no livery '$(LIVERY)': $(LIVERY_DIR) is missing" >&2; exit 1; }
	@echo $(LIVERY_DIR) > $@

# Decks depend on the stamp and take the link order-only: make stats a link's target, the
# livery directory, which is older than a fresh stamp, so as a prerequisite the link would
# re-render every deck on every run after a switch. Relinked only when it points elsewhere.
_livery: .livery
	@[ "$$(readlink $@)" = "$(LIVERY_DIR)" ] || ln -sfn $(LIVERY_DIR) $@

# `make deps` installs requirements.txt (nothing to do without one, or when its folder is there:
# deck_deps.py says so). The folder's link is checked, never made, as .livery is: a build reaches
# no network (an HPC compute node has none; `make deps` runs on a login node first), and after
# `make deps pptx` in one run the test -d, not make's view of the directory, decides.
deps:
ifeq ($(requirements),)
	@echo "no requirements.txt beside the Makefile: nothing to install"
else
	python3 $(deck_deps) install $(DECKS_DEPS) $(requirements)
endif
ifneq ($(deps_site),)
$(deps_site):
	@test -d $@ || { echo "requirements.txt's packages are not installed for this Python: $(patsubst %/,%,$(dir $@)) is missing." >&2; \
	  echo "  Run \`make deps\` first (on a node with network; docs/container.md \"From your deck's Makefile\")." >&2; exit 1; }
endif

define render_pptx
	ENGINE_FORMAT=pptx quarto render $< --to engine-pptx -o $@ $(fig_size) $(meta_file) $(details_meta) $(if $(livery_mono),-M "monofont=$(livery_mono)")
	python3 $(pptx_post) $@
endef

# The engine's HTML dependency (livery.css, its fonts and logos) is named for the engine's
# version, not the livery, and quarto keeps a copied file that is newer than its source: after
# a LIVERY switch the deck would wear the old livery's css and marks. So drop it first.
define render_html
	rm -rf $(@:.html=_files)/libs/quarto-contrib/engine-revealjs-*
	ENGINE_FORMAT=html quarto render $< --to engine-revealjs -o $@ $(fig_size) $(meta_file) $(details_meta)
endef

define render_pdf
	ENGINE_FORMAT=pdf quarto render $< --to engine-beamer -o $@ $(meta_file) $(details_meta)
endef

%.pptx: %.qmd $(prereqs) | _livery
	$(render_pptx)

%.html: %.qmd $(prereqs) | _livery
	$(render_html)

%.pdf: %.qmd $(prereqs) | _livery
	$(render_pdf)

# QFILE: a single-deck directory whose source is not named <OUT>.qmd.
ifneq ($(QFILE),$(OUT).qmd)
$(OUT).pptx: $(QFILE) $(prereqs) | _livery
	$(render_pptx)

$(OUT).html: $(QFILE) $(prereqs) | _livery
	$(render_html)

$(OUT).pdf: $(QFILE) $(prereqs) | _livery
	$(render_pdf)
endif

clean:
	rm -f $(foreach d,$(DECKS),$(d).pptx $(d).html $(d).pdf) .livery .details _livery *-overleaf.zip *-charts.zip \
	  $(movie_made) $(addsuffix .poster.png,$(basename $(movie_made)))
	rm -rf $(DECKS:=_files) $(SITE)

distclean:
	git clean --exclude=.env -xdf .

endif
