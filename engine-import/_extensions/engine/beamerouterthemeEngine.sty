\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerouterthemeEngine}[2026/09/30 v2.3 engine beamer outer theme]
%
% Page furniture, following the brand's slide template (Brand Guide p26):
%   content frames: accent tab at the left edge beside a bold title, hairline
%   rule, the mark top-right (geometry.logo.corner: top-right | top-left | none),
%   page number bottom-left (geometry.pagenumber.corner), and the livery's
%   sign-off lockup at the foot when it has one (signoff.*).
%
% Every page is drawn by the `background' template according to a page
% style: normal | title | section | closing | feature.
%   * frame keys (enginebg=, engineclosing) set \engine@framestyle locally, so the
%     style holds for every overlay of that frame;
%   * the title/section page templates set \engine@bodystyle globally from
%     inside the frame body; it is reset after each shipout.
%
\mode<presentation>
\@ifpackageloaded{engine_livery}{}{\RequirePackage{engine_livery}}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\providecommand\engine@footer{minimal}
\providecommand\engine@titlestyle{dark}
\@ifundefined{ifengine@framelogo}{\newif\ifengine@framelogo\engine@framelogotrue}{}
\@ifundefined{ifengine@waves}{\newif\ifengine@waves\engine@wavestrue}{}

\def\engine@framestyle{normal}
\def\engine@bodystyle{}
\AddToHook{shipout/after}{\gdef\engine@bodystyle{}}
\def\engine@style{\ifx\engine@bodystyle\@empty\engine@framestyle\else\engine@bodystyle\fi}
% \engine@ifstyle{<style>}{<true>}{<false>}
\def\engine@ifstyle#1{%
  \edef\engine@tmpa{\engine@style}\def\engine@tmpb{#1}%
  \ifx\engine@tmpa\engine@tmpb\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\def\engine@ifplainstyle#1#2{% true for everything except normal frames
  \engine@ifstyle{normal}{#2}{#1}}

% ---------------------------------------------------------------------------
% geometry (relative to the paper, so 16:9, 16:10 and 4:3 all work)
% ---------------------------------------------------------------------------
% (the fractions are the livery's: engine@geom@* in its build/livery.sty)
\newdimen\engine@margin      \engine@margin=\engine@geom@margin\paperwidth
\newdimen\engine@tabwidth    \engine@tabwidth=\engine@geom@tab\paperwidth
\newdimen\engine@logoheight  \engine@logoheight=\engine@geom@logoheight\paperheight
\newdimen\engine@logotop     \engine@logotop=\engine@geom@logotop\paperheight
% the content mark's distance from its edge: geometry.logo.inset, else the margin
\newdimen\engine@logoinset
\AtBeginDocument{\ifdefined\engine@geom@logoinset\engine@logoinset=\engine@geom@logoinset\paperwidth
  \else\engine@logoinset=\engine@margin\fi}
\providecommand\engine@geom@logocorner{top-right}
\providecommand\engine@geom@pagenumbercorner{bottom-left}
% \engine@ifcorner{<macro>}{<value>}{<true>}{<false>}
\def\engine@ifcorner#1#2{\edef\engine@tmpa{#1}\def\engine@tmpb{#2}%
  \ifx\engine@tmpa\engine@tmpb\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\setbeamersize{text margin left=\engine@margin,text margin right=\engine@margin}

% brand lockup shown at the top right of content frames
\def\engine@framelogo{\enginelogo[height=\engine@logoheight]{light}}
% a user \logo{...} (or Quarto's `logo:') is beamer's secondary logo: set in
% the footline, bottom right, at its natural size (as in beamer's default
% themes and the v1 theme), so beamer reserves room for it and content stops
% above it -- scaled down only if unreasonably tall
\newsavebox\engine@userlogo
\def\engine@userlogorow{%
  \ifbeamertemplateempty{logo}{}{%
    \sbox\engine@userlogo{\insertlogo}%
    \ifdim\ht\engine@userlogo>0.35\paperheight
      \sbox\engine@userlogo{\resizebox{!}{0.15\paperheight}{\usebox\engine@userlogo}}%
    \fi
    \hbox to\paperwidth{\hfil\usebox\engine@userlogo
      \ifdim\wd\engine@userlogo<0.8\paperwidth\hskip\engine@margin\fi}%
    \vskip0.01\paperheight}}
\newdimen\engine@logowidth
\AtBeginDocument{%
  \settowidth\engine@logowidth{\engine@framelogo}%
  \ifengine@framelogo\else\engine@logowidth=0pt\fi
  \engine@ifcorner{\engine@geom@logocorner}{none}{\engine@logowidth=0pt}{}}
% the sign-off lockup (signoff in livery.yml), at the foot, when the livery has one
\def\engine@signoff#1{%
  \ifcsname engine@signoff@#1\endcsname
    \engine@ifcorner{\engine@signoffcorner}{bottom-right}{%
      \node[anchor=south east,inner sep=0pt] at (\paperwidth-\engine@margin,\engine@signoffbottom\paperheight)
        {\includegraphics[height=\engine@signoffheight\paperheight]{\csname engine@signoff@#1\endcsname}};
    }{%
      \node[anchor=south west,inner sep=0pt] at (\engine@margin,\engine@signoffbottom\paperheight)
        {\includegraphics[height=\engine@signoffheight\paperheight]{\csname engine@signoff@#1\endcsname}};
    }%
  \fi}

% ---------------------------------------------------------------------------
% frame title
% ---------------------------------------------------------------------------
\defbeamertemplate*{frametitle}{Engine}{%
  \engine@ifstyle{feature}{\engine@featurespace}{\engine@frametitle}}
% a feature frame's title is drawn by the background (\engine@ctext@feature); a body not on the
% panel (enginefeaturepanel) starts below where the panel would
\def\engine@featurespace{\def\engine@comp{feature}\nointerlineskip
  \vbox to \engine@ifc{panel@y}{\engine@cv{panel@y}}{0.5}\paperheight{\vfil}}
\def\engine@frametitle{%
  \nointerlineskip
  \@tempdima=\paperwidth
  \advance\@tempdima by -2\engine@margin
  \ifdim\engine@logowidth>0pt
    \engine@ifstyle{normal}{\advance\@tempdima by -\engine@logowidth
      \advance\@tempdima by -0.03\paperwidth
      \advance\@tempdima by \dimexpr\engine@margin-\engine@logoinset\relax}{}%
  \fi
  \setbox\@tempboxa=\vbox{%
    \hsize=\@tempdima
    \def\engine@tmp{center}\ifx\engine@ft@align\engine@tmp\centering\else\raggedright\fi
    \usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}%
    \strut\insertframetitle\strut\par
    \ifx\insertframesubtitle\@empty\else
      \vskip-0.25ex{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
        \strut\insertframesubtitle\strut\par}%
    \fi}%
  % HTML's and the pptx template's band: the title centred in 44-114 px of 900 (a taller one
  % grows down), the hairline at 130 px or 16 px under the title, the body from 150 px
  \@tempdimb=\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax
  \@tempdimc=\dimexpr0.0778\paperheight-\@tempdimb\relax
  \ifdim\@tempdimc<0pt \@tempdimc=0pt \fi
  \vbox{%
    \vskip\dimexpr0.0489\paperheight+0.5\@tempdimc\relax
    \hbox{%
      \hskip-\beamer@leftmargin % frametitle is typeset at the text margin
      \engine@ifstyle{normal}{%
        \ifdefined\engine@ft@notab\hskip\engine@tabwidth\else
        {\usebeamercolor[fg]{frametitle tab}%
         \vrule width\engine@tabwidth height\ht\@tempboxa depth\dp\@tempboxa}\fi
        \hskip\dimexpr\engine@margin-\engine@tabwidth\relax
        % a top-left mark: the title starts beside it
        \engine@ifcorner{\engine@geom@logocorner}{top-left}{%
          \ifdim\engine@logowidth>0pt\hskip\dimexpr\engine@logowidth+0.03\paperwidth+\engine@logoinset-\engine@margin\relax\fi}{}%
      }{\hskip\engine@margin}%
      \box\@tempboxa}%
    \@tempdima=\dimexpr0.1444\paperheight-0.0489\paperheight-\@tempdimb-\@tempdimc\relax
    \ifdim\@tempdima<0.0178\paperheight \@tempdima=0.0178\paperheight \fi
    \vskip\dimexpr0.5\@tempdimc+\@tempdima\relax\nointerlineskip   % exact positions: no baselineskip glue
    \engine@ifstyle{normal}{%
      \ifdefined\engine@ft@norule\else
      \hbox{{\usebeamercolor[fg]{frametitle rule}%
        \vrule width\dimexpr\paperwidth-2\engine@margin\relax height0.4pt}}\fi
    }{}%
    \ifdefined\engine@ft@bodytop   % below a taller mark (livery.sty)
      \vskip\dimexpr\engine@ft@bodytop\paperheight-0.1444\paperheight-0.4pt\relax
    \else\vskip\dimexpr0.0222\paperheight-0.4pt\relax\fi}%
}

% ---------------------------------------------------------------------------
% headline (empty -- the logo is drawn on the background) & footline
% ---------------------------------------------------------------------------
\setbeamertemplate{headline}{}
% beamer's default `sidebar right' also typesets \insertlogo (and the
% navigation symbols); the logo lives in our footline instead
\setbeamertemplate{sidebar right}{}
\defbeamertemplate*{footline}{Engine}{%
  \engine@ifstyle{normal}{\engine@footline}{%
    \engine@ifstyle{full}{\engine@footline}{%
    \engine@ifstyle{feature}{{\color{white}\engine@footline}}{%
      \vbox to 0.075\paperheight{\vfil}}}}}
\def\engine@footline{%
  \engine@userlogorow
  \vbox to 0.075\paperheight{%
    \vfil
    \hbox to\paperwidth{%
      \hskip\engine@margin
      \engine@ifcorner{\engine@geom@pagenumbercorner}{bottom-right}{}{%
        {\usebeamerfont{page number in head/foot}\insertframenumber}}%
      \def\engine@tmp{full}\ifx\engine@footer\engine@tmp
        \hfil
        {\usebeamerfont{footline}\usebeamercolor[fg]{footline}%
          \ifx\insertsectionhead\@empty\else
            \insertsectionhead\enspace\textbar\enspace\fi
          \insertshorttitle\ifx\insertshortdate\@empty\else
          \enspace\textbar\enspace\insertshortdate\fi}%
      \else\hfil\fi
      \engine@ifcorner{\engine@geom@pagenumbercorner}{bottom-right}{%
        {\usebeamerfont{page number in head/foot}\insertframenumber}}{}%
      \hskip\engine@margin}%
    \vskip0.035\paperheight}}

% ---------------------------------------------------------------------------
% backgrounds
% ---------------------------------------------------------------------------
% The livery's wave lines (art.waves in its livery.yml, three lines of two cubics each,
% from the top edge to the bottom): \engine@wave@<n>@down{<dx>} and @up come from its
% build/livery.sty, with \engine@waveshift@<kind>. A livery without them draws none.
\newif\ifengine@haswaves
\ifdefined\engine@wave@i@down\engine@haswavestrue\fi
% \engine@wdown{<n>}{<dx>} / \engine@wup{<n>}{<dx>}: line n (1-3), shifted right by dx
\def\engine@wdown#1#2{\csname engine@wave@\romannumeral#1 @down\endcsname{#2}}
\def\engine@wup#1#2{\csname engine@wave@\romannumeral#1 @up\endcsname{#2}}
% \engine@band{<n>}{<m>}{<dx>}{<fill>}{<opacity>}: fill between lines n and m
\def\engine@band#1#2#3#4#5{%
  \ifengine@haswaves\fill[#4,opacity=#5] \engine@wdown{#1}{#3} -- \engine@wup{#2}{#3} -- cycle;\fi}
% \engine@lines{<dx>}{<color>}: the three lines, \engine@linewidth wide (a composition's own;
% content slides keep theirs)
\def\engine@linewidth{0.8pt}
\def\engine@lines#1#2{%
  \ifengine@haswaves
    \draw[#2,line width=\engine@linewidth] \engine@wdown{1}{#1};
    \draw[#2,line width=\engine@linewidth] \engine@wdown{2}{#1};
    \draw[#2,line width=\engine@linewidth] \engine@wdown{3}{#1};
  \fi}

\newsavebox\engine@imgbox
% \engine@coverbox{<width>}{<height>}{<image-or-box>}: scale to cover
\newcommand\engine@coverbox[3]{%
  \sbox\engine@imgbox{#3}%
  \@tempdima=\dimexpr#2*\wd\engine@imgbox/\ht\engine@imgbox\relax
  \ifdim\@tempdima<#1\relax
    \resizebox{#1}{!}{\usebox\engine@imgbox}%
  \else
    \resizebox{!}{#2}{\usebox\engine@imgbox}%
  \fi}

% the title's style (title.style in livery.yml): the cover (default) or the band
\providecommand\engine@title@style{cover}
\def\engine@ifband{\engine@ifcorner{\engine@title@style}{band}}
% a deck without \titlegraphic gets the livery's default photo (art.titlegraphic)
\AtBeginDocument{\ifx\inserttitlegraphic\@empty\ifcsname engine@art@titlegraphic\endcsname
  \titlegraphic{\includegraphics{\engine@art@titlegraphic}}\fi\fi}
% the compositions the title and closing slides wear (the band wins over title=light)
\def\engine@tmp{light}\ifx\engine@titlestyle\engine@tmp
  \engine@ifband{\PackageWarning{beamerthemeEngine}{title=light is ignored under the livery's band title}
    \def\engine@titlestyle{dark}}{}\fi
\def\engine@tmp{light}\ifx\engine@titlestyle\engine@tmp\def\engine@lightsuffix{light}\else\def\engine@lightsuffix{}\fi
\engine@ifband{\def\engine@closingcomp{closingband}}{\edef\engine@closingcomp{closing\engine@lightsuffix}}
\AtBeginDocument{\engine@ifband{\def\engine@titlecomp{titleband}}{%
  \ifx\inserttitlegraphic\@empty\edef\engine@titlecomp{title\engine@lightsuffix}%
  \else\edef\engine@titlecomp{titlephoto\engine@lightsuffix}\fi}}

% ---------------------------------------------------------------------------
% compositions: the title, closing, section and feature slides as the livery's boxes
% (build/livery.sty: \engine@c@<comp>@<key>@x|y|w|h, fractions of the slide, y down; the
% EngineC<comp><Key> colors; scalars and image stems), drawn by one drawer
% ---------------------------------------------------------------------------
\def\engine@cv#1{\csname engine@c@\engine@comp @#1\endcsname}
% \engine@ifc{<key>}{<yes>}{<no>}: whether the composition has the key
\def\engine@ifc#1{\ifcsname engine@c@\engine@comp @#1\endcsname
  \expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\def\engine@ccolor#1{EngineC\engine@comp#1}
\newdimen\engine@bx \newdimen\engine@by \newdimen\engine@bw \newdimen\engine@bh
% \engine@box{<key>}: its box in TikZ terms, (bx, by) the lower left corner (y up)
\def\engine@box#1{%
  \engine@bw=\engine@cv{#1@w}\paperwidth \engine@bh=\engine@cv{#1@h}\paperheight
  \engine@bx=\engine@cv{#1@x}\paperwidth
  \engine@by=\dimexpr\paperheight-\engine@cv{#1@y}\paperheight-\engine@bh\relax}
\def\engine@rect#1{\fill[#1] (\engine@bx,\engine@by) rectangle ++(\engine@bw,\engine@bh);}
% \engine@drawcomp{<comp>}{<kind>}: the composition, then its text by kind (title | section |
% closing | feature); a cover's photo goes under its field, a band's on the band
\def\engine@drawcomp#1#2{\def\engine@comp{#1}%
  \engine@ifc{band@x}{}{\engine@cphoto}%
  \engine@cfield
  \engine@ifc{art}{\node[anchor=south west,inner sep=0pt] at (0,0)
    {\includegraphics[width=\paperwidth,height=\paperheight]{\engine@cv{art}}};}{}%
  \engine@ifc{band@x}{\engine@box{band}\engine@rect{\engine@ccolor{Band}}\engine@cphoto}{}%
  \engine@cwaves
  \engine@cbar
  \engine@cimage{mark}\engine@cimage{signoff}%
  \csname engine@ctext@#2\endcsname}
% the field: a rect of its box, or, under cover waves, the page left of line 2
\def\engine@cfield{\engine@ifc{field@x}{%
  \engine@ifc{waves@style}{\engine@ifcorner{\engine@cv{waves@style}}{cover}{\engine@coverfield}{\engine@rectfield}}%
    {\engine@rectfield}}{}}
\def\engine@rectfield{\engine@box{field}\engine@rect{\engine@ccolor{Field}}}
\def\engine@coverfield{\fill[\engine@ccolor{Field}] (0,0) -- (0,\paperheight) -- \engine@wdown{2}{\engine@cv{waves@shift}} -- cycle;}
% the photo, scaled to cover its box and clipped to it: the title's \titlegraphic, or the feature's
\def\engine@cphoto{\engine@ifc{photo@x}{%
  \engine@ifcorner{\engine@comp}{feature}{\def\engine@cimg{\includegraphics{\engine@featureimage}}}%
    {\let\engine@cimg\inserttitlegraphic}%
  \ifx\engine@cimg\@empty\else
    \engine@box{photo}%
    \begin{scope}
      \clip (\engine@bx,\engine@by) rectangle ++(\engine@bw,\engine@bh);
      \node[anchor=center,inner sep=0pt] at (\engine@bx+0.5\engine@bw,\engine@by+0.5\engine@bh)
        {\engine@coverbox{\engine@bw}{\engine@bh}{\engine@cimg}};
    \end{scope}
  \fi}{}}
% the waves by style: bands (translucent between the lines, Brand Guide p24), lines, or cover
% (the field's translucent band between lines 2 and 3)
\def\engine@cwaves{\engine@ifc{waves@style}{%
  \edef\engine@ws{\engine@cv{waves@shift}}%
  \edef\engine@linewidth{\engine@cv{waves@line}\paperwidth}%
  \engine@ifcorner{\engine@cv{waves@style}}{bands}{%
    \engine@band{1}{2}{\engine@ws}{\engine@ccolor{Waves}}{\engine@cv{waves@opacity@i}}%
    \engine@band{2}{3}{\engine@ws}{\engine@ccolor{Waves}}{\engine@cv{waves@opacity@ii}}}{}%
  \engine@ifcorner{\engine@cv{waves@style}}{cover}{%
    \engine@band{2}{3}{\engine@ws}{\engine@ccolor{Field}}{\engine@cv{waves@opacity@i}}}{}%
  \engine@lines{\engine@ws}{\engine@ccolor{Waves}}}{}}
% the feature's bar, behind a frame title
\def\engine@cbar{\engine@ifc{bar@x}{\ifx\beamer@frametitle\@empty\else
  \engine@box{bar}\fill[\engine@ccolor{Bar},opacity=\engine@cv{bar@opacity}]
    (\engine@bx,\engine@by) rectangle ++(\engine@bw,\engine@bh);\fi}{}}
% \engine@cimage{mark|signoff}: the image at its box's top left, its box's height
\def\engine@cimage#1{\engine@ifc{#1@img}{\engine@box{#1}%
  \node[anchor=north west,inner sep=0pt] at (\engine@bx,\engine@by+\engine@bh)
    {\includegraphics[height=\engine@bh]{\engine@cv{#1@img}}};}{}}
% \engine@cnode{<stack>}: the text column, its stack (a \vbox \engine@bw wide; no text width, which
% would set it as a paragraph) from the top or centred by the column's anchor
\def\engine@cnode#1{\engine@box{column}%
  \engine@ifcorner{\engine@cv{column@anchor}}{middle}%
    {\node[anchor=west,inner sep=0pt,text=\engine@ccolor{Text}]
       at (\engine@bx,\engine@by+0.5\engine@bh) {#1};}%
    {\node[anchor=north west,inner sep=0pt,text=\engine@ccolor{Text}]
       at (\engine@bx,\engine@by+\engine@bh) {#1};}}
% the stacks (beamerinnerthemeEngine.sty): the title's with its fineprint, the section's, the closing's
\def\engine@ctext@title{\engine@cnode{\engine@titlestack}\engine@cfineprint}
\def\engine@ctext@section{\engine@cnode{\engine@sectionstack}}
\def\engine@ctext@closing{\engine@cnode{\engine@closingstack}}
% the feature: the frame title in the column (centred on the bar, or the cover's stack) and the
% body (enginefeaturepanel, beamerinnerthemeEngine.sty) on the panel or under the title
\def\engine@ctext@feature{%
  \ifx\beamer@frametitle\@empty\else
    \engine@ifc{bar@x}{\engine@cnode{\engine@featuretitle}}{\engine@cnode{\engine@featurestack}}%
  \fi
  \ifengine@haspanel\engine@ifc{panel@x}{\engine@box{panel}%
    \@tempdima=\dimexpr\engine@by+\engine@bh\relax
    \fill[\engine@ccolor{Panel},opacity=\engine@cv{panel@opacity}] (\engine@bx,\@tempdima) rectangle
      ++(\engine@bw,-\dimexpr\ht\engine@panelbox+\dp\engine@panelbox+2\engine@panelpad\relax);
    \node[anchor=north west,inner sep=0pt] at (\engine@bx+1.5\engine@panelpad,\@tempdima-\engine@panelpad)
      {\copy\engine@panelbox};}{}\fi}
\def\engine@cfineprint{\ifx\engine@fineprint\@empty\else\engine@ifc{fineprint@x}{\engine@box{fineprint}%
  \engine@ifcorner{\engine@cv{fineprint@anchor}}{bottom}%
    {\def\engine@tmpc{south west}\@tempdima=\engine@by}%
    {\def\engine@tmpc{north west}\@tempdima=\dimexpr\engine@by+\engine@bh\relax}%
  \node[anchor=\engine@tmpc,inner sep=0pt,text width=\engine@bw,font=\usebeamerfont{title fineprint},
    text=\engine@ccolor{Fineprint},align=left] at (\engine@bx,\@tempdima) {\engine@fineprint};}{}\fi}

% \engine@art{<kind>}: the livery's static background for a slide kind, if it names one
\def\engine@art#1{%
  \ifcsname engine@art@#1\endcsname
    \node[anchor=south west,inner sep=0pt] at (0,0)
      {\includegraphics[width=\paperwidth,height=\paperheight]{\csname engine@art@#1\endcsname}};
  \fi}

\defbeamertemplate*{background}{Engine}{%
  \begin{tikzpicture}[x=1pt,y=1pt]
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \engine@ifstyle{normal}{%
      \engine@art{content}%
      \ifengine@waves\engine@lines{\engine@waveshift@content}{BrandSurface}\fi
      \ifengine@framelogo
        \engine@ifcorner{\engine@geom@logocorner}{top-left}{%
          \node[anchor=north west,inner sep=0pt]
            at (\engine@logoinset,\paperheight-\engine@logotop) {\engine@framelogo};
        }{\engine@ifcorner{\engine@geom@logocorner}{none}{}{%
          \node[anchor=north east,inner sep=0pt]
            at (\paperwidth-\engine@logoinset,\paperheight-\engine@logotop) {\engine@framelogo};
        }}%
      \fi
      \engine@signoff{light}%
    }{}%
    \engine@ifstyle{title}{\engine@drawcomp{\engine@titlecomp}{title}}{}%
    \engine@ifstyle{closing}{\engine@drawcomp{\engine@closingcomp}{closing}}{}%
    \engine@ifstyle{section}{\engine@drawcomp{section}{section}}{}%
    \engine@ifstyle{feature}{\engine@drawcomp{feature}{feature}}{}%
    \engine@ifstyle{full}{\engine@drawfullbg}{}%
  \end{tikzpicture}}

% full frame: the image contained (never cropped) between a thin margin and
% the footline, with the caption line, if any, just above the footline
\newdimen\engine@fullpad    \engine@fullpad=\engine@geom@fullpad\paperwidth
\newdimen\engine@fullfloor
\def\engine@drawfullbg{%
  \engine@fullfloor=\engine@geom@fullfloor\paperheight
  \ifx\engine@fullcaption\@empty\else
    \node[anchor=south,inner sep=0pt,text width=0.8\paperwidth,align=center,
      font=\engine@fs{caption},text=BrandMuted] at (0.5\paperwidth,\engine@fullfloor) {\engine@fullcaption};
    \advance\engine@fullfloor \engine@geom@fullcaption\paperheight
  \fi
  \node[anchor=center,inner sep=0pt]
    at (0.5\paperwidth,{0.5*(\paperheight-\engine@fullpad+\engine@fullfloor)})
    {\includegraphics[width=\dimexpr\paperwidth-2\engine@fullpad\relax,
      height=\dimexpr\paperheight-\engine@fullpad-\engine@fullfloor\relax,
      keepaspectratio]{\engine@fullimage}};}

% ---------------------------------------------------------------------------
% frame keys
% ---------------------------------------------------------------------------
% Frame keys are processed *outside* any group, so everything they change
% must be reset at the start of the next frame.  Beamer applies the
% `environment' key to every frame before the user's keys, which makes it the
% reset point.  Key handlers run inside \setkeys{beamerframe}, where
% \setbeamercolor would clobber keyval's state, so color changes are deferred
% to \engine@framehook; that runs from \beamer@calculateheadfoot, which beamer
% calls right after the keys (\beamer@frametemplate is unusable: `plain'
% replaces it).  Colors touched by the hook are snapshotted at
% \begin{document} and restored on reset.
\def\engine@framehook{}
\def\engine@atframe#1{%
  \expandafter\def\expandafter\engine@framehook\expandafter{\engine@framehook#1}}
\let\engine@calculateheadfoot\beamer@calculateheadfoot
\def\beamer@calculateheadfoot{\engine@framehook\engine@calculateheadfoot}

\def\engine@touchedcolors{normal text,title,subtitle,author,institute,date,%
frametitle,framesubtitle,structure,item,subitem,subsubitem,local structure,%
enumerate item,alerted text,block title,block body,block title example,%
block body example,block title alerted,block body alerted}
\def\engine@colorslots{thcfg,thcbg,thcinherits,thcuse}
\def\engine@copycolors#1#2{% #1 -> #2 prefixes, for every touched color & slot
  \@for\engine@c:=\engine@touchedcolors\do{%
    \@for\engine@s:=\engine@colorslots\do{%
      \expandafter\let\csname #2\engine@s @\engine@c\expandafter\endcsname
        \csname #1\engine@s @\engine@c\endcsname}}}
\AtBeginDocument{\engine@copycolors{beamer@}{engine@saved@}}
\def\engine@resetframe{%
  \def\engine@framestyle{normal}\global\engine@haspanelfalse
  % the text color too: a field's hook (\engine@fieldcolors) sets it where the frame's group
  % does not undo it, so the frame after a closing slide had white body text
  \def\engine@framehook{\usebeamercolor[fg]{normal text}}%
  \engine@copycolors{engine@saved@}{beamer@}}
\let\engine@envkey\KV@beamerframe@environment
\def\KV@beamerframe@environment#1{\engine@resetframe\engine@envkey{#1}}

% [enginebg=<image>]: full-bleed photo; no logo (never on busy photos)
\define@key{beamerframe}{enginebg}{%
  \def\engine@framestyle{feature}\def\engine@featureimage{#1}%
  \engine@atframe{%
    \setbeamercolor{frametitle}{fg=white}%
    \setbeamercolor{framesubtitle}{fg=BrandSecondary}%
    \engine@featureblocks}}
% [enginefull=<image>]: the image fills the frame; no title, logo, rule or
% waves, the frame number kept.  \enginefullcaption{...} in the body (global:
% the background is drawn after the body) adds a caption line.
\define@key{beamerframe}{enginefull}{%
  \def\engine@framestyle{full}\def\engine@fullimage{#1}\gdef\engine@fullcaption{}}
\def\engine@fullcaption{}
\newcommand\enginefullcaption[1]{\gdef\engine@fullcaption{#1}}
% [engineclosing]: brand field, like the title slide
\define@key{beamerframe}{engineclosing}[true]{%
  \def\engine@framestyle{closing}%
  \engine@atframe{\engine@fieldcolors{EngineC\engine@closingcomp Text}}}

% \engine@fieldcolors{<color>}: every text color for a field in <color>
\def\engine@fieldcolors#1{%
    \setbeamercolor{normal text}{fg=#1}%
    \usebeamercolor[fg]{normal text}%
    \setbeamercolor{title}{fg=#1}%
    \setbeamercolor{subtitle}{fg=#1}%
    \setbeamercolor{author}{fg=#1}%
    \setbeamercolor{institute}{fg=#1}%
    \setbeamercolor{date}{fg=#1}%
    \setbeamercolor{frametitle}{fg=#1}%
    \setbeamercolor{structure}{fg=#1}%
    \setbeamercolor{item}{fg=#1}%
    \setbeamercolor{subitem}{fg=#1}%
    \setbeamercolor{local structure}{fg=#1}%
    \setbeamercolor{alerted text}{fg=BrandAccent}}

\mode<all>
