\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeEngine}[2026/09/30 v2.3 engine beamer theme]
%
% \usetheme[<options>]{Engine}
%
%   brand=ncar|ucar|ncarucar   palette + logo lockup                  (ncar)
%   title=dark|light           title/closing slide field:
%                              brand color w/ white-reversed logo, or
%                              white w/ full-color logo               (dark)
%   fonts=poppins|helvetica    (poppins under XeLaTeX/LuaLaTeX)
%   mathfont=serif|lm|stix|pagella|sans|poppins|keep|<font>
%                              math font (serif; see engine_livery.sty)
%   footer=minimal|full        page number only, or + section/short title/date
%   sectionpages=true|false    automatic divider frame per \section   (true)
%   logo=true|false            logo in the top-right of content frames (true)
%   waves=true|false           faint brand waves behind content frames  (true)
%
% Frame extensions (see README):
%   \begin{frame}[enginebg=<image>]   full-bleed photo "feature" frame
%   \begin{frame}[engineclosing]      closing / thank-you frame
%   \engineclosingframe{Thank you}{contact text}
%
\mode<presentation>

\def\engine@opt@brand{ncar}
\def\engine@titlestyle{dark}
\def\engine@opt@fonts{auto}
\def\engine@opt@mathfont{serif}
\def\engine@footer{minimal}
\newif\ifengine@sectionpages \engine@sectionpagestrue
\newif\ifengine@framelogo    \engine@framelogotrue
\newif\ifengine@waves        \engine@wavestrue

\DeclareOptionBeamer{brand}{\def\engine@opt@brand{#1}}
\DeclareOptionBeamer{title}{\def\engine@titlestyle{#1}}
\DeclareOptionBeamer{fonts}{\def\engine@opt@fonts{#1}}
\DeclareOptionBeamer{mathfont}{\def\engine@opt@mathfont{#1}}
\DeclareOptionBeamer{footer}{\def\engine@footer{#1}}
\DeclareOptionBeamer{sectionpages}[true]{\csname engine@sectionpages#1\endcsname}
\DeclareOptionBeamer{logo}[true]{\csname engine@framelogo#1\endcsname}
\DeclareOptionBeamer{waves}[true]{\csname engine@waves#1\endcsname}
\ProcessOptionsBeamer

\mode<all>
\@ifpackageloaded{engine_livery}{}{%
  \edef\engine@tmp{\noexpand\RequirePackage[brand=\engine@opt@brand,fonts=\engine@opt@fonts,mathfont=\engine@opt@mathfont]{engine_livery}}%
  \engine@tmp}
\mode<presentation>

\usecolortheme{Engine}
\usefonttheme{Engine}
% pdfLaTeX: serif math from Computer Modern (the branding package settles
% mathfont= for XeLaTeX/LuaLaTeX with unicode-math)
\@ifundefined{ifengine@cmmath}{}{\ifengine@cmmath\usefonttheme[onlymath]{serif}\fi}
\useinnertheme{Engine}
\useoutertheme{Engine}

\setbeamertemplate{navigation symbols}{}

% ---------------------------------------------------------------------------
% v1 (2020-brand theme) compatibility, so existing decks build after changing
% \usetheme{ncar} to \usetheme{Engine}
% ---------------------------------------------------------------------------
\RequirePackage{environ}
% \begin{NCARprettyframe}[<image>] ... : photo feature frame; without an image,
% a brand-field frame
\NewEnviron{NCARprettyframe}[1][]{%
  \def\engine@tmp{#1}%
  \ifx\engine@tmp\@empty
    \begin{frame}[engineclosing]\BODY\end{frame}%
  \else
    \begin{frame}[enginebg={#1}]\BODY\end{frame}%
  \fi}
% \begin{NCARtitleframe}[<image>] ... : the title page.  The body (v1 decks put
% spacing and \maketitle there) is ignored; the new title page lays itself out.
\NewEnviron{NCARtitleframe}[1][]{%
  \def\engine@tmp{#1}%
  \ifx\engine@tmp\@empty\else\titlegraphic{\includegraphics{#1}}\fi
  \begin{frame}[plain,noframenumbering]\titlepage\end{frame}}
\providecommand\titlebackground{}
\providecommand\nobackground{}
\providecommand\defaultbackground{}

\mode<all>
