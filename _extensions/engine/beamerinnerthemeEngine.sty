\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerinnerthemeEngine}[2026/09/30 v2.3 engine beamer inner theme]
%
% Title page, section divider, closing frame, blocks and lists.
% Title page layout follows the brand's slide template (Brand Guide p26):
% logo lockup, date, bold title with an accent bar at the left edge,
% subtitle, short rule, presenter, affiliation, fine print; photo (from
% \titlegraphic) masked by the brand waves on the right.
%
\mode<presentation>
\@ifpackageloaded{engine_livery}{}{\RequirePackage{engine_livery}}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
% beamer's [shrink] ({.shrink}) sets the frame body in a pgf \pgftext, which under XeLaTeX
% (pgfsys-dvipdfmx.def) resets the color to black: put the body's color back, or a dark livery's
% shrunk slide is black on black (and a light one's text black, not the brand's)
\patchcmd\beamer@shrinkframebox
  {\pgftext[left,top]{\box\beamer@framebox}}
  {\pgftext[left,top]{\usebeamercolor[fg]{normal text}\box\beamer@framebox}}
  {}{\PackageWarning{beamerinnerthemeEngine}{could not patch \string\beamer@shrinkframebox}}
\providecommand\engine@titlestyle{dark}
\@ifundefined{ifengine@sectionpages}{\newif\ifengine@sectionpages\engine@sectionpagestrue}{}

% optional fine print under the title block, e.g. an NSF funding statement
\def\engine@fineprint{}
\newcommand\titlefineprint[1]{\def\engine@fineprint{#1}}

% vertical accent bar spanning box #1, flush with the paper's left edge
\def\engine@accentbar#1{%
  \hbox{\hskip-\beamer@leftmargin
    {\usebeamercolor[fg]{frametitle tab}%
     \vrule width\engine@tabwidth height\ht#1 depth\dp#1}%
    \hskip\dimexpr\beamer@leftmargin-\engine@tabwidth\relax
    \box#1}}
% the composition column's text alignment (column.align: left | center; \engine@calignof{<comp>}
% where \engine@comp is not set, as in the closing's body)
\def\engine@calignof#1{\engine@ifcorner{\csname engine@c@#1@column@align\endcsname}{center}{\centering}{\raggedright}}
\providecommand\engine@comp{}   % set by \engine@drawcomp; empty: left
\def\engine@calign{\engine@calignof\engine@comp}
% \engine@ctab{<box>}: the same beside a composition's column (\engine@bx from the paper's
% edge), when the column has a tab
\def\engine@ctab#1{\engine@ifcorner{\engine@cv{column@tab}}{true}{%
  \hbox{\hskip-\engine@bx
    {\usebeamercolor[fg]{frametitle tab}\vrule width\engine@tabwidth height\ht#1 depth\dp#1}%
    \hskip\dimexpr\engine@bx-\engine@tabwidth\relax
    \box#1}}{\box#1}}

% ---------------------------------------------------------------------------
% title page
% ---------------------------------------------------------------------------
% the text sits in the composition's column, drawn by the background (beamerouterthemeEngine.sty
% \engine@drawcomp); the frame body only fills the page
\defbeamertemplate*{title page}{Engine}{%
  \gdef\engine@bodystyle{title}%
  \vbox to \dimexpr\textheight-2pt\relax{\vfil}}
% a cover's text parts (livery.json compositions: column.elements, byline): \engine@textstack{<part>}
% walks the part's elements in order, \engine@bw wide. The title carries the tab and the rule, and the
% subtitle with it when the part holds both; a byline's elements are its own stack in its box, or,
% without one (byline@inline), stay in the column's flow in the byline's color. The default order
% (date, title, subtitle, author, institute) sets exactly what the single stack set before.
\def\engine@has#1#2{\edef\engine@tmpl{\noexpand\in@{,#1,}{,#2,}}\engine@tmpl}
\def\engine@palign#1{\engine@ifcorner{\csname engine@c@\engine@comp @#1@align\endcsname}{center}{\centering}{\raggedright}}
\def\engine@elcolor#1{\def\engine@tmpp{column}\ifx\engine@part\engine@tmpp
  \engine@ifc{byline@inline}{\engine@has{#1}{\engine@cv{byline@inline}}\ifin@\color{\engine@ccolor{Byline}}\fi}{}\fi}
\def\engine@flush{\engine@pending\let\engine@pending\@empty}
\def\engine@el@date{\ifx\insertdate\@empty\else
  \ifx\engine@started\@empty\else\vskip0.02\paperheight\fi   % after other lines (a byline's last)
  \engine@flush{\engine@elcolor{date}\usebeamerfont{date}\MakeUppercase{\insertdate}\par}%
  \def\engine@pending{\vskip0.02\paperheight}\def\engine@started{1}\fi}
\def\engine@el@title{\engine@flush
  \setbox\@tempboxa=\vbox{\hsize=\engine@bw \engine@palign\engine@part
    {\usebeamerfont{title}\inserttitle\par}%
    \engine@has{subtitle}{\engine@els}\ifin@\ifx\insertsubtitle\@empty\else
      \vskip0.5em{\engine@elcolor{subtitle}\usebeamerfont{subtitle}\insertsubtitle\par}%
    \fi\fi}%
  \engine@ctab\@tempboxa
  \vskip0.03\paperheight
  \engine@ifc{column@rule@w}{%
    {\usebeamercolor[fg]{title rule}\vrule width\engine@cv{column@rule@w}\paperwidth
      height\engine@cv{column@rule@h}\paperheight}\par
    \vskip0.03\paperheight}{}\def\engine@started{1}}
\def\engine@el@subtitle{\engine@has{title}{\engine@els}\ifin@\else   % with the title: in its box
  \ifx\insertsubtitle\@empty\else\engine@flush
    {\engine@elcolor{subtitle}\usebeamerfont{subtitle}\insertsubtitle\par}\def\engine@started{1}\fi\fi}
\def\engine@el@author{\ifx\insertauthor\@empty\else\engine@flush
  {\engine@elcolor{author}\usebeamerfont{author}\insertauthor\par}\def\engine@started{1}\fi}
\def\engine@el@institute{\ifx\insertinstitute\@empty\else\engine@flush
  {\engine@elcolor{institute}\usebeamerfont{institute}\insertinstitute\par}\def\engine@started{1}\fi}
\def\engine@textstack#1{\def\engine@part{#1}%
  \engine@ifc{#1@elements}{\edef\engine@els{\engine@cv{#1@elements}}}{\def\engine@els{date,title,subtitle,author,institute}}%
  \let\engine@pending\@empty\let\engine@started\@empty
  \vbox{\hsize=\engine@bw \engine@palign{#1}%
    \@for\engine@el:=\engine@els\do{\csname engine@el@\engine@el\endcsname}%
    \engine@pending}}
\def\engine@titlestack{\engine@textstack{column}}
% keep the title frame free of frame numbering by default
\def\engine@titlepageframe{%
  {\setbeamertemplate{footline}{}\begin{frame}[plain,noframenumbering]\titlepage\end{frame}}}

% ---------------------------------------------------------------------------
% section divider;  \sectionsubtitle{...} before \section{...} adds a line
% under the heading, cleared again once that divider is drawn
% ---------------------------------------------------------------------------
\def\engine@sectionsubtitle{}
\newcommand\sectionsubtitle[1]{\gdef\engine@sectionsubtitle{#1}}
% the same, keyed by section number and declared in the preamble (Quarto filter)
\newcommand\enginesectionsubtitle[2]{\expandafter\gdef\csname engine@secsub@#1\endcsname{#2}}
\defbeamertemplate*{section page}{Engine}{%
  \gdef\engine@bodystyle{section}%
  \vbox to \dimexpr\textheight-2pt\relax{\vfil}}
% the divider's stack, in its column: the eyebrow (none when section.label is null), the heading
% and its subtitle, with the tab
\def\engine@sectionstack{%
  \setbox\@tempboxa=\vbox{\hsize=\engine@bw \engine@calign
    \engine@ifc{eyebrow@label}{\ifnum\thesection>0
      {\usebeamerfont{section number}\color{\engine@ccolor{Eyebrow}}%
        \MakeUppercase{\insertsectionnumberlabel}\par}\vskip0.6ex
    \fi}{}%
    {\usebeamerfont{section title}\insertsectionhead\par}%
    \ifx\engine@sectionsubtitle\@empty\else
      \vskip1.2ex
      {\usebeamerfont{section subtitle}\engine@sectionsubtitle\par}%
    \fi}%
  \engine@ctab\@tempboxa}
% the livery's word (section.label), as HTML and pptx set it
\def\insertsectionnumberlabel{\engine@cv{eyebrow@label}~\insertsectionnumber}
\defbeamertemplate*{subsection page}{Engine}{%
  \vbox{\raggedright
    {\usebeamerfont{section number}\usebeamercolor[fg]{structure}%
      \MakeUppercase{\insertsectionhead}\par}\vskip0.8ex
    {\usebeamerfont{subsection title}\usebeamercolor[fg]{frametitle}%
      \insertsubsectionhead\par}}}

\ifengine@sectionpages
  \AtBeginSection[]{%
    \@ifundefined{engine@secsub@\thesection}{}{%
      \expandafter\gdef\expandafter\engine@sectionsubtitle\expandafter
        {\csname engine@secsub@\thesection\endcsname}}%
    {\setbeamercolor{normal text}{fg=BrandPrimaryText}%
     \begin{frame}[plain,noframenumbering]\sectionpage\end{frame}}%
    \gdef\engine@sectionsubtitle{}}
\fi

% ---------------------------------------------------------------------------
% closing frame:  \engineclosingframe{Thank you!}{contact details ...}
% or \begin{frame}[engineclosing] ... \end{frame}
% ---------------------------------------------------------------------------
\newcommand\engineclosingframe[2]{%
  \begin{frame}[engineclosing,plain,noframenumbering]
    \engineclosingcontent{#1}{#2}
  \end{frame}}
% The body is user content, which may hold overlays (\pause): it is set in the frame body, once
% per overlay, into a box the background places in the column under the headline.
\newsavebox\engine@closingbody
\newcommand\engineclosingcontent[2]{%
  \gdef\engine@closinghead{#1}%
  \global\setbox\engine@closingbody=\vbox{%
    \hsize=\csname engine@c@\engine@closingcomp @column@w\endcsname\paperwidth
    \engine@calignof\engine@closingcomp\usebeamerfont{normal text}#2\par}%
  \vbox to \dimexpr\textheight-2pt\relax{\vfil}}
\def\engine@closingstack{%
  \setbox\@tempboxa=\vbox{\hsize=\engine@bw \engine@calign
    \usebeamerfont{section title}\engine@closinghead\par}%
  \vbox{\hsize=\engine@bw
    \engine@ctab\@tempboxa
    \vskip0.05\paperheight
    \copy\engine@closingbody}}

% ---------------------------------------------------------------------------
% lists
% ---------------------------------------------------------------------------
\setbeamertemplate{itemize item}{%
  \tikz[baseline=-0.62ex]\fill[BrandPrimaryContrast] (0,0) circle (0.42ex);}
\setbeamertemplate{itemize subitem}{%
  \tikz[baseline=-0.62ex]\draw[BrandPrimaryContrast,line width=0.9pt] (0,0) circle (0.36ex);}
\setbeamertemplate{itemize subsubitem}{%
  \tikz[baseline=-0.62ex]\fill[BrandPrimaryContrast] (-0.35ex,-0.1ex) rectangle (0.35ex,0.1ex);}
\setbeamertemplate{enumerate item}{\textbf{\insertenumlabel.}}
\setbeamertemplate{enumerate subitem}{\textbf{\insertenumlabel.\insertsubenumlabel}}
\setbeamertemplate{enumerate subsubitem}{%
  \textbf{\insertenumlabel.\insertsubenumlabel.\insertsubsubenumlabel}}
\setlength{\leftmargini}{1.4em}
% items spaced as HTML's list items are (their margins): a share of the body size (livery.sty type);
% \list reads \@listi and \@listii (the size commands no longer reset them)
\def\@listi{\leftmargin\leftmargini\topsep0.3\engine@typebody\parsep\z@\itemsep0.25\engine@typebody}
\let\@listI\@listi
\def\@listii{\leftmargin\leftmarginii\topsep0.1\engine@typebody\parsep\z@\itemsep0.15\engine@typebody}
% tables as HTML's: the table size, rows padded (0.3em above and below their cells)
\AtBeginDocument{\renewcommand\arraystretch{1.45}%
  \@ifundefined{longtable}{}{\AtBeginEnvironment{longtable}{\engine@fs{table}\selectfont}}%
  \AtBeginEnvironment{tabular}{\engine@fs{table}\selectfont}}
% pandoc's tight lists (\tightlist zeroes \itemsep) keep it too: HTML spaces them alike
\AtBeginDocument{\providecommand\tightlist{}\renewcommand\tightlist{\parskip\z@\ifnum\@listdepth>1
  \itemsep0.15\engine@typebody\else\itemsep0.25\engine@typebody\fi}}
\setbeamertemplate{sections/subsections in toc}[square]
% a caption is its text alone, centred (the caption font and color: beamer draws the template
% with both), as HTML and pptx set it: no "Figure 1:" label
\setbeamertemplate{caption}{{\centering\insertcaption\par}}
% Quarto loads the caption package (before the theme), which draws its own label: none there either
\AtBeginDocument{\@ifpackageloaded{caption}{\captionsetup{labelformat=empty,labelsep=none,
  justification=centering}}{}}
\setbeamertemplate{bibliography item}{\insertbiblabel}

% ---------------------------------------------------------------------------
% blocks: square, flat (no shadows/gradients -- Brand Guide p25)
% ---------------------------------------------------------------------------
\setbeamertemplate{blocks}[default]
\addtobeamertemplate{block begin}{}{\vskip-0.2ex}

% blocks on photo ("feature") frames: dark titles over white bodies, on the panel
\def\engine@featureblocks{%
  \setbeamercolor{block title}{fg=white,bg=BrandDark}%
  \setbeamercolor{block body}{fg=BrandDark,bg=white}%
  \setbeamercolor{block title example}{fg=BrandDark,bg=BrandSecondary}%
  \setbeamercolor{block body example}{fg=BrandDark,bg=white}%
  \setbeamercolor{block title alerted}{fg=BrandDark,bg=BrandAccent}%
  \setbeamercolor{block body alerted}{fg=white,bg=BrandDark}}

% ---------------------------------------------------------------------------
% feature frames: \begin{enginefeaturepanel} ... \end{enginefeaturepanel} (the Quarto filter
% wraps the body) sets the body, once per overlay, into a box the background places on the
% composition's panel (white text), or under the cover's title
% ---------------------------------------------------------------------------
\newsavebox\engine@panelbox
\newif\ifengine@haspanel
% its pads (livery.sty \engine@boxes@panel@pad*, em, set here as before: in the em of the theme's load)
\newdimen\engine@panelpady \engine@panelpady=\engine@boxes@panel@pady em
\newdimen\engine@panelpadx \engine@panelpadx=\engine@boxes@panel@padx em
\def\enginefeaturepanel{\global\engine@haspaneltrue
  \global\setbox\engine@panelbox=\vbox\bgroup
    \ifcsname engine@c@feature@panel@w\endcsname
      \hsize=\dimexpr\engine@c@feature@panel@w\paperwidth-2\engine@panelpadx\relax\colorlet{EngineFeatureText}{white}%
    \else
      \hsize=\engine@c@feature@column@w\paperwidth\colorlet{EngineFeatureText}{EngineCfeatureText}%
    \fi
    \textwidth=\hsize \linewidth=\hsize \columnwidth=\hsize   % blocks and lists are set this wide, not the frame's
    \color{EngineFeatureText}\setbeamercolor{normal text}{fg=EngineFeatureText}%
    % blocks on the panel or the field are a heading over text, as HTML's: no box of their own (a
    % beamer block box takes the frame's margins, not the panel's width)
    \engine@plainblock{block}{BrandSecondary}\engine@plainblock{block example}{BrandSecondary}%
    \engine@plainblock{block alerted}{BrandAccent}%
    \raggedright\usebeamerfont{normal text}}
% \engine@plainblock{<block kind>}{<title color>}: that block kind as a heading over its body
\def\engine@plainblock#1#2{%
  \setbeamertemplate{#1 begin}{\par\vskip0.6ex{\usebeamerfont{block title}\color{#2}\insertblocktitle\par}\vskip0.3ex
    \usebeamerfont{block body}}%
  \setbeamertemplate{#1 end}{\par\vskip0.6ex}}
\def\endenginefeaturepanel{\par\egroup}
% the bar's title, centred on it: the frame title and subtitle
\def\engine@featuretitle{\vbox{\hsize=\engine@bw \engine@calign
  {\usebeamerfont{frametitle}\insertframetitle\par}%
  \ifx\insertframesubtitle\@empty\else
    \vskip0.3ex{\usebeamerfont{framesubtitle}\color{BrandSecondary}\insertframesubtitle\par}\fi}}
% the cover's stack: the title with its tab, the subtitle, the rule, then the body
\def\engine@featurestack{%
  \setbox\@tempboxa=\vbox{\hsize=\engine@bw \engine@calign
    {\usebeamerfont{frametitle}\insertframetitle\par}%
    \ifx\insertframesubtitle\@empty\else
      \vskip0.5ex{\usebeamerfont{framesubtitle}\insertframesubtitle\par}\fi}%
  \vbox{\hsize=\engine@bw \engine@calign
    \engine@ctab\@tempboxa
    \engine@ifc{column@rule@w}{\vskip0.03\paperheight
      {\usebeamercolor[fg]{title rule}\vrule width\engine@cv{column@rule@w}\paperwidth
        height\engine@cv{column@rule@h}\paperheight}\par}{}%
    \ifengine@haspanel\vskip0.03\paperheight\copy\engine@panelbox\global\engine@haspanelfalse\fi}}

% ---------------------------------------------------------------------------
% slide footnotes: asides at the foot of a frame, under a short muted rule,
% the marker hanging in the accent color
%   \enginefootnotespring          % first thing in the frame
%   ... the frame's content ...
%   \enginefootnotespring
%   \begin{enginefootnotes}
%     \enginefootnote{†}{An aside.}
%     \enginefootnote{‡}{Another.}
%   \end{enginefootnotes}
% The two springs (filll) outweigh the frame's own centering (fill): the
% content stays centered above, the footnotes stand on the floor.  The Quarto
% filter writes all of this for paragraphs that start with † or ‡.
% ---------------------------------------------------------------------------
\newcommand\enginefootnotespring{\par\vskip 0pt plus 1filll\relax}
\newenvironment{enginefootnotes}{%
  \par\noindent\begin{minipage}[b]{0.6\textwidth}\raggedright
  \usebeamerfont{footnote}\color{BrandMuted}%
  {\color{BrandText!30!BrandBackground}\rule{12mm}{0.6pt}}\par\vskip0.8ex}%
  {\end{minipage}\par}
\newcommand\enginefootnote[2]{%
  \par\hangindent=1.1em\hangafter=1\noindent
  \makebox[1.1em][l]{\textcolor{BrandAccent}{\bfseries #1}}#2\par\vskip0.4ex}

% ---------------------------------------------------------------------------
% note: a remark under a figure or table, in the caption's look (the full
% frame's \enginefullcaption): the caption size, muted, centred.  The Quarto
% filter writes it for a ::: note div (after a table, it first takes back the
% skip longtable leaves, \LTpost).
%   \enginenote{121 PiB used of 141 PiB.}
% ---------------------------------------------------------------------------
\newcommand\enginenote[1]{%
  \par\vskip0.4ex{\centering\usebeamerfont{caption}\color{BrandMuted}#1\par}}

% ---------------------------------------------------------------------------
% caution box: a warning slide's body on a soft yellow field, a brand-yellow
% bar at its left (the Quarto filter writes it for {.caution}); the bar's width
% (of the paper height) and the pads (em of the body) are livery.sty's boxes
% ---------------------------------------------------------------------------
% (livery.sty defines it first when the livery's blends: overrides caution-fill)
\@ifundefined{\string\color@enginecautionfill}{\colorlet{enginecautionfill}{BrandWarning!18!BrandBackground}}{}
% \engine@barbox{<box>} ... \endengine@barbox{<fill>}{<bar color>}: the body set in a minipage the
% line width less the bar and the pads (livery.sty's \engine@boxes@<box>@bar, @padx, @pady; a box
% without a bar has none), on the fill with the bar at its left. \colorbox's one \fboxsep is 0: the
% pads are explicit, the vertical and the horizontal apart. The caution box and the lead are on it.
\newsavebox\engine@barboxbox
\newdimen\engine@padx \newdimen\engine@pady \newdimen\engine@barw
\def\engine@barbox#1{%
  \par\noindent\engine@padx=\csname engine@boxes@#1@padx\endcsname em%
  \engine@pady=\csname engine@boxes@#1@pady\endcsname em%
  \ifcsname engine@boxes@#1@bar\endcsname\engine@barw=\csname engine@boxes@#1@bar\endcsname\paperheight
  \else\engine@barw=\z@\fi
  \edef\engine@outerparskip{\the\parskip}% a minipage zeroes it; the box's paragraphs keep the frame's
  \begin{lrbox}{\engine@barboxbox}%
  \begin{minipage}{\dimexpr\linewidth-\engine@barw-2\engine@padx\relax}\parskip=\engine@outerparskip\relax}
\def\endengine@barbox#1#2{\end{minipage}\end{lrbox}%
  \hbox{{\color{#2}\vrule width \engine@barw}%
    {\setlength\fboxsep{0pt}\colorbox{#1}{\vbox{\vskip\engine@pady
      \hbox{\hskip\engine@padx\usebox\engine@barboxbox\hskip\engine@padx}\vskip\engine@pady}}}}\par}
\newenvironment{enginecaution}{\engine@barbox{caution}}{\endengine@barbox{enginecautionfill}{BrandWarning}}

% ---------------------------------------------------------------------------
% lead box: ::: {.lead} before a slide's columns (the Quarto filter writes it), its lines on the
% lead fill with a bar at its left, a pad's gap under it (livery.sty's boxes.lead)
% ---------------------------------------------------------------------------
\newenvironment{enginelead}{\engine@barbox{lead}}%
  {\endengine@barbox{EngineBoxesLeadFill}{EngineBoxesLeadBarColor}\vskip\engine@pady}

% ---------------------------------------------------------------------------
% columns: \enginecolshare{<share>}{<n columns>}\linewidth is a column's width, its share of the line
% width less the n - 1 gaps (livery.sty's boxes.columns.gap); the Quarto filter has pandoc write
% \begin{columns}[T,onlytextwidth], whose \hfill between columns is then the gap
% {.wide}: \begin{enginewide} sets the body \paperwidth less geometry.wide-margin a side
% ---------------------------------------------------------------------------
\newcommand\enginecolshare[2]{\fpeval{#1*(1-(#2-1)*\engine@boxes@columns@gap*\paperwidth/\linewidth)}}
% \enginecolrule, before each column but the first: boxes.columns.rule's width of the paper height,
% centered in the gap beamer's \hfill left before it, the row's height (a \vrule's unset depth runs
% to its box's; its height is the 1ex [T] columns start above their reference point), in the rule
% blend; nothing when the rule is 0. Its kerns add to no width.
\newcommand\enginecolrule{\ifdim\engine@boxes@columns@rule\paperheight>\z@
  \kern-.5\dimexpr\engine@boxes@columns@gap\paperwidth+\engine@boxes@columns@rule\paperheight\relax
  {\color{BrandRule}\vrule width\engine@boxes@columns@rule\paperheight height 1ex}%
  \kern.5\dimexpr\engine@boxes@columns@gap\paperwidth-\engine@boxes@columns@rule\paperheight\relax\fi}
\def\engine@wideout{\dimexpr\engine@geom@margin\paperwidth-\engine@geom@widemargin\paperwidth\relax}
\newenvironment{enginewide}{\par\vskip-\parskip\noindent\hspace*{-\engine@wideout}%   % at the body's top
  \begin{minipage}[t]{\dimexpr\paperwidth-2\dimexpr\engine@geom@widemargin\paperwidth\relax\relax}}%
  {\end{minipage}\hspace*{-\engine@wideout}\par}

% ---------------------------------------------------------------------------
% cards: a row of \begin{enginecard}[pick,solid|plain]{<role color>}{<share>}{<n>}{<title>}{<sub>}
% ... \end{enginecard} inside \begin{enginecards} ... \end{enginecards} (the Quarto filter writes
% them for ::: {.column .card}). Each body is set first into a box (as the feature panel's: verbatim
% works), its width the card's share of the line less the gaps, its pads and outline; the row then
% draws every card as a tcolorbox one height, the tallest body and head (one run, no aux; each
% head its own text's height, as HTML's and the pptx's): a head
% band in the role (the title in the block title font, bold, its sub in the body's) over the body
% on the card fill, rounded by boxes.card.radius, a pick outlined in outline-color, a solid card all
% the role's with its text in primary-text; plain (a column beside cards) has no fill or band.
% \enginelabel and \enginebig are a card's small-caps label and big number.
% ---------------------------------------------------------------------------
\RequirePackage{tcolorbox}\tcbuselibrary{skins,breakable}   % breakable: Quarto's callouts, which load it after this
\newcount\engine@ncards
\newdimen\engine@cardbody \newdimen\engine@cardhead \newdimen\engine@cardw \newdimen\engine@cardrule
\newbox\engine@cardboxi \newbox\engine@cardboxii \newbox\engine@cardboxiii
\newbox\engine@cardboxiv \newbox\engine@cardboxv \newbox\engine@cardboxvi
\def\engine@cardbox#1{\csname engine@cardbox\romannumeral#1\endcsname}
\def\engine@labelcolor{BrandMuted}\def\engine@bigcolor{BrandPrimaryContrast}
\newcommand\enginelabel[1]{{\usebeamerfont{eyebrow}\color{\engine@labelcolor}\engine@tracking\MakeUppercase{#1}}}
\newcommand\enginebig[1]{{\usebeamerfont{display}\color{\engine@bigcolor}#1}}
\newenvironment{enginecards}{\par\global\engine@ncards=\z@ \global\engine@cardbody=\z@ \global\engine@cardhead=\z@}%
  {\engine@drawcards\par}
\def\engine@cardval#1{\csname engine@card@#1@\the\engine@ncards\endcsname}
\newcommand\enginecard[6][]{%
  \global\advance\engine@ncards\@ne
  \expandafter\xdef\csname engine@card@opts@\the\engine@ncards\endcsname{#1}%
  \expandafter\xdef\csname engine@card@role@\the\engine@ncards\endcsname{#2}%
  \expandafter\gdef\csname engine@card@title@\the\engine@ncards\endcsname{#5}%
  \expandafter\gdef\csname engine@card@sub@\the\engine@ncards\endcsname{#6}%
  \engine@cardw=\dimexpr#3\dimexpr\linewidth-\engine@boxes@columns@gap\paperwidth*(#4-1)\relax\relax
  \expandafter\xdef\csname engine@card@w@\the\engine@ncards\endcsname{\the\engine@cardw}%
  \engine@cardrule=\z@ \in@{pick}{#1}\ifin@\engine@cardrule=\engine@boxes@card@outline\paperheight\fi
  \expandafter\xdef\csname engine@card@rule@\the\engine@ncards\endcsname{\the\engine@cardrule}%
  \def\engine@tmpa{#5#6}\ifx\engine@tmpa\@empty\else   % the head's height, the row's tallest
    \setbox\@tempboxa=\vbox{\hsize=\dimexpr\engine@cardw-2\engine@cardrule-2\dimexpr\engine@boxes@card@headpadx em\relax\relax
      \raggedright{\usebeamerfont{block title}\bfseries\strut#5\par}%
      \def\engine@tmpa{#6}\ifx\engine@tmpa\@empty\else{\normalsize\mdseries\strut#6\par}\fi}%
    \ifdim\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax>\engine@cardhead
      \global\engine@cardhead=\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax\fi
  \fi
  \edef\engine@outerparskip{\the\parskip}%
  \global\setbox\engine@cardbox{\engine@ncards}=\vbox\bgroup
    \hsize=\dimexpr\engine@cardw-2\engine@cardrule-2\dimexpr\engine@boxes@card@padx em\relax\relax
    \textwidth=\hsize \linewidth=\hsize \columnwidth=\hsize \parskip=\engine@outerparskip\relax
    \raggedright\usebeamerfont{normal text}%
    % on a solid card the text is the tcolorbox's coltext (no \color here: its whatsit would put
    % \parskip over the first paragraph, which an empty list does not get)
    \in@{solid}{#1}\ifin@\setbeamercolor{normal text}{fg=BrandPrimaryText}%
      \def\engine@labelcolor{BrandPrimaryText}\def\engine@bigcolor{BrandPrimaryText}\fi}
\def\endenginecard{\par\egroup
  \ifdim\dimexpr\ht\engine@cardbox{\engine@ncards}+\dp\engine@cardbox{\engine@ncards}\relax>\engine@cardbody
    \global\engine@cardbody=\dimexpr\ht\engine@cardbox{\engine@ncards}+\dp\engine@cardbox{\engine@ncards}\relax\fi}
% the row: each card a tcolorbox, the gap between them; its height the tallest body and head
\def\engine@drawcards{\hbox{\@tempcnta=\z@   % a box in the vertical list: no paragraph, no \parskip
  \loop\advance\@tempcnta\@ne
    \ifnum\@tempcnta>\@ne\hskip\engine@boxes@columns@gap\paperwidth\fi
    \engine@drawcard{\the\@tempcnta}%
  \ifnum\@tempcnta<\engine@ncards\repeat}}
\def\engine@add#1{\expandafter\def\expandafter\engine@ckeys\expandafter{\engine@ckeys,#1}}
\def\engine@cardtitle{\raggedright\strut\engine@ctitle\par
  \ifx\engine@csub\@empty\else{\normalsize\mdseries\strut\engine@csub\par}\fi}
\def\engine@begincard#1{\begin{tcolorbox}[enhanced,nobeforeafter,box align=top,valign=top,boxsep=0pt,
  before skip=0pt,after skip=0pt,coltitle=BrandPrimaryText,fonttitle=\usebeamerfont{block title}\bfseries#1]}
% \engine@hasopt{<word>}: \ifin@ for the card's options (\in@ does not expand its arguments)
\def\engine@hasopt#1{\edef\engine@tmpc{\noexpand\in@{#1}{\engine@copts}}\engine@tmpc}
\def\engine@drawcard#1{%
  \edef\engine@copts{\csname engine@card@opts@#1\endcsname}%
  \edef\engine@crole{\csname engine@card@role@#1\endcsname}%
  \expandafter\let\expandafter\engine@ctitle\csname engine@card@title@#1\endcsname
  \expandafter\let\expandafter\engine@csub\csname engine@card@sub@#1\endcsname
  \edef\engine@ckeys{,width=\csname engine@card@w@#1\endcsname,
    height=\the\dimexpr\engine@cardbody+\engine@cardhead
      +2\dimexpr\engine@boxes@card@pady em\relax+2\dimexpr\engine@boxes@card@headpady em\relax
      +2\dimexpr\csname engine@card@rule@#1\endcsname\relax\relax,
    boxrule=\csname engine@card@rule@#1\endcsname,
    left=\the\dimexpr\engine@boxes@card@padx em\relax,right=\the\dimexpr\engine@boxes@card@padx em\relax,
    top=\the\dimexpr\engine@boxes@card@pady em\relax,bottom=\the\dimexpr\engine@boxes@card@pady em\relax,
    lefttitle=\the\dimexpr\engine@boxes@card@headpadx em\relax,righttitle=\the\dimexpr\engine@boxes@card@headpadx em\relax,
    toptitle=\the\dimexpr\engine@boxes@card@headpady em\relax,bottomtitle=\the\dimexpr\engine@boxes@card@headpady em\relax,
    colbacktitle=\engine@crole,
    \ifdim\engine@boxes@card@radius\paperheight=\z@ sharp corners\else arc=\the\dimexpr\engine@boxes@card@radius\paperheight\relax\fi}%
  \engine@hasopt{plain}%
  \ifin@\engine@add{opacityback=0,opacityframe=0}%
  \else
    \engine@hasopt{solid}%
    \ifin@\edef\engine@tmpb{colback=\engine@crole,coltext=BrandPrimaryText,colframe=\engine@crole}%
    \else\def\engine@tmpb{colback=EngineBoxesCardFill,colframe=EngineBoxesCardFill}\fi
    \expandafter\engine@add\expandafter{\engine@tmpb}%
    \ifx\engine@ctitle\@empty\else\engine@add{title={\engine@cardtitle}}\fi
  \fi
  \engine@hasopt{pick}\ifin@\engine@add{colframe=EngineBoxesCardOutlineColor}\fi
  \expandafter\engine@begincard\expandafter{\engine@ckeys}\box\engine@cardbox{#1}\end{tcolorbox}}

% ---------------------------------------------------------------------------
% tables: pandoc's longtable, drawn as the HTML theme draws them -- no top
% rule, a heavy rule in the brand color under the header, a light one at the
% foot, and every second body row on Light Gray.  The Quarto filter wraps
% each header cell in \engineth and starts each banded row with
% \rowcolor{enginetableband}.  Hand-written tabulars are left alone.
% ---------------------------------------------------------------------------
\RequirePackage{colortbl}
\@ifundefined{\string\color@enginetableband}{\colorlet{enginetableband}{BrandSurface!60!BrandBackground}}{}% or livery.sty's
\@ifundefined{\string\color@enginetablerule}{\colorlet{enginetablerule}{BrandText!20!BrandSurface}}{}
\newcommand\engineth[1]{{\usebeamercolor[fg]{normal text}\bfseries
  \fontsize{\fpeval{0.8*\f@size}pt}{\fpeval{0.8*\strip@pt\dimexpr\f@baselineskip\relax}pt}%
  \selectfont\engine@tracking\MakeUppercase{#1}}}
\def\engine@tracking{\@ifpackageloaded{fontspec}{\addfontfeatures{LetterSpace=4}}{}}
% \arrayrulecolor is global, so put it back after each table
\AddToHook{env/longtable/begin}{%
  \let\engine@arc\CT@arc@
  \setlength\aboverulesep{0pt}\setlength\belowrulesep{0pt}%
  \setlength\extrarowheight{0pt}%
  \def\toprule{}%
  \def\midrule{\arrayrulecolor{BrandPrimaryContrast}\specialrule{1.5pt}{0.3ex}{0pt}}%
  \def\bottomrule{\arrayrulecolor{enginetablerule}\specialrule{0.6pt}{0pt}{0pt}}}
\AddToHook{env/longtable/end}{\global\let\CT@arc@\engine@arc}

