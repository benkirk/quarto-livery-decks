\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerinnerthemeEngine}[2026/09/30 v2.3 engine beamer inner theme]
%
% Title page, section divider, closing frame, blocks and lists.
% Title page layout follows the brand's slide template (Brand Guide p26):
% logo lockup, date, bold title with an accent bar at the left edge,
% subtitle, short rule, presenter, affiliation, fine print; photo (from
% \titlegraphic) masked by the brand waves on the right.
%
\mode<presentation>
\@ifpackageloaded{engine_livery}{}{\RequirePackage{engine_livery}}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
% beamer's [shrink] ({.shrink}) sets the frame body in a pgf \pgftext, which under XeLaTeX
% (pgfsys-dvipdfmx.def) resets the color to black: put the body's color back, or a dark livery's
% shrunk slide is black on black (and a light one's text black, not the brand's)
\patchcmd\beamer@shrinkframebox
  {\pgftext[left,top]{\box\beamer@framebox}}
  {\pgftext[left,top]{\usebeamercolor[fg]{normal text}\box\beamer@framebox}}
  {}{\PackageWarning{beamerinnerthemeEngine}{could not patch \string\beamer@shrinkframebox}}
\providecommand\engine@titlestyle{dark}
\@ifundefined{ifengine@sectionpages}{\newif\ifengine@sectionpages\engine@sectionpagestrue}{}

% the cover's fine print, e.g. an NSF funding statement: \titlefineprint{<text>}, {} for none;
% unset (\relax), the livery's default (compositions.<cover>.fineprint.text), if it has one
\let\engine@fineprint\relax
\newcommand\titlefineprint[1]{\def\engine@fineprint{#1}}

% the composition column's text alignment (column.align: left | center; \engine@calignof{<comp>}
% where \engine@comp is not set, as in the closing's body)
\def\engine@calignof#1{\engine@ifcorner{\csname engine@c@#1@column@align\endcsname}{center}{\centering}{\raggedright}}
\providecommand\engine@comp{}   % set by \engine@drawcomp; empty: left
\def\engine@calign{\engine@calignof\engine@comp}
% \engine@ctab{<box>}: the same beside a composition's column (\engine@bx from the paper's
% edge), when the column has a tab
\def\engine@ctab#1{\engine@ifcorner{\engine@cv{column@tab}}{true}{%
  \hbox{\hskip-\engine@bx
    {\usebeamercolor[fg]{frametitle tab}\vrule width\engine@tabwidth height\ht#1 depth\dp#1}%
    \hskip\dimexpr\engine@bx-\engine@tabwidth\relax
    \box#1}}{\box#1}}

% ---------------------------------------------------------------------------
% title page
% ---------------------------------------------------------------------------
% the text sits in the composition's column, drawn by the background (beamerouterthemeEngine.sty
% \engine@drawcomp); the frame body only fills the page
\defbeamertemplate*{title page}{Engine}{%
  \gdef\engine@bodystyle{title}%
  \vbox to \dimexpr\textheight-2pt\relax{\vfil}}
% a cover's text parts (livery.json compositions: column.elements, byline): \engine@textstack{<part>}
% walks the part's elements in order, \engine@bw wide. The title carries the tab and the rule, and the
% subtitle with it when the part holds both; a byline's elements are its own stack in its box, or,
% without one (byline@inline), stay in the column's flow in the byline's color. The default order
% (date, title, subtitle, author, institute) sets exactly what the single stack set before.
\def\engine@has#1#2{\edef\engine@tmpl{\noexpand\in@{,#1,}{,#2,}}\engine@tmpl}
\def\engine@palign#1{\engine@ifcorner{\csname engine@c@\engine@comp @#1@align\endcsname}{center}{\centering}{\raggedright}}
\def\engine@elcolor#1{\def\engine@tmpp{column}\ifx\engine@part\engine@tmpp
  \engine@ifc{byline@inline}{\engine@has{#1}{\engine@cv{byline@inline}}\ifin@\color{\engine@ccolor{Byline}}\fi}{}\fi}
\def\engine@flush{\engine@pending\let\engine@pending\@empty}
\def\engine@el@date{\ifx\insertdate\@empty\else
  \ifx\engine@started\@empty\else\vskip0.02\paperheight\fi   % after other lines (a byline's last)
  \engine@flush{\engine@elcolor{date}\usebeamerfont{date}\engine@tracking\MakeUppercase{\insertdate}\par}%
  \def\engine@pending{\vskip0.02\paperheight}\def\engine@started{1}\fi}
\def\engine@el@title{\engine@flush
  \setbox\@tempboxa=\vbox{\hsize=\engine@bw \engine@palign\engine@part
    {\usebeamerfont{title}\inserttitle\par}%
    \engine@has{subtitle}{\engine@els}\ifin@\ifx\insertsubtitle\@empty\else
      \vskip0.5em{\engine@elcolor{subtitle}\usebeamerfont{subtitle}\insertsubtitle\par}%
    \fi\fi}%
  \engine@ctab\@tempboxa
  \vskip0.03\paperheight
  \engine@ifc{column@rule@w}{%
    {\usebeamercolor[fg]{title rule}\vrule width\engine@cv{column@rule@w}\paperwidth
      height\engine@cv{column@rule@h}\paperheight}\par
    \vskip0.03\paperheight}{}\def\engine@started{1}}
\def\engine@el@subtitle{\engine@has{title}{\engine@els}\ifin@\else   % with the title: in its box
  \ifx\insertsubtitle\@empty\else\engine@flush
    {\engine@elcolor{subtitle}\usebeamerfont{subtitle}\insertsubtitle\par}\def\engine@started{1}\fi\fi}
\def\engine@el@author{\ifx\insertauthor\@empty\else\engine@flush
  {\engine@elcolor{author}\usebeamerfont{author}\insertauthor\par}\def\engine@started{1}\fi}
\def\engine@el@institute{\ifx\insertinstitute\@empty\else\engine@flush
  {\engine@elcolor{institute}\usebeamerfont{institute}\insertinstitute\par}\def\engine@started{1}\fi}
\def\engine@textstack#1{\def\engine@part{#1}%
  \engine@ifc{#1@elements}{\edef\engine@els{\engine@cv{#1@elements}}}{\def\engine@els{date,title,subtitle,author,institute}}%
  \let\engine@pending\@empty\let\engine@started\@empty
  \vbox{\hsize=\engine@bw \engine@palign{#1}%
    \@for\engine@el:=\engine@els\do{\csname engine@el@\engine@el\endcsname}%
    \engine@pending}}
\def\engine@titlestack{\engine@textstack{column}}

% ---------------------------------------------------------------------------
% section divider;  \sectionsubtitle{...} before \section{...} adds a line
% under the heading, cleared again once that divider is drawn
% ---------------------------------------------------------------------------
\def\engine@sectionsubtitle{}
\newcommand\sectionsubtitle[1]{\gdef\engine@sectionsubtitle{#1}}
% the same, keyed by section number and declared in the preamble (Quarto filter)
\newcommand\enginesectionsubtitle[2]{\expandafter\gdef\csname engine@secsub@#1\endcsname{#2}}
\defbeamertemplate*{section page}{Engine}{%
  \gdef\engine@bodystyle{section}%
  \vbox to \dimexpr\textheight-2pt\relax{\vfil}}
% the divider's stack, in its column: the eyebrow (none when section.label is null), the heading
% and its subtitle, with the tab
\def\engine@sectionstack{%
  \setbox\@tempboxa=\vbox{\hsize=\engine@bw \engine@calign
    % the gaps are the livery's section.eyebrow-gap and .subtitle-gap, em of the eyebrow's and the
    % subtitle's own type (livery.sty), as the scss sets them
    \engine@ifc{eyebrow@label}{\ifengine@numbered\ifnum\thesection>0
      {\usebeamerfont{section number}\color{\engine@ccolor{Eyebrow}}\engine@tracking
        \MakeUppercase{\insertsectionnumberlabel}\par\vskip\engine@section@eyebrowgap em}%
    \fi\fi}{}%
    {\usebeamerfont{section title}\ifengine@numbered\insertsectionhead\else\engine@sectionhead\fi\par}%
    \ifx\engine@sectionsubtitle\@empty\else
      {\usebeamerfont{section subtitle}\vskip\engine@section@subtitlegap em\engine@sectionsubtitle\par}%
    \fi}%
  \engine@ctab\@tempboxa}
% the livery's word (section.label), as HTML and pptx set it; with section.progress, "of" the total
% of numbered sections, \enginesectiontotal{<n>} in the preamble (the Quarto filter writes it)
\newcommand\enginesectiontotal[1]{\gdef\engine@sectiontotal{#1}}
\def\insertsectionnumberlabel{\engine@cv{eyebrow@label}~\insertsectionnumber
  \engine@ifc{eyebrow@progress}{\ifdefined\engine@sectiontotal~of~\engine@sectiontotal\fi}{}}
\defbeamertemplate*{subsection page}{Engine}{%
  \vbox{\raggedright
    {\usebeamerfont{section number}\usebeamercolor[fg]{structure}%
      \MakeUppercase{\insertsectionhead}\par}\vskip0.8ex
    {\usebeamerfont{subsection title}\usebeamercolor[fg]{frametitle}%
      \insertsubsectionhead\par}}}

\ifengine@sectionpages
  \AtBeginSection[]{%
    \@ifundefined{engine@secsub@\thesection}{}{%   (its text, not its name: the aux file gets the text)
      \expandafter\global\expandafter\let\expandafter\engine@sectionsubtitle
        \csname engine@secsub@\thesection\endcsname}%
    \ifx\engine@sectionsubtitle\@empty\else   % for an agenda before it, on the next run
      \immediate\write\@auxout{\noexpand\enginesectionsubtitle{\thesection}{\unexpanded\expandafter{\engine@sectionsubtitle}}}\fi
    {\setbeamercolor{normal text}{fg=BrandPrimaryText}%
     \begin{frame}[plain,noframenumbering]\sectionpage\end{frame}}%
    \gdef\engine@sectionsubtitle{}}
\fi
% a divider outside the count (an appendix, the backup slides): the same stack with no eyebrow,
% and no \section, so no counter step, no table-of-contents line and no PDF bookmark (\section*
% steps the counter as \section does).  \enginesectionunnumbered{Title}{Subtitle}, {} for none:
% between frames it draws a plain frame of its own; inside a frame (the Quarto filter opens one)
% it is that frame's body.  The stack is drawn at shipout, outside the body's group, so the
% heading, subtitle and switch are global until then.
\newif\ifengine@numbered \engine@numberedtrue
\def\engine@sectionhead{}
\AddToHook{shipout/after}{\ifengine@numbered\else
  \global\engine@numberedtrue\gdef\engine@sectionhead{}\gdef\engine@sectionsubtitle{}\fi}
\newcommand\enginesectionunnumbered[2]{%
  \ifbeamer@inframe\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi
    {\global\engine@numberedfalse
     \gdef\engine@sectionhead{#1}\gdef\engine@sectionsubtitle{#2}%
     \sectionpage}%
    {{\setbeamercolor{normal text}{fg=BrandPrimaryText}%
      \begin{frame}[plain,noframenumbering]\enginesectionunnumbered{#1}{#2}\end{frame}}}}

% ---------------------------------------------------------------------------
% closing frame:  \engineclosingframe{Thank you!}{contact details ...}
% or \begin{frame}[engineclosing] ... \end{frame}
% ---------------------------------------------------------------------------
\newcommand\engineclosingframe[2]{%
  \begin{frame}[engineclosing,plain,noframenumbering]
    \engineclosingcontent{#1}{#2}
  \end{frame}}
% The body is user content, which may hold overlays (\pause): it is set in the frame body, once
% per overlay, into a box the background places in the column under the headline.
\newsavebox\engine@closingbody
\newcommand\engineclosingcontent[2]{%
  \gdef\engine@closinghead{#1}%
  \global\setbox\engine@closingbody=\vbox{%
    \hsize=\csname engine@c@\engine@closingcomp @column@w\endcsname\paperwidth
    \engine@calignof\engine@closingcomp\usebeamerfont{normal text}#2\par}%
  \vbox to \dimexpr\textheight-2pt\relax{\vfil}}
\def\engine@closingstack{%
  \setbox\@tempboxa=\vbox{\hsize=\engine@bw \engine@calign
    \usebeamerfont{section title}\engine@closinghead\par}%
  \vbox{\hsize=\engine@bw
    \engine@ctab\@tempboxa
    \vskip0.05\paperheight
    \copy\engine@closingbody}}

% ---------------------------------------------------------------------------
% lists
% ---------------------------------------------------------------------------
\setbeamertemplate{itemize item}{%
  \tikz[baseline=-0.62ex]\fill[BrandPrimaryContrast] (0,0) circle (0.42ex);}
\setbeamertemplate{itemize subitem}{%
  \tikz[baseline=-0.62ex]\draw[BrandPrimaryContrast,line width=0.9pt] (0,0) circle (0.36ex);}
\setbeamertemplate{itemize subsubitem}{%
  \tikz[baseline=-0.62ex]\fill[BrandPrimaryContrast] (-0.35ex,-0.1ex) rectangle (0.35ex,0.1ex);}
% a livery's own glyphs per level (bullets:; livery.sty), in place of the shapes
\ifdefined\engine@bullet@i
  \setbeamertemplate{itemize item}{{\color{EngineBullet}\engine@bullet@i}}
  \setbeamertemplate{itemize subitem}{{\color{EngineBullet}\engine@bullet@ii}}
  \setbeamertemplate{itemize subsubitem}{{\color{EngineBullet}\engine@bullet@iii}}
\fi
\setbeamertemplate{enumerate item}{\textbf{\insertenumlabel.}}
\setbeamertemplate{enumerate subitem}{\textbf{\insertenumlabel.\insertsubenumlabel}}
\setbeamertemplate{enumerate subsubitem}{%
  \textbf{\insertenumlabel.\insertsubenumlabel.\insertsubsubenumlabel}}
\setlength{\leftmargini}{1.4em}
% items spaced as HTML's list items are (their margins): a share of the body size (livery.sty type);
% \list reads \@listi and \@listii (the size commands no longer reset them)
\def\@listi{\leftmargin\leftmargini\topsep0.3\engine@typebody\parsep\z@\itemsep0.25\engine@typebody}
\let\@listI\@listi
\def\@listii{\leftmargin\leftmarginii\topsep0.1\engine@typebody\parsep\z@\itemsep0.15\engine@typebody}
% tables as HTML's: the table size, rows padded (0.3em above and below their cells)
\AtBeginDocument{\renewcommand\arraystretch{1.45}%
  \@ifundefined{longtable}{}{\AtBeginEnvironment{longtable}{\engine@fs{table}\selectfont}}%
  \AtBeginEnvironment{tabular}{\engine@fs{table}\selectfont}}
% pandoc's tight lists (\tightlist zeroes \itemsep) keep it too: HTML spaces them alike
\AtBeginDocument{\providecommand\tightlist{}\renewcommand\tightlist{\parskip\z@\ifnum\@listdepth>1
  \itemsep0.15\engine@typebody\else\itemsep0.25\engine@typebody\fi}}
% the agenda: \engineagenda is beamer's table of contents (\section's lines in the .toc, from the
% run before) drawn as HTML's and the pptx's agenda rows: the number (the eyebrow font, bold,
% livery.sty's boxes.agenda number color) beside the title (the subhead size) and the divider's
% subtitle under it (the caption size, muted: \enginesectionsubtitle's, the Quarto filter's or the
% aux file's copy of a \sectionsubtitle), at the gap HTML's rows keep. Its state by the section the
% frame sits in: an earlier one muted (done), that one bold in the current color, a later one the
% text color; up front all the text color. A plain \tableofcontents draws its rows so, every one
% the text color. In a \vbox, so beamer's \vfill between rows stays at none (hideallsubsections would
% put a 1.5em skip there; tocdepth 1 leaves the subsections out instead).
\newif\ifengine@agenda
\def\engine@agenda@done{\color{BrandMuted}}
\def\engine@agenda@current{\color{EngineBoxesAgendaCurrentColor}\bfseries}
\def\engine@agenda@next{\color{BrandText}}
\def\engine@agendarow{%
  \edef\engine@tmpa{\ifengine@agenda\ifnum0\inserttocsectionnumber<\c@section done\else
    \ifnum0\inserttocsectionnumber=\c@section current\else next\fi\fi\else next\fi}%
  \vskip\dimexpr\engine@boxes@agenda@gap\engine@typebody-\parskip\relax   % the row gap: the paragraph skip taken back
  {\raggedright\engine@fs{subhead}\selectfont   % the number on the title's line, the title hung beside it
   \hangindent\engine@boxes@agenda@numberwidth\engine@typebody\noindent\hbox to \engine@boxes@agenda@numberwidth\engine@typebody{\usebeamerfont{eyebrow}%
     \color{EngineBoxesAgendaNumberColor}\inserttocsectionnumber\hfil}%
   {\csname engine@agenda@\engine@tmpa\endcsname\inserttocsection}\par}%
  \@ifundefined{engine@secsub@\inserttocsectionnumber}{}{\vskip\dimexpr0.15\engine@typebody-\parskip\relax
    {\raggedright\leftskip\engine@boxes@agenda@numberwidth\engine@typebody\usebeamerfont{caption}\color{BrandMuted}%
     \csname engine@secsub@\inserttocsectionnumber\endcsname\par}}}
\defbeamertemplate*{section in toc}{Engine}{\engine@agendarow}
\defbeamertemplate*{section in toc shaded}{Engine}{\engine@agendarow}
\newcommand\engineagenda{{\engine@agendatrue\c@tocdepth\@ne\vbox{\tableofcontents}}}   % sections only
% a caption is its text alone, centered (the caption font and color: beamer draws the template
% with both), as HTML and pptx set it: no "Figure 1:" label
\setbeamertemplate{caption}{{\centering\insertcaption\par}}
% Quarto loads the caption package (before the theme), which draws its own label: none there either
\AtBeginDocument{\@ifpackageloaded{caption}{\captionsetup{labelformat=empty,labelsep=none,
  justification=centering}}{}}
% thebibliography's label; biblatex defines no \insertbiblabel (its author-year lists have none)
\setbeamertemplate{bibliography item}{\ifdefined\insertbiblabel\insertbiblabel\fi}
% biblatex's list (\printbibliography) set as the Quarto list: the footnote size, a 1.5 em hanging
% indent, 0.4 em between entries
\AtBeginDocument{\@ifpackageloaded{biblatex}{\setlength\bibhang{\engine@boxes@references@hang em}\setlength\bibitemsep{\engine@boxes@references@gap em}%
  \AtBeginBibliography{\usebeamerfont{bibliography entry author}}}{}}
% the reference list (Quarto's citations partial: CSLReferences, {hanging}{entry spacing}) set as
% HTML and pptx set it: in the footnote size, a 1.5 em hanging indent, and the style's entry spacing
% (1 in most) in steps of 0.4 em rather than of a line. Inside it, beamer's \bibitem loses the
% 1.5 em strut it opens each entry with (\beamer@newblock: spacing for beamer's own bibliography,
% 0.3 of a line more above every entry here).
\AtBeginDocument{\ifdefined\cslhangindent
  \setlength\cslhangindent{\engine@boxes@references@hang em}%
  \renewenvironment{CSLReferences}[2]{\usebeamerfont{bibliography entry author}%
    \patchcmd\beamer@newblock{\ht\beamer@tempbox=1.5em}{}{}{}\begin{list}{}{%
    \setlength{\itemindent}{0pt}\setlength{\leftmargin}{0pt}\setlength{\parsep}{0pt}%
    \ifodd #1\relax\setlength{\leftmargin}{\cslhangindent}\setlength{\itemindent}{-1\cslhangindent}\fi
    \setlength{\itemsep}{#2\dimexpr\engine@boxes@references@gap em\relax}}}{\end{list}}\fi}

% ---------------------------------------------------------------------------
% blocks: square, flat (no shadows/gradients -- Brand Guide p25)
% ---------------------------------------------------------------------------
\setbeamertemplate{blocks}[default]
\addtobeamertemplate{block begin}{}{\vskip-0.2ex}

% blocks on photo ("feature") frames: dark titles over white bodies, on the panel
\def\engine@featureblocks{%
  \setbeamercolor{block title}{fg=BrandOnDark,bg=BrandDark}%
  \setbeamercolor{block body}{fg=BrandDark,bg=BrandBackground}%
  \setbeamercolor{block title example}{fg=BrandDark,bg=BrandSecondary}%
  \setbeamercolor{block body example}{fg=BrandDark,bg=BrandBackground}%
  \setbeamercolor{block title alerted}{fg=BrandDark,bg=BrandAccent}%
  \setbeamercolor{block body alerted}{fg=BrandOnDark,bg=BrandDark}}

% ---------------------------------------------------------------------------
% feature frames: \begin{enginefeaturepanel} ... \end{enginefeaturepanel} (the Quarto filter
% wraps the body) sets the body, once per overlay, into a box the background places on the
% composition's panel (white text), or under the cover's title
% ---------------------------------------------------------------------------
\newsavebox\engine@panelbox
\newif\ifengine@haspanel
% its pads (livery.sty \engine@boxes@panel@pad*, em, set here as before: in the em of the theme's load)
\newdimen\engine@panelpady \engine@panelpady=\engine@boxes@panel@pady em
\newdimen\engine@panelpadx \engine@panelpadx=\engine@boxes@panel@padx em
% \engine@hsize{<width>}: a box's line width, its blocks and lists set this wide too, not the
% frame's (beamer's columns and lists read \textwidth, \linewidth and \columnwidth, not \hsize)
\def\engine@hsize#1{\hsize=#1\relax\textwidth=\hsize \linewidth=\hsize \columnwidth=\hsize}
\def\enginefeaturepanel{\global\engine@haspaneltrue
  \global\setbox\engine@panelbox=\vbox\bgroup
    \ifcsname engine@c@feature@panel@w\endcsname
      \engine@hsize{\dimexpr\engine@c@feature@panel@w\paperwidth-2\engine@panelpadx\relax}\colorlet{EngineFeatureText}{BrandOnDark}%
    \else
      \engine@hsize{\engine@c@feature@column@w\paperwidth}\colorlet{EngineFeatureText}{EngineCfeatureText}%
    \fi
    \color{EngineFeatureText}\setbeamercolor{normal text}{fg=EngineFeatureText}%
    % blocks on the panel or the field are a heading over text, as HTML's: no box of their own (a
    % beamer block box takes the frame's margins, not the panel's width)
    \engine@plainblock{block}{BrandSecondary}\engine@plainblock{block example}{BrandSecondary}%
    \engine@plainblock{block alerted}{BrandAccent}%
    \raggedright\usebeamerfont{normal text}}
% \engine@plainblock{<block kind>}{<title color>}: that block kind as a heading over its body
\def\engine@plainblock#1#2{%   (the gaps in em of the block title, as every gap of the theme is set in em of its element)
  \setbeamertemplate{#1 begin}{\par{\usebeamerfont{block title}\vskip0.33em\color{#2}\insertblocktitle\par\vskip0.17em}%
    \usebeamerfont{block body}}%
  \setbeamertemplate{#1 end}{\par{\usebeamerfont{block title}\vskip0.33em}}}
\def\endenginefeaturepanel{\par\egroup}
% the bar's title, centered on it: the frame title and subtitle
\def\engine@featuretitle{\vbox{\hsize=\engine@bw \engine@calign
  {\usebeamerfont{frametitle}\insertframetitle\par}%
  \ifx\insertframesubtitle\@empty\else
    \vskip0.3ex{\usebeamerfont{framesubtitle}\color{BrandSecondary}\insertframesubtitle\par}\fi}}
% the cover's stack: the title with its tab, the subtitle, the rule, then the body
\def\engine@featurestack{%
  \setbox\@tempboxa=\vbox{\hsize=\engine@bw \engine@calign
    {\usebeamerfont{frametitle}\insertframetitle\par}%
    \ifx\insertframesubtitle\@empty\else
      \vskip0.5ex{\usebeamerfont{framesubtitle}\insertframesubtitle\par}\fi}%
  \vbox{\hsize=\engine@bw \engine@calign
    \engine@ctab\@tempboxa
    \engine@ifc{column@rule@w}{\vskip0.03\paperheight
      {\usebeamercolor[fg]{title rule}\vrule width\engine@cv{column@rule@w}\paperwidth
        height\engine@cv{column@rule@h}\paperheight}\par}{}%
    \ifengine@haspanel\vskip0.03\paperheight\copy\engine@panelbox\global\engine@haspanelfalse\fi}}

% ---------------------------------------------------------------------------
% slide footnotes: asides at the foot of a frame, under a short muted rule,
% the marker hanging in the accent color
%   \enginefootnotespring          % first thing in the frame
%   ... the frame's content ...
%   \enginefootnotespring
%   \begin{enginefootnotes}
%     \enginefootnote{†}{An aside.}
%     \enginefootnote{‡}{Another.}
%   \end{enginefootnotes}
% The two springs (filll) outweigh the frame's own centering (fill): the
% content stays centered above, the footnotes stand on the floor.  The Quarto
% filter writes all of this for paragraphs that start with † or ‡.
% ---------------------------------------------------------------------------
\newcommand\enginefootnotespring{\par\vskip 0pt plus 1filll\relax}
% Every number is boxes.footnote (livery.sty): the rule's length (of the paper's width), thickness
% (of its height) and color, the block's width (of the text width), and in em of the footnote
% type the gap under the rule, the marker's hang and the step between entries; HTML's
% .engine-footnotes and the pptx's style_footnotes.py read the same.
% the footnotes' short rule, drawn once: here and as beamer's \footnoterule (the misc section)
\newcommand\engine@footnoterule{{\color{EngineBoxesFootnoteRuleColor}%
  \rule{\engine@boxes@footnote@rulelength\paperwidth}{\engine@boxes@footnote@rule\paperheight}}}
\newenvironment{enginefootnotes}{%
  \par\noindent\begin{minipage}[b]{\engine@boxes@footnote@width\textwidth}\raggedright
  \usebeamerfont{footnote}\color{BrandMuted}%
  \engine@footnoterule\par\vskip\engine@boxes@footnote@gap em}%
  {\end{minipage}\par}
\newcommand\enginefootnote[2]{%
  \par\hangindent=\engine@boxes@footnote@hang em\hangafter=1\noindent
  \makebox[\engine@boxes@footnote@hang em][l]{\textcolor{BrandAccent}{\bfseries #1}}#2\par
  \vskip\engine@boxes@footnote@step em}

% ---------------------------------------------------------------------------
% note: a remark under a figure or table, in the caption's look (the full
% frame's \enginefullcaption): the caption size, muted, centered.  The Quarto
% filter writes it for a ::: note div (after a table, it first takes back the
% skip longtable leaves, \LTpost).
%   \enginenote{121 PiB used of 141 PiB.}
% ---------------------------------------------------------------------------
\newcommand\enginenote[1]{%   (boxes.note.gap under the figure, em of the caption type, as the scss)
  \par{\usebeamerfont{caption}\vskip\engine@boxes@note@gap em\centering\color{BrandMuted}#1\par}}

% ---------------------------------------------------------------------------
% caution box: a warning slide's body on a soft yellow field, a brand-yellow
% bar at its left (the Quarto filter writes it for {.caution}); the bar's width
% (of the paper height) and the pads (em of the body) are livery.sty's boxes
% ---------------------------------------------------------------------------
% (livery.sty defines it first when the livery's blends: overrides caution-fill)
\@ifundefined{\string\color@enginecautionfill}{\colorlet{enginecautionfill}{BrandWarning!18!BrandBackground}}{}
% \engine@barbox{<box>} ... \endengine@barbox{<fill>}{<bar color>}: the body set in a minipage the
% line width less the bar and the pads (livery.sty's \engine@boxes@<box>@bar, @padx, @pady; a box
% without a bar has none), on the fill with the bar at its left; an empty fill, none. \colorbox's one
% \fboxsep is 0: the pads are explicit, the vertical and the horizontal apart. The caution box, the
% lead, the strip and the quote are on it.
\newsavebox\engine@barboxbox
\newdimen\engine@padx \newdimen\engine@pady \newdimen\engine@barw
\def\engine@barboxin{}   % after \noindent: a strip in a card moves out to the card's edge
\def\engine@barboxout{}  % after the box: the strip takes that back, so its line measures \hsize
\def\engine@barboxcolors{}   % in the box: a filled box's \engine@lightbox
% \engine@lightbox: on a dark frame ([enginedark]) a box with a fill of its own (the caution body,
% the lead, a strip outside a card) reads as on a light frame, its text and accents the livery's
% own (the outer theme's \engine@lightcolors), as HTML's and the pptx's; the quote, unfilled, does not
\def\engine@lightbox{\ifengine@darkframe\engine@lightcolors\usebeamercolor[fg]{normal text}\fi}
\def\engine@barbox#1{%
  \par\noindent\engine@barboxin\engine@padx=\csname engine@boxes@#1@padx\endcsname em%
  \engine@pady=\csname engine@boxes@#1@pady\endcsname em%
  \ifcsname engine@boxes@#1@bar\endcsname\engine@barw=\csname engine@boxes@#1@bar\endcsname\paperheight
  \else\engine@barw=\z@\fi
  \edef\engine@outerparskip{\the\parskip}% a minipage zeroes it; the box's paragraphs keep the frame's
  \begin{lrbox}{\engine@barboxbox}\engine@barboxcolors
  \begin{minipage}{\dimexpr\linewidth-\engine@barw-2\engine@padx\relax}\parskip=\engine@outerparskip\relax}
\def\endengine@barbox#1#2{\end{minipage}\end{lrbox}%
  \setbox\engine@barboxbox=\vbox{\vskip\engine@pady
    \hbox{\hskip\engine@padx\usebox\engine@barboxbox\hskip\engine@padx}\vskip\engine@pady}%
  \hbox{{\color{#2}\vrule width \engine@barw}%
    \ifx\relax#1\relax\box\engine@barboxbox
    \else{\setlength\fboxsep{0pt}\colorbox{#1}{\box\engine@barboxbox}}\fi}\engine@barboxout\par}
\newenvironment{enginecaution}{\let\engine@barboxcolors\engine@lightbox\engine@barbox{caution}}{\endengine@barbox{enginecautionfill}{BrandWarning}}

% ---------------------------------------------------------------------------
% lead box: ::: {.lead} before a slide's columns (the Quarto filter writes it), its lines on the
% lead fill with a bar at its left, a pad's gap under it (livery.sty's boxes.lead)
% ---------------------------------------------------------------------------
\newenvironment{enginelead}{\let\engine@barboxcolors\engine@lightbox\engine@barbox{lead}}%
  {\endengine@barbox{EngineBoxesLeadFill}{EngineBoxesLeadBarColor}\vskip\engine@pady}

% ---------------------------------------------------------------------------
% columns: \enginecolshare{<share>}{<n columns>}\linewidth is a column's width, its share of the line
% width less the n - 1 gaps (livery.sty's boxes.columns.gap); the Quarto filter has pandoc write
% \begin{columns}[T,onlytextwidth], whose \hfill between columns is then the gap; enginecolumns
% below is the same for a hand author (a card's and a rail item's width is the same share as a
% length, \engine@sharewidth)
% {.wide}: \begin{enginewide} sets the body \paperwidth less geometry.wide-margin a side
% ---------------------------------------------------------------------------
\newcommand\enginecolshare[2]{\fpeval{#1*(1-(#2-1)*\engine@boxes@columns@gap*\paperwidth/\linewidth)}}
% \enginecolrule, before each column but the first: boxes.columns.rule's width of the paper height,
% centered in the gap beamer's \hfill left before it, the row's height (a \vrule's unset depth runs
% to its box's; its height is the 1ex [T] columns start above their reference point), in the rule
% blend; nothing when the rule is 0. Its kerns add to no width.
\newcommand\enginecolrule{\ifdim\engine@boxes@columns@rule\paperheight>\z@
  \kern-.5\dimexpr\engine@boxes@columns@gap\paperwidth+\engine@boxes@columns@rule\paperheight\relax
  {\color{BrandRule}\vrule width\engine@boxes@columns@rule\paperheight height 1ex}%
  \kern.5\dimexpr\engine@boxes@columns@gap\paperwidth-\engine@boxes@columns@rule\paperheight\relax\fi}
\def\engine@wideout{\dimexpr\engine@geom@margin\paperwidth-\engine@geom@widemargin\paperwidth\relax}
\newenvironment{enginewide}{\par\vskip-\parskip\noindent\hspace*{-\engine@wideout}%   % at the body's top
  \begin{minipage}[t]{\dimexpr\paperwidth-2\dimexpr\engine@geom@widemargin\paperwidth\relax\relax}}%
  {\end{minipage}\hspace*{-\engine@wideout}\par}
% \begin{enginecolumns}{<shares>} \enginecolumn ... \enginecolumn ... \end{enginecolumns}: beamer's
% columns[T,onlytextwidth] with \column per \enginecolumn at its share (\engine@shares: {2} two
% equal, {2,1} weights, {0.55,0.45} shares) and \enginecolrule before each but the first; one
% column too many is an error. The Quarto filter keeps pandoc's columns on the primitives above
% (pandoc's writer scopes a heading's block to its column).
\newcount\engine@ncols
\newenvironment{enginecolumns}[1]{\engine@shares{cols}{#1}\engine@ncols=\z@
  \begin{columns}[T,onlytextwidth]}{\end{columns}}
\newcommand\enginecolumn{%
  \global\advance\engine@ncols\@ne
  \ifnum\engine@ncols>\engine@cols@n\relax\engine@noshare{enginecolumns}{cols}{column}{\engine@ncols}\fi
  \beamer@colclose\def\beamer@colclose{}%   the previous column closed here, so the rule sits in the gap
  \ifnum\engine@ncols>\@ne\enginecolrule\fi
  \column{\enginecolshare{\csname engine@cols@share@\the\engine@ncols\endcsname}{\engine@cols@n}\linewidth}}


% ---------------------------------------------------------------------------
% scale: \begin{enginescale}{S} ... \end{enginescale} sets the body at S times the current size
% (the Quarto filter writes it for scale="S"). Under the engine's font theme every role (tables,
% code, captions, the sub-item levels, list spacing) is a share of \engine@typebody, read when it
% is used, so scaling that scales them all; without it, the sub-item sizes (absolute \small,
% \footnotesize) are scaled by hand, expanded when the group opens (inside it, \f@size is already
% scaled). No autofit here: look at the PDF.
% ---------------------------------------------------------------------------
\def\engine@size#1#2{\noexpand\fontsize{\fpeval{#1*#2*\f@size}pt}{\fpeval{#1*#2*\strip@pt\dimexpr\f@baselineskip\relax}pt}}
\newenvironment{enginescale}[1]{%
  \ifdefined\engine@typebody \engine@typebody=#1\engine@typebody \else
  \edef\engine@sub{\engine@size{#1}{0.9}}\edef\engine@subsub{\engine@size{#1}{0.8}}%
  \setbeamerfont{itemize/enumerate subbody}{size=\engine@sub}%
  \setbeamerfont{itemize/enumerate subsubbody}{size=\engine@subsub}\fi
  \edef\engine@body{\engine@size{#1}{1}}\engine@body\selectfont}{}

% ---------------------------------------------------------------------------
% role=: a card's or strip's role, as HTML and the pptx read it. \engine@rolecolor{<name>}{<default
% role>} sets \engine@rolename to the color: a role or blend of the livery (livery.sty's
% \engine@role@<name>: primary, secondary, accent, table-band, ...), else any defined color (the
% livery's exported palette, a document's own \definecolor), else the default role, with a warning.
% ---------------------------------------------------------------------------
\RequirePackage{pgfkeys}   % (tikz's; the keys of enginecard and enginestrip)
\def\engine@rolecolor#1#2{\engine@rolecolorelse{#1}{\csname engine@role@#2\endcsname}{#2}}
% \engine@rolecolorelse{<name>}{<default color>}{<its word in the warning>}: the same, the default a color
\def\engine@rolecolorelse#1#2#3{%
  \ifcsname engine@role@#1\endcsname
    \edef\engine@rolename{\csname engine@role@#1\endcsname}%
  \else\ifcsname\string\color@#1\endcsname
    \edef\engine@rolename{#1}%
  \else
    \PackageWarning{Engine}{role=#1 is not a role of the livery or a color; #3}%
    \edef\engine@rolename{#2}%
  \fi\fi}
% \engine@nthrole{<k>}: \engine@nthrolename is the k-th of livery.sty's \engine@boxes@card@roles,
% around again past its end (a card's default role, by its place in the row)
\newcount\engine@tmpcnt
\def\engine@nthrole#1{%
  \engine@tmpcnt=\z@
  \@for\engine@tmpb:=\engine@boxes@card@roles\do{\advance\engine@tmpcnt\@ne}%
  \@tempcnta=#1\relax \advance\@tempcnta\m@ne
  \@tempcntb=\@tempcnta \divide\@tempcntb\engine@tmpcnt \multiply\@tempcntb\engine@tmpcnt
  \advance\@tempcnta-\@tempcntb   % (k - 1) mod n
  \engine@tmpcnt=\z@
  \@for\engine@tmpb:=\engine@boxes@card@roles\do{%
    \ifnum\engine@tmpcnt=\@tempcnta\edef\engine@nthrolename{\engine@tmpb}\fi\advance\engine@tmpcnt\@ne}}

% ---------------------------------------------------------------------------
% shares: \engine@shares{<set>}{<spec>} reads a row's argument (enginecards', enginecolumns'): a
% lone integer n is n equal shares; a comma list is weights, kept as shares of the row when they
% add to 1 or less, else divided by their sum (engine-common.lua's column_shares() rule, so the
% Quarto filter's shares, written to 4 places, round-trip). \engine@<set>@n, and
% \engine@<set>@share@<k> for k from 1, globally: the row's members read them from their own groups.
% ---------------------------------------------------------------------------
\newcount\engine@sharecnt \newif\ifengine@equalshares
\def\engine@shares#1#2{%
  \engine@sharecnt=\z@ \def\engine@sharesum{0}%
  \@for\engine@tmpa:=#2\do{\advance\engine@sharecnt\@ne
    \edef\engine@sharesum{\fpeval{\engine@sharesum+(\engine@tmpa)}}}%
  \engine@equalsharesfalse
  \ifnum\engine@sharecnt=\@ne
    \ifnum\fpeval{(\engine@sharesum > 1) && (\engine@sharesum == trunc(\engine@sharesum))}=1 \engine@equalsharestrue\fi
  \fi
  \ifengine@equalshares
    \engine@sharecnt=\fpeval{trunc(\engine@sharesum)}\relax
    \expandafter\xdef\csname engine@#1@n\endcsname{\the\engine@sharecnt}%
    \@tempcnta=\z@
    \loop\advance\@tempcnta\@ne
      \expandafter\xdef\csname engine@#1@share@\the\@tempcnta\endcsname{\fpeval{1/\engine@sharecnt}}%
    \ifnum\@tempcnta<\engine@sharecnt\repeat
  \else
    \expandafter\xdef\csname engine@#1@n\endcsname{\the\engine@sharecnt}%
    \ifnum\fpeval{\engine@sharesum > 1}=1 \let\engine@sharediv\engine@sharesum \else\def\engine@sharediv{1}\fi
    \engine@sharecnt=\z@
    \@for\engine@tmpa:=#2\do{\advance\engine@sharecnt\@ne
      \expandafter\xdef\csname engine@#1@share@\the\engine@sharecnt\endcsname{\fpeval{(\engine@tmpa)/\engine@sharediv}}}%
  \fi}
% \engine@sharewidth{<share>}{<n>}: a row member's width, its share of the line less the n - 1 gaps
% (boxes.columns.gap; \enginecolshare is the same as a factor of \linewidth, for beamer's \column)
\def\engine@sharewidth#1#2{\dimexpr#1\dimexpr\linewidth-\engine@boxes@columns@gap\paperwidth*(#2-1)\relax\relax}
% \engine@noshare{<environment>}{<set>}{<member>}{<its count>}: the error for a member past the
% row's shares (the k-th of a row opened for \engine@<set>@n)
\def\engine@noshare#1#2#3#4{%
  \PackageError{Engine}{#1{\csname engine@#2@n\endcsname}: #3 \the#4\space has no share}%
    {The row was opened for \csname engine@#2@n\endcsname\space #3s: give \string\begin{#1} the number of #3s, or a weight per #3.}}

% ---------------------------------------------------------------------------
% strip: \begin{enginestrip}[role=<role>] ... \end{enginestrip}, in a card or on its own (the Quarto
% filter writes it for ::: {.strip role=}): a band the strip tint of its role (default accent) over
% the background, no bar; in a card as wide as the card (its pads taken back), on a solid card the
% role itself
% ---------------------------------------------------------------------------
\pgfkeys{/engine/strip/.cd, role/.store in=\engine@striprole}
\newif\ifengine@incard \newif\ifengine@solidcard
\newenvironment{enginestrip}[1][]{%
  \def\engine@striprole{}\pgfkeys{/engine/strip/.cd,#1}%
  \ifx\engine@striprole\@empty\edef\engine@rolename{\csname engine@role@accent\endcsname}%
  \else\engine@rolecolor{\engine@striprole}{accent}\fi
  \ifengine@solidcard\colorlet{engine@strip}{\engine@rolename}\color{BrandPrimaryText}%
  \else\colorlet{engine@strip}{\engine@rolename!\fpeval{round(100*\engine@boxes@strip@tint)}!BrandBackground}\fi
  \ifengine@incard
    \advance\linewidth by 2\dimexpr\engine@boxes@card@padx em\relax
    \edef\engine@barboxin{\noexpand\hspace*{-\the\dimexpr\engine@boxes@card@padx em\relax}}%
    \edef\engine@barboxout{\kern-\the\dimexpr\engine@boxes@card@padx em\relax}%   (a kern: \par drops a trailing glue)
  \fi
  % boxes.strip.gap above and below it, em of the body (the scss's margin, grid.py's room)
  \par\vskip\engine@boxes@strip@gap em
  \ifengine@incard\else\let\engine@barboxcolors\engine@lightbox\fi   % in a card, the card's colors
  \engine@barbox{strip}}%
  {\endengine@barbox{engine@strip}{engine@strip}\vskip\engine@boxes@strip@gap em}

% ---------------------------------------------------------------------------
% quote: \begin{enginequote}[role=<role>]{<attribution>} ... \end{enginequote} (the Quarto filter
% writes it for ::: {.quote} and a bare `>`): its lines in the `engine quote` font (the quote size,
% boxes.quote.family and style) with a bar at its left in
% the role (default the box's bar-color, livery.sty's boxes.quote), no fill, padded by its pads; the
% attribution, when not {}, under them at the caption size, muted, after "— ". In a card or a
% column too, as wide as its line.
% ---------------------------------------------------------------------------
\pgfkeys{/engine/quote/.cd, role/.store in=\engine@quoterole}
\newenvironment{enginequote}[2][]{%
  \def\engine@quoterole{}\pgfkeys{/engine/quote/.cd,#1}%
  \ifx\engine@quoterole\@empty\def\engine@rolename{EngineBoxesQuoteBarColor}%
  \else\engine@rolecolorelse{\engine@quoterole}{EngineBoxesQuoteBarColor}{the quote bar's color}\fi
  \colorlet{engine@quotebar}{\engine@rolename}%
  \def\engine@quotewho{#2}%
  \engine@barbox{quote}\usebeamerfont{engine quote}}%
  {\ifx\engine@quotewho\@empty\else   % the attribution in the body's face, upright, boxes.quote.attribution-gap (em of the caption) under the lines
     \par{\normalfont\usebeamerfont{caption}\vskip\engine@boxes@quote@attributiongap em\color{BrandMuted}— \engine@quotewho\par}\fi
   \endengine@barbox{}{engine@quotebar}\vskip\engine@pady}

% ---------------------------------------------------------------------------
% cards: a row \begin{enginecards}{<shares>} of \begin{enginecard}[<keys>]{<title>}{<sub>} ...
% \end{enginecard} (the Quarto filter writes them for ::: {.column .card}). The row's argument is
% the number of equal cards ({3}) or a weight per card ({2,1,1}; shares of the row when they add
% to 1 or less, \engine@shares); a card beyond them is an error. The keys: role=<role> (the head
% band's color: a role, a blend or a defined color, \engine@rolecolor; default the card's place in
% boxes.card.roles), pick (the outline, in outline-color) or pick=<overlay> (the outline on those
% steps only, its width reserved on every step so the body does not move: \alt at \begin, which
% beamer runs once per step; a spec with a comma in braces, pick={<1,3>}, since pgfkeys splits the
% list at commas), solid (all the role's, its text in primary-text) and plain (a column
% beside cards: no fill, no band). {} for no sub-line. Each body is set first into a box (as the
% feature panel's: verbatim works), its width the card's share of the line less the gaps, its
% pads and outline; the row then draws every card as a tcolorbox one height, the tallest body and
% head (one run, no aux; each head its own text's height, as HTML's and the pptx's): a head band
% in the role (the title in the block title font, bold, its sub in the body's) over the body on
% the card fill, rounded by boxes.card.radius. \enginelabel and \enginebig are a card's small-caps
% label and big number.
% ---------------------------------------------------------------------------
\RequirePackage{tcolorbox}\tcbuselibrary{skins,breakable}   % breakable: Quarto's callouts, which load it after this
\newif\ifengine@cardpick \newif\ifengine@cardpicked \newif\ifengine@cardsolid \newif\ifengine@cardplain
\pgfkeys{/engine/card/.cd,
  role/.store in=\engine@cardrole,
  pick/.code={\engine@cardpicktrue\def\engine@tmpa{#1}\ifx\engine@tmpa\@empty\engine@cardpickedtrue
    \else\alt#1{\engine@cardpickedtrue}{\engine@cardpickedfalse}\fi},
  pick/.default=,
  solid/.is if=engine@cardsolid,
  plain/.is if=engine@cardplain}
\newcount\engine@ncards
\newdimen\engine@cardbody \newdimen\engine@cardhead \newdimen\engine@cardw \newdimen\engine@cardrule
\newbox\engine@cardboxi \newbox\engine@cardboxii \newbox\engine@cardboxiii
\newbox\engine@cardboxiv \newbox\engine@cardboxv \newbox\engine@cardboxvi
\def\engine@cardbox#1{\csname engine@cardbox\romannumeral#1\endcsname}
\def\engine@labelcolor{EngineLightBrandMuted}\def\engine@bigcolor{EngineLightBrandPrimaryContrast}   % a dark frame's card keeps them (the outer theme's snapshots)
% (each its own paragraph, opened by \par so a text line before it needs no blank line, and ended
% inside the font's group: the line takes the font's leading)
\newcommand\enginelabel[1]{\par{\usebeamerfont{eyebrow}\color{\engine@labelcolor}\engine@tracking\MakeUppercase{#1}\par}}
\newcommand\enginebig[1]{\par{\usebeamerfont{display}\color{\engine@bigcolor}#1\par}}
\newenvironment{enginecards}[1]{\par\engine@shares{cards}{#1}%
  \global\engine@ncards=\z@ \global\engine@cardbody=\z@ \global\engine@cardhead=\z@}%
  {\engine@drawcards\par}
% \engine@tallest{<box>}{<dimen>}: the dimen raised, globally, to the box's height and depth (a
% row's tallest body, head or date)
\def\engine@tallest#1#2{\ifdim\dimexpr\ht#1+\dp#1\relax>#2
  \global#2=\dimexpr\ht#1+\dp#1\relax\fi}
% \engine@cellbox{<k>}{<width>} ... \endengine@cellbox{<k>}{<dimen>}: a card's or a rail item's body
% set into the k-th save box (\engine@cardbox{k}) at that width, its lines close, as the pptx's
% (grid.py CARD_GAP; HTML uses reveal's block margin); the end keeps the row's tallest in the dimen
\def\engine@cellbox#1#2{%
  \edef\engine@outerparskip{\the\parskip}%
  \global\setbox\engine@cardbox{#1}=\vbox\bgroup
    \engine@hsize{#2}\parskip=\engine@outerparskip\relax\parskip=.25\parskip}
\def\endengine@cellbox#1#2{\par\egroup\engine@tallest{\engine@cardbox{#1}}{#2}}
\newcommand\enginecard[3][]{%
  \global\advance\engine@ncards\@ne
  \ifnum\engine@ncards>\engine@cards@n\relax\engine@noshare{enginecards}{cards}{card}{\engine@ncards}\fi
  \engine@cardpickfalse\engine@cardpickedfalse\engine@cardsolidfalse\engine@cardplainfalse\def\engine@cardrole{}%
  \pgfkeys{/engine/card/.cd,#1}%
  \engine@nthrole{\the\engine@ncards}%
  \ifx\engine@cardrole\@empty\edef\engine@rolename{\csname engine@role@\engine@nthrolename\endcsname}%
  \else\engine@rolecolor{\engine@cardrole}{\engine@nthrolename}\fi
  \expandafter\xdef\csname engine@card@opts@\the\engine@ncards\endcsname{%
    \ifengine@cardpicked pick,\fi\ifengine@cardsolid solid,\fi\ifengine@cardplain plain,\fi}%
  \expandafter\xdef\csname engine@card@role@\the\engine@ncards\endcsname{\engine@rolename}%
  \expandafter\gdef\csname engine@card@title@\the\engine@ncards\endcsname{#2}%
  \expandafter\gdef\csname engine@card@sub@\the\engine@ncards\endcsname{#3}%
  \engine@cardw=\engine@sharewidth{\csname engine@cards@share@\the\engine@ncards\endcsname}{\engine@cards@n}%
  \expandafter\xdef\csname engine@card@w@\the\engine@ncards\endcsname{\the\engine@cardw}%
  \engine@cardrule=\z@   % the frame: a pick's outline, else every card's hairline (boxes.card.border; none when solid)
  \ifengine@cardpick\engine@cardrule=\engine@boxes@card@outline\paperheight
  \else\ifengine@cardsolid\else\ifengine@cardplain\else\engine@cardrule=\engine@boxes@card@border\paperheight\fi\fi\fi
  \expandafter\xdef\csname engine@card@rule@\the\engine@ncards\endcsname{\the\engine@cardrule}%
  \def\engine@tmpa{#2#3}\ifx\engine@tmpa\@empty\else   % the head's height, the row's tallest
    \setbox\@tempboxa=\vbox{\hsize=\dimexpr\engine@cardw-2\engine@cardrule-2\dimexpr\engine@boxes@card@headpadx em\relax\relax
      \raggedright{\usebeamerfont{block title}\bfseries\strut#2\par}%
      \def\engine@tmpa{#3}\ifx\engine@tmpa\@empty\else{\normalsize\mdseries\strut#3\par}\fi}%
    \engine@tallest{\@tempboxa}{\engine@cardhead}%
  \fi
  \engine@cellbox{\engine@ncards}{\dimexpr\engine@cardw-2\engine@cardrule-2\dimexpr\engine@boxes@card@padx em\relax\relax}%
    \engine@incardtrue\ifengine@cardsolid\engine@solidcardtrue\else\engine@solidcardfalse\fi
    \raggedright\usebeamerfont{normal text}%
    % on a solid card the text is the tcolorbox's coltext (no \color here: its whatsit would put
    % \parskip over the first paragraph, which an empty list does not get)
    \ifengine@cardsolid\setbeamercolor{normal text}{fg=BrandPrimaryText}%
      \def\engine@labelcolor{BrandPrimaryText}\def\engine@bigcolor{BrandPrimaryText}\fi}
\def\endenginecard{\endengine@cellbox{\engine@ncards}{\engine@cardbody}}
% the row: each card a tcolorbox, the gap between them; its height the tallest body and head
\def\engine@drawcards{\hbox{\@tempcnta=\z@   % a box in the vertical list: no paragraph, no \parskip
  \loop\advance\@tempcnta\@ne
    \ifnum\@tempcnta>\@ne\hskip\engine@boxes@columns@gap\paperwidth\fi
    \engine@drawcard{\the\@tempcnta}%
  \ifnum\@tempcnta<\engine@ncards\repeat}}
\def\engine@add#1{\expandafter\def\expandafter\engine@ckeys\expandafter{\engine@ckeys,#1}}
\def\engine@cardtitle{\raggedright\strut\engine@ctitle\par
  \ifx\engine@csub\@empty\else{\normalsize\mdseries\strut\engine@csub\par}\fi}
\def\engine@begincard#1{\begin{tcolorbox}[enhanced,nobeforeafter,box align=top,valign=top,boxsep=0pt,
  before skip=0pt,after skip=0pt,coltitle=BrandPrimaryText,fonttitle=\usebeamerfont{block title}\bfseries#1]}
% \engine@hasopt{<word>}: \ifin@ for the card's options (\in@ does not expand its arguments)
\def\engine@hasopt#1{\edef\engine@tmpc{\noexpand\in@{#1}{\engine@copts}}\engine@tmpc}
\def\engine@drawcard#1{%
  \edef\engine@copts{\csname engine@card@opts@#1\endcsname}%
  \edef\engine@crole{\csname engine@card@role@#1\endcsname}%
  \expandafter\let\expandafter\engine@ctitle\csname engine@card@title@#1\endcsname
  \expandafter\let\expandafter\engine@csub\csname engine@card@sub@#1\endcsname
  \edef\engine@ckeys{,width=\csname engine@card@w@#1\endcsname,
    height=\the\dimexpr\engine@cardbody+\engine@cardhead
      +2\dimexpr\engine@boxes@card@pady em\relax+2\dimexpr\engine@boxes@card@headpady em\relax
      +2\dimexpr\csname engine@card@rule@#1\endcsname\relax\relax,
    boxrule=\csname engine@card@rule@#1\endcsname,
    left=\the\dimexpr\engine@boxes@card@padx em\relax,right=\the\dimexpr\engine@boxes@card@padx em\relax,
    top=\the\dimexpr\engine@boxes@card@pady em\relax,bottom=\the\dimexpr\engine@boxes@card@pady em\relax,
    lefttitle=\the\dimexpr\engine@boxes@card@headpadx em\relax,righttitle=\the\dimexpr\engine@boxes@card@headpadx em\relax,
    toptitle=\the\dimexpr\engine@boxes@card@headpady em\relax,bottomtitle=\the\dimexpr\engine@boxes@card@headpady em\relax,
    colbacktitle=\engine@crole,
    \ifdim\engine@boxes@card@radius\paperheight=\z@ sharp corners\else arc=\the\dimexpr\engine@boxes@card@radius\paperheight\relax\fi}%
  % coltext: tcolorbox's default is black, which a dark livery's card fill hides (lists and strips
  % color their own text; a paragraph took the default)
  \engine@hasopt{plain}%
  \ifin@\engine@add{opacityback=0,opacityframe=0,coltext=BrandText}%
  \else
    \engine@hasopt{solid}%
    \ifin@\edef\engine@tmpb{colback=\engine@crole,coltext=BrandPrimaryText,colframe=\engine@crole}%
    \else\def\engine@tmpb{colback=EngineBoxesCardFill,colframe=EngineBoxesCardBorderColor,coltext=BrandText}\fi
    \expandafter\engine@add\expandafter{\engine@tmpb}%
    \ifx\engine@ctitle\@empty\else\engine@add{title={\engine@cardtitle}}\fi
  \fi
  \engine@hasopt{pick}\ifin@\engine@add{colframe=EngineBoxesCardOutlineColor}%
  \else\ifdim\csname engine@card@rule@#1\endcsname>\engine@boxes@card@border\paperheight   % a pick on other steps: its frame
    \engine@hasopt{solid}\ifin@\else   % reserved, the fill's, and the hairline at its edge
      \engine@add{colframe=EngineBoxesCardFill,borderline={\the\dimexpr\engine@boxes@card@border\paperheight\relax}{0pt}{EngineBoxesCardBorderColor}}\fi
  \fi\fi
  \expandafter\engine@begincard\expandafter{\engine@ckeys}\box\engine@cardbox{#1}\end{tcolorbox}}

% ---------------------------------------------------------------------------
% steps and timelines, the rail: \begin{enginesteps}[role=<role>,start=<k>]{<n>} of n
% \begin{enginestep}{<title>} ... \end{enginestep}, and \begin{enginetimeline}[role=<role>]{<n>} of
% n \enginemilestone[done]{<date>}{<label>} (the Quarto filter writes them for ::: {.steps} and
% ::: {.timeline}). The items share the row equally (\engine@shares: {n}), the livery's column gap
% between them; an item beyond n is an error, and six is the most (the cards' save boxes): a longer
% process goes on over a second frame, start=7 numbering its badges from 7. role=
% colors the badges and dots (a role, a blend or a defined color, \engine@rolecolor; default
% primary-contrast, the primary that reads on the background). Each item's text is set first into
% a box, at its width less boxes.rail.pad (a step's title in the block title font, bold, over its
% text; overlays work, as in a card), and \end draws the row as one tikzpicture: a rail of
% boxes.rail.line in its color (EngineBoxesRailLineColor) through the marks' middle, from the
% first mark to the row's right edge; a step's badge (badge of the paper's height, the role's, its
% number knocked out in the background color) or a milestone's dot (dot of the height, the role's
% with [done], else the background in a ring of the role) at the text's left; a milestone's date
% (the block title font, bold) above its dot; the texts under the marks, the
% row's cells one height, on boxes.rail.fill when the livery sets one (EngineBoxesRailFill).
% ---------------------------------------------------------------------------
\pgfkeys{/engine/rail/.cd, role/.store in=\engine@railrole, start/.store in=\engine@railstart}
\newif\ifengine@milestonedone
\pgfkeys{/engine/milestone/.cd, done/.is if=engine@milestonedone}
\newcount\engine@nrail \newcount\engine@railk
\newdimen\engine@railbody \newdimen\engine@raildate \newdimen\engine@railw \newdimen\engine@railmark
\newdimen\engine@railtop \newdimen\engine@railcell \newdimen\engine@railx \newdimen\engine@railpx \newdimen\engine@railpy
\newdimen\engine@railline
\def\engine@railsteps{steps}
\def\engine@railbegin#1#2#3{\par\engine@shares{rail}{#3}\def\engine@railkind{#1}%
  \ifnum\engine@rail@n>6
    \PackageError{Engine}{engine#1{\engine@rail@n}: more than six items}%
      {A row of steps or milestones holds at most six: split it over two slides (start=7 numbers the second's badges on).}%
  \fi
  \def\engine@railrole{}\def\engine@railstart{1}\pgfkeys{/engine/rail/.cd,#2}%
  \ifx\engine@railrole\@empty\edef\engine@rolename{\csname engine@role@\engine@boxes@rail@role\endcsname}%
  \else\engine@rolecolor{\engine@railrole}{\engine@boxes@rail@role}\fi
  \let\engine@railcolor\engine@rolename
  \global\engine@nrail=\z@ \global\engine@railbody=\z@ \global\engine@raildate=\z@}
\newenvironment{enginesteps}[2][]{\engine@railbegin{steps}{#1}{#2}}{\engine@drawrail\par}
\newenvironment{enginetimeline}[2][]{\engine@railbegin{timeline}{#1}{#2}}{\engine@drawrail\par}
% an item: its number, its width (its share of the line less the gaps) and its title, globally
\def\engine@railitem#1{%
  \global\advance\engine@nrail\@ne
  \ifnum\engine@nrail>\engine@rail@n\relax\engine@noshare{engine\engine@railkind}{rail}{item}{\engine@nrail}\fi
  \engine@railw=\engine@sharewidth{\csname engine@rail@share@\the\engine@nrail\endcsname}{\engine@rail@n}%
  \expandafter\xdef\csname engine@rail@w@\the\engine@nrail\endcsname{\the\engine@railw}%
  \expandafter\gdef\csname engine@rail@title@\the\engine@nrail\endcsname{#1}}
\def\engine@railtitle#1{{\usebeamerfont{block title}\bfseries\strut#1\par}}
% the item's text into its box (a card's: \engine@cellbox, \engine@cardbox{k}), less the rail's pads
\def\engine@railbox{\engine@cellbox{\engine@nrail}{\dimexpr\engine@railw-2\dimexpr\engine@boxes@rail@padx em\relax\relax}%
    \raggedright\usebeamerfont{normal text}}
\def\engine@railboxend{\endengine@cellbox{\engine@nrail}{\engine@railbody}}
\newenvironment{enginestep}[1]{\engine@railitem{#1}\engine@railbox
  \def\engine@tmpa{#1}\ifx\engine@tmpa\@empty\else\engine@railtitle{#1}\fi}{\engine@railboxend}
\newcommand\enginemilestone[3][]{\engine@railitem{#2}%
  \engine@milestonedonefalse\pgfkeys{/engine/milestone/.cd,#1}%
  \expandafter\xdef\csname engine@rail@done@\the\engine@nrail\endcsname{\ifengine@milestonedone 1\else 0\fi}%
  \setbox\@tempboxa=\vbox{\hsize=\dimexpr\engine@railw-2\dimexpr\engine@boxes@rail@padx em\relax\relax
    \raggedright\engine@railtitle{#2}}%   the date row: the tallest date
  \engine@tallest{\@tempboxa}{\engine@raildate}%
  \engine@railbox#3\engine@railboxend}
% \engine@pt{<x>}{<y>}: a tikz point from two dimen expressions, in the rail's and the gallery's
% pictures ([x=1pt,y=1pt], (0,0) the top left, y up)
\def\engine@pt#1#2{(\the\dimexpr#1\relax,\the\dimexpr#2\relax)}
% the row: one tikzpicture, (0,0) its top left, y up; the marks' row at -\engine@railtop (a
% timeline's dates above it, a pad between), the cells under it
\def\engine@drawrail{%
  \engine@railpx=\engine@boxes@rail@padx em\relax \engine@railpy=\engine@boxes@rail@pady em\relax
  \engine@railline=\engine@boxes@rail@line\paperheight
  \ifx\engine@railkind\engine@railsteps
    \engine@railmark=\engine@boxes@rail@badge\paperheight \engine@railtop=\z@
  \else
    \engine@railmark=\engine@boxes@rail@dot\paperheight \engine@railtop=\dimexpr\engine@raildate+\engine@railpy\relax
  \fi
  \engine@railcell=\dimexpr\engine@railbody+2\engine@railpy\relax
  \def\engine@railmid{-\engine@railtop-.5\engine@railmark}%
  \hbox{\begin{tikzpicture}[x=1pt,y=1pt]
    \useasboundingbox \engine@pt{0pt}{0pt} rectangle
      \engine@pt{\linewidth}{-\engine@railtop-\engine@railmark-\engine@railcell};
    \fill[EngineBoxesRailLineColor]
      \engine@pt{\engine@railpx+.5\engine@railmark}{\engine@railmid+.5\engine@railline}
      rectangle \engine@pt{\linewidth}{\engine@railmid-.5\engine@railline};
    \engine@railx=\z@ \engine@railk=\z@
    \loop\advance\engine@railk\@ne
      \engine@railw=\csname engine@rail@w@\the\engine@railk\endcsname\relax
      \ifcsname\string\color@EngineBoxesRailFill\endcsname
        \fill[EngineBoxesRailFill] \engine@pt{\engine@railx}{-\engine@railtop-\engine@railmark}
          rectangle \engine@pt{\engine@railx+\engine@railw}{-\engine@railtop-\engine@railmark-\engine@railcell};
      \fi
      \ifx\engine@railkind\engine@railsteps
        \node[circle, fill=\engine@railcolor, text=BrandBackground, minimum size=\the\engine@railmark, inner sep=0pt,
          font=\usebeamerfont{block title}\bfseries]
          at \engine@pt{\engine@railx+\engine@railpx+.5\engine@railmark}{\engine@railmid} {\the\numexpr\engine@railk+\engine@railstart-1\relax};
      \else
        \ifnum\csname engine@rail@done@\the\engine@railk\endcsname=\@ne
          \fill[\engine@railcolor] \engine@pt{\engine@railx+\engine@railpx+.5\engine@railmark}{\engine@railmid}
            circle[radius=\the\dimexpr.5\engine@railmark\relax];
        \else
          \fill[BrandBackground] \engine@pt{\engine@railx+\engine@railpx+.5\engine@railmark}{\engine@railmid}
            circle[radius=\the\dimexpr.5\engine@railmark\relax];
          \draw[\engine@railcolor, line width=\the\dimexpr\engine@boxes@rail@ring\engine@railmark\relax]
            \engine@pt{\engine@railx+\engine@railpx+.5\engine@railmark}{\engine@railmid}
            circle[radius=\the\dimexpr(\engine@railmark-\engine@boxes@rail@ring\engine@railmark)/2\relax];
        \fi
        \node[anchor=south west, inner sep=0pt] at \engine@pt{\engine@railx+\engine@railpx}{-\engine@raildate}
          {\vbox{\hsize=\dimexpr\engine@railw-2\engine@railpx\relax\raggedright
            \engine@railtitle{\csname engine@rail@title@\the\engine@railk\endcsname}}};
      \fi
      \node[anchor=north west, inner sep=0pt]
        at \engine@pt{\engine@railx+\engine@railpx}{-\engine@railtop-\engine@railmark-\engine@railpy}
        {\box\engine@cardbox{\engine@railk}};
      \advance\engine@railx by \dimexpr\engine@railw+\engine@boxes@columns@gap\paperwidth\relax
    \ifnum\engine@railk<\engine@nrail\repeat
  \end{tikzpicture}}}

% ---------------------------------------------------------------------------
% image galleries: \begin{enginegallery}[cols=<c>,rows=<r>,fit=contain|cover,height=<share>] of
% \engineimage[<caption>]{<file>} (the Quarto filter writes it for ::: {.gallery}): the images in
% equal cells, row-major, boxes.gallery.gap apart both ways (of the paper's width), each picture in
% its cell less boxes.gallery.pad, whole (contain, the default) or cropped to fill it (cover), a
% caption under it in the caption size, muted, centered; when any image has a caption every cell
% keeps the caption line, so a row lines up. cols defaults to ceil(sqrt(n)), rows to ceil(n/cols)
% (rows alone: cols ceil(n/rows)); more than twelve images, or more than cols x rows, is an error.
% The gallery is height= of the body box's height (\engine@geom@bodyheight; default 1, the whole
% box), at most the frame's room under its title (\engine@bodyroom): TeX cannot measure what stands
% above it in the frame, so give height= under text. A cell of
% boxes.gallery.fill (EngineBoxesGalleryFill) sits behind each when the livery sets one. In a
% [enginefull] frame (the bare key) the environment only stores the images: the background
% template, drawn after the body, fills the paper less geometry.full's pads with them.
% ---------------------------------------------------------------------------
\pgfkeys{/engine/gallery/.cd, cols/.store in=\engine@galcolsk, rows/.store in=\engine@galrowsk,
  fit/.store in=\engine@galfit, height/.store in=\engine@galheight}
\newcount\engine@galn \newcount\engine@galk \newcount\engine@galcol \newcount\engine@galrow
\newcount\engine@galcols \newcount\engine@galrows
\newdimen\engine@galx \newdimen\engine@galy \newdimen\engine@galw \newdimen\engine@galh \newdimen\engine@galgap
\newdimen\engine@galcw \newdimen\engine@galch \newdimen\engine@galpx \newdimen\engine@galpy \newdimen\engine@galcap
\newdimen\engine@galpw \newdimen\engine@galph \newdimen\engine@galcx \newdimen\engine@galcy
\newif\ifengine@galcap
\def\engine@galcover{cover}\def\engine@galfull{full}\def\engine@galfitg{contain}
\newcommand\engineimage[2][]{%
  \global\advance\engine@galn\@ne
  \ifnum\engine@galn>12
    \PackageError{Engine}{enginegallery: more than twelve images}%
      {A gallery holds at most twelve images: split it over two slides.}%
  \fi
  \expandafter\gdef\csname engine@gal@src@\the\engine@galn\endcsname{#2}%
  \expandafter\gdef\csname engine@gal@cap@\the\engine@galn\endcsname{#1}%
  \def\engine@tmpa{#1}\ifx\engine@tmpa\@empty\else\global\engine@galcaptrue\fi
  \ignorespaces}
\newenvironment{enginegallery}[1][]{\par
  \def\engine@galcolsk{0}\def\engine@galrowsk{0}\def\engine@galfit{contain}\def\engine@galheight{1}%
  \pgfkeys{/engine/gallery/.cd,#1}%
  \global\engine@galn=\z@ \global\engine@galcapfalse\ignorespaces}%
 {\engine@galgrid
  \ifx\engine@framestyle\engine@galfull\else   % a full frame's background draws it
    \engine@galh=\engine@galheight\dimexpr\engine@geom@bodyheight\paperheight\relax
    \ifdim\engine@galh>\engine@bodyroom \engine@galh=\engine@bodyroom \fi
    \noindent\hbox{\begin{tikzpicture}[x=1pt,y=1pt]
      \useasboundingbox \engine@pt{0pt}{0pt} rectangle \engine@pt{\linewidth}{-\engine@galh};
      \engine@gallerycells{0pt}{0pt}{\linewidth}{\engine@galh}%
    \end{tikzpicture}}\par
  \fi}
% the frame's room under a title in the theme's band (the outer theme's \engine@frametitle ends it at
% the body's top, the livery's frametitle.body), less beamer's 0.25em under the title box and the
% \lineskip TeX puts above a line as tall as a gallery (enginewide's minipage is one):
% \beamer@frametextheight, which beamer sets only after the body (a fragile frame's reads 0)
\def\engine@bodyroom{\dimexpr\textheight-\engine@ft@bodytop\paperheight-0.25em-\lineskip\relax}
% the grid, globally (a full frame's background reads it after the body): cols and rows derived
\def\engine@galgrid{%
  \ifnum\engine@galn=\z@
    \PackageError{Engine}{enginegallery: no \string\engineimage}{A gallery holds one to twelve \string\engineimage.}%
  \fi
  \global\engine@galcols=\engine@galcolsk\relax \global\engine@galrows=\engine@galrowsk\relax
  \ifnum\engine@galcols<\@ne
    \ifnum\engine@galrows<\@ne \global\engine@galcols=\fpeval{ceil(sqrt(\the\engine@galn))}\relax
    \else \global\engine@galcols=\fpeval{ceil(\the\engine@galn/\the\engine@galrows)}\relax \fi
  \fi
  \ifnum\engine@galrows<\@ne \global\engine@galrows=\fpeval{ceil(\the\engine@galn/\the\engine@galcols)}\relax\fi
  \ifnum\engine@galn>\numexpr\engine@galcols*\engine@galrows\relax
    \PackageError{Engine}{enginegallery: \the\engine@galn\space images do not fit cols=\the\engine@galcols, rows=\the\engine@galrows}%
      {Give more cols or rows, or fewer images.}%
  \fi
  \xdef\engine@galfitg{\engine@galfit}}
% \engine@gallerycells{<x>}{<y>}{<w>}{<h>}: the stored images in that box (tikz commands; (x, y) its
% top left, y up, \engine@pt's points), the pads in em of the body type
\def\engine@gallerycells#1#2#3#4{%
  \begingroup\usebeamerfont{normal text}%
  \engine@galx=\dimexpr#1\relax \engine@galy=\dimexpr#2\relax \engine@galw=\dimexpr#3\relax \engine@galh=\dimexpr#4\relax
  \engine@galgap=\engine@boxes@gallery@gap\paperwidth
  \engine@galpx=\engine@boxes@gallery@padx em\relax \engine@galpy=\engine@boxes@gallery@pady em\relax
  \engine@galcw=\dimexpr(\engine@galw-\engine@galgap*(\engine@galcols-1))/\engine@galcols\relax
  \engine@galch=\dimexpr(\engine@galh-\engine@galgap*(\engine@galrows-1))/\engine@galrows\relax
  \engine@galcap=\z@
  \ifengine@galcap   % the caption line: a strut of the caption size and its gap under the picture
    \setbox\@tempboxa\hbox{\engine@fs{caption}\selectfont\strut}%
    \engine@galcap=\dimexpr\ht\@tempboxa+\dp\@tempboxa+\engine@galpy\relax
  \fi
  \engine@galpw=\dimexpr\engine@galcw-2\engine@galpx\relax
  \engine@galph=\dimexpr\engine@galch-2\engine@galpy-\engine@galcap\relax
  \engine@galk=\z@ \engine@galcol=\z@ \engine@galrow=\z@
  \loop\advance\engine@galk\@ne
    \engine@galcx=\dimexpr\engine@galx+(\engine@galcw+\engine@galgap)*\engine@galcol\relax
    \engine@galcy=\dimexpr\engine@galy-(\engine@galch+\engine@galgap)*\engine@galrow\relax
    \ifcsname\string\color@EngineBoxesGalleryFill\endcsname
      \fill[EngineBoxesGalleryFill] \engine@pt{\engine@galcx}{\engine@galcy}
        rectangle \engine@pt{\engine@galcx+\engine@galcw}{\engine@galcy-\engine@galch};
    \fi
    \expandafter\engine@galpicture\expandafter{\csname engine@gal@src@\the\engine@galk\endcsname}%
    \ifengine@galcap
      \node[anchor=north, inner sep=0pt, text width=\the\engine@galpw, align=center,
        font={\engine@fs{caption}\selectfont}, text=BrandMuted]
        at \engine@pt{\engine@galcx+\engine@galpx+.5\engine@galpw}{\engine@galcy-2\engine@galpy-\engine@galph}
        {\strut\csname engine@gal@cap@\the\engine@galk\endcsname};
    \fi
    \advance\engine@galcol\@ne
    \ifnum\engine@galcol=\engine@galcols \engine@galcol=\z@ \advance\engine@galrow\@ne \fi
  \ifnum\engine@galk<\engine@galn\repeat
  \endgroup}
% one picture in its box: contain, scaled to fit it whole; cover, scaled to fill it (by its height when
% it is wider than the box, else its width) and clipped to it
\def\engine@galpicture#1{%
  \ifx\engine@galfitg\engine@galcover
    \setbox\@tempboxa\hbox{\includegraphics{#1}}\dimen@=\wd\@tempboxa \dimen@ii=\ht\@tempboxa
    \ifnum\fpeval{\strip@pt\dimen@ * \strip@pt\engine@galph > \strip@pt\dimen@ii * \strip@pt\engine@galpw}=\@ne
      \edef\engine@galopt{height=\the\engine@galph}\else\edef\engine@galopt{width=\the\engine@galpw}\fi
    \begin{scope}
      \clip \engine@pt{\engine@galcx+\engine@galpx}{\engine@galcy-\engine@galpy}
        rectangle \engine@pt{\engine@galcx+\engine@galpx+\engine@galpw}{\engine@galcy-\engine@galpy-\engine@galph};
      \node[anchor=center, inner sep=0pt]
        at \engine@pt{\engine@galcx+\engine@galpx+.5\engine@galpw}{\engine@galcy-\engine@galpy-.5\engine@galph}
        {\expandafter\includegraphics\expandafter[\engine@galopt]{#1}};
    \end{scope}
  \else
    \node[anchor=center, inner sep=0pt]
      at \engine@pt{\engine@galcx+\engine@galpx+.5\engine@galpw}{\engine@galcy-\engine@galpy-.5\engine@galph}
      {\includegraphics[width=\the\engine@galpw, height=\the\engine@galph, keepaspectratio]{#1}};
  \fi}

% ---------------------------------------------------------------------------
% status lists: \begin{enginestatus} \done ... \warn<2-> ... \fail ... \item ... \end{enginestatus}
% (the Quarto filter writes it for - [x] / [!] / [-] items in a card or a .status list): beamer's
% itemize, each status item's glyph as its label (where the bullet is, as HTML's and the pptx's),
% bold in its status color (livery.sty's EngineGlyph*), a failed item's text muted to its end, a
% sub-list included (the list's next item restores the text color). \done, \warn and \fail exist
% only inside the environment (a document's own macros of those names are untouched) and take an
% overlay spec as \item does. \engineglyph{done|warn|fail} is the glyph anywhere (a table cell).
% ---------------------------------------------------------------------------
\def\engine@glyph@done{✓}\def\engine@glyph@warn{⚠}\def\engine@glyph@fail{✗}
\def\engine@glyphcolor@done{EngineGlyphDone}\def\engine@glyphcolor@warn{EngineGlyphWarn}\def\engine@glyphcolor@fail{EngineGlyphFail}
\newcommand\engineglyph[1]{{\textcolor{\csname engine@glyphcolor@#1\endcsname}{\bfseries\csname engine@glyph@#1\endcsname}}}
\def\engine@statusmute@done{}\def\engine@statusmute@warn{}\def\engine@statusmute@fail{\color{BrandMuted}}
\def\engine@statusitem#1{\@ifnextchar<{\engine@statusitem@{#1}}{\engine@statusitem@@{#1}}}
\def\engine@statusitem@#1<#2>{\item<#2>[\engineglyph{#1}]\csname engine@statusmute@#1\endcsname}
\def\engine@statusitem@@#1{\item[\engineglyph{#1}]\csname engine@statusmute@#1\endcsname}
\def\engine@statusitemcmd{\ifnum\@listdepth=\engine@statusdepth\relax\usebeamercolor[fg]{normal text}\fi\engine@item}
\newenvironment{enginestatus}{%
  \begin{itemize}%
  \edef\engine@statusdepth{\the\@listdepth}%   the list's own items restore the color; a sub-list's do not
  % beamer's \item is saved once: in a status list nested in a status list, \item is already
  % ours, and saving it again would make \engine@item call itself
  \ifx\item\engine@statusitemcmd\else\let\engine@item\item\fi
  \let\item\engine@statusitemcmd
  \def\done{\engine@statusitem{done}}\def\warn{\engine@statusitem{warn}}\def\fail{\engine@statusitem{fail}}}%
  {\end{itemize}}

% ---------------------------------------------------------------------------
% tables: pandoc's longtable, drawn as the HTML theme draws them -- no top
% rule, a heavy rule in the brand color under the header, a light one at the
% foot, and every second body row on Light Gray.  The Quarto filter wraps
% each header cell in \engineth and starts each banded row with
% \rowcolor{enginetableband}.  Hand-written tabulars are left alone.
% ---------------------------------------------------------------------------
\RequirePackage{colortbl}
\@ifundefined{\string\color@enginetableband}{\colorlet{enginetableband}{BrandSurface!60!BrandBackground}}{}% or livery.sty's
\@ifundefined{\string\color@enginetablerule}{\colorlet{enginetablerule}{BrandText!20!BrandSurface}}{}
\newcommand\engineth[1]{{\usebeamercolor[fg]{normal text}\bfseries
  \fontsize{\fpeval{0.8*\f@size}pt}{\fpeval{0.8*\strip@pt\dimexpr\f@baselineskip\relax}pt}%
  \selectfont\engine@tracking\MakeUppercase{#1}}}
% small caps' letter spacing: type.tracking (em; livery.sty), fontspec's LetterSpace is in percent of the em
\def\engine@tracking{\@ifpackageloaded{fontspec}{\addfontfeatures{LetterSpace=\fpeval{100*\engine@type@tracking}}}{}}
% \arrayrulecolor is global, so put it back after each table
\AddToHook{env/longtable/begin}{%
  \let\engine@arc\CT@arc@
  \setlength\aboverulesep{0pt}\setlength\belowrulesep{0pt}%
  \setlength\extrarowheight{0pt}%
  \def\toprule{}%
  \def\midrule{\arrayrulecolor{BrandPrimaryContrast}\specialrule{1.5pt}{0.3ex}{0pt}}%
  \def\bottomrule{\arrayrulecolor{enginetablerule}\specialrule{0.6pt}{0pt}{0pt}}}
\AddToHook{env/longtable/end}{\global\let\CT@arc@\engine@arc}

% ---------------------------------------------------------------------------
% misc
% ---------------------------------------------------------------------------
% an allowframebreaks frame's pages numbered, (1), (2), only when it runs to more than one
\setbeamertemplate{frametitle continuation}[singleframecheck][\,(\insertcontinuationcount)]
% beamer's \footnote (\footcite, a hand author's) in the slide footnotes' look (enginefootnotes): the
% text muted, the mark in the accent and bold (the color and font themes), under the same short rule
\setbeamertemplate{footnote}{%   (the mark hangs by boxes.footnote.hang, as \enginefootnote's)
  \parindent 0em\noindent\raggedright\usebeamercolor[fg]{footnote}\usebeamerfont{footnote}%
  \hangindent=\engine@boxes@footnote@hang em\hangafter=1
  \makebox[\engine@boxes@footnote@hang em][l]{\insertfootnotemark}\insertfootnotetext\par}
% (\engine@footnoterule is a box; \nointerlineskip on both sides places it as LaTeX's \hrule is,
% with no interline glue before it or before the footnote's first line; the gap under it is
% boxes.footnote.gap in the footnote type, as enginefootnotes')
\renewcommand\footnoterule{\kern-3pt\nointerlineskip\hbox{\engine@footnoterule}\nointerlineskip
  {\usebeamerfont{footnote}\kern\engine@boxes@footnote@gap em}}

\mode<all>
