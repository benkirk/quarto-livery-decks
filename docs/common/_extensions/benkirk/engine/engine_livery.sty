\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{engine_livery}[2026/09/30 v2.3 the livery's colors, fonts & logos]
%
% Brand primitives shared by the engine beamer theme and plain documents
% (see examples/paper.tex).  Values follow the 2026 "Vermilion" NSF NCAR /
% UCAR / UCP Brand Guide (pp. 17-21).
%
% Options:
%   livery=<dir>             the livery directory (build/livery.sty, fonts/, logos/); absolute,
%                             or relative to TeX's search path (default: the bundled
%                             liveries/<brand>)
%   brand=ncar|ucar|ucp|ncarucar  the old spelling of livery=liveries/<brand>       (ncar)
%   fonts=brand|bundled|helvetica   the livery's font (poppins is its old spelling), its
%                             bundled copy only, or the sanctioned substitute (default:
%                             brand under XeTeX/LuaTeX, helvetica under pdfTeX)
%   brandedfonts              legacy (v1) spelling of fonts=brand
%   mathfont=serif|lm|stix|pagella|sans|poppins|keep|<font>
%                             math font (default: a serif math font; see
%                             "Math font" below)
%
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=engine,prefix=engine@}
\DeclareStringOption[]{livery}
\DeclareStringOption[ncar]{brand}
\DeclareStringOption[auto]{fonts}
\DeclareStringOption[serif]{mathfont}
\DeclareVoidOption{brandedfonts}{\def\engine@fonts{poppins}}
\ProcessKeyvalOptions*

\RequirePackage{iftex}
\RequirePackage{xcolor}
\RequirePackage{graphicx}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% The livery: palette, roles (BrandPrimary, BrandPrimaryText, BrandPrimaryContrast,
% BrandSecondary, BrandAccent, BrandHighlight, BrandText, BrandBackground, BrandMuted,
% BrandSurface, BrandWarning, BrandDark), blends, logos, fonts and geometry, generated into
% build/livery.sty by livery_build.py; its overrides/livery-extra.sty is appended there.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\ifx\engine@livery\@empty\edef\engine@livery{liveries/\engine@brand}\fi
\edef\engineliverydir{\engine@livery/}
\InputIfFileExists{\engineliverydir build/livery.sty}{}{%
  \PackageError{engine_livery}{no livery at \engineliverydir: build/livery.sty is missing}
    {Pass livery=<dir> (a directory holding build/livery.sty, from livery_build.py),
     or brand=ncar|ucar|ucp|ncarucar for a bundled one.}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Fonts: the livery's base family (Brand Guide p20: Poppins Bold headlines, Poppins
% Regular body; Helvetica is the sanctioned substitute).
%
%   fonts=brand     the livery's installed-fonts when this machine has them (by name, so
%                   only a livery that names some probes fontconfig), else the bundled
%                   copy where TeX can find it, else an installed system copy of the
%                   family (fonts=poppins is the old spelling)
%   fonts=bundled   always the bundled copy (an error if TeX cannot find it)
%   fonts=helvetica Helvetica (pdfLaTeX) / TeX Gyre Heros (XeLaTeX, LuaLaTeX)
%
% The bundled copy lives in \engine@font@dir (the livery's fonts/), its files named by
% livery.sty, with their extension in \engine@font@ext (.ttf, or .otf for a CFF family).
% The Quarto extension passes an absolute livery directory; plain-LaTeX
% builds find the relative one through kpathsea (TEXINPUTS=<theme>// for logos and
% TTFONTS=<theme>// for fonts).
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\def\engine@tmp{brand}\ifx\engine@fonts\engine@tmp\def\engine@fonts{poppins}\fi
\newif\ifengine@poppins \engine@poppinsfalse
\newif\ifengine@bundledpoppins \engine@bundledpoppinsfalse
\newif\ifengine@installedhead \engine@installedheadfalse
\def\engine@tmp{auto}\ifx\engine@fonts\engine@tmp
  \iftutex\def\engine@fonts{poppins}\else\def\engine@fonts{helvetica}\fi
\fi
\ifdefined\engine@font@ext\else\def\engine@font@ext{.ttf}\fi
\def\engine@tmp{helvetica}\ifx\engine@fonts\engine@tmp\else
  \iftutex
    \RequirePackage{fontspec}
    \def\engine@bundledpoppins{%
      \edef\engine@tmp{\noexpand\setsansfont{\engine@font@family}[%
        Scale          = 1.0,  % pandoc sets Scale=MatchLowercase, shrinking the face
        Path           = \engine@font@dir,
        Extension      = \engine@font@ext,
        UprightFont    = \engine@font@regular,
        BoldFont       = \engine@font@bold,
        ItalicFont     = \engine@font@italic,
        BoldItalicFont = \engine@font@bolditalic,
        \ifdefined\engine@font@semibold FontFace = {sb}{n}{\engine@font@semibold},\fi]}%
      \engine@tmp\engine@poppinstrue\engine@bundledpoppinstrue}
    % installed-fonts (livery.sty's \engine@installed@base|head@<face>, full names): the
    % base faces, and the headings faces as \engineheadingfont when this machine has them
    \def\engine@installedfonts{%
      \edef\engine@tmp{\noexpand\setsansfont{\engine@installed@base@regular}[%
        Scale = 1.0,
        \ifdefined\engine@installed@base@bold BoldFont = \engine@installed@base@bold,\fi
        \ifdefined\engine@installed@base@italic ItalicFont = \engine@installed@base@italic,\fi
        \ifdefined\engine@installed@base@bolditalic BoldItalicFont = \engine@installed@base@bolditalic,\fi
        \ifdefined\engine@installed@base@semibold FontFace = {sb}{n}{\engine@installed@base@semibold},\fi]}%
      \engine@tmp\engine@poppinstrue
      \ifdefined\engine@installed@head@regular
        \edef\engine@tmp{\noexpand\IfFontExistsTF{\engine@installed@head@regular}}%
        \engine@tmp{%
          \edef\engine@tmp{\noexpand\newfontfamily\noexpand\engineheadingfont{\engine@installed@head@regular}[%
            Scale = 1.0,
            \ifdefined\engine@installed@head@bold BoldFont = \engine@installed@head@bold,\fi
            \ifdefined\engine@installed@head@italic ItalicFont = \engine@installed@head@italic,\fi
            \ifdefined\engine@installed@head@bolditalic BoldItalicFont = \engine@installed@head@bolditalic,\fi]}%
          \engine@tmp\engine@installedheadtrue}{}%
      \fi}
    % The bundled copy first, looked up as a file (kpathsea).  Probing the
    % system by name goes through fontconfig, which on a TeX Live whose
    % font cache is cold (Overleaf, each compile) takes longer than a
    % free-plan compile is allowed -- and then found nothing anyway.
    \def\engine@brandfonts{%
      \edef\engine@tmp{\noexpand\IfFontExistsTF{\engine@font@dir\engine@font@regular\engine@font@ext}}%
      \engine@tmp{\engine@bundledpoppins}{%
        \edef\engine@tmp{\noexpand\IfFontExistsTF{\engine@font@family}}%
        \engine@tmp{%
          \edef\engine@tmp{\noexpand\setsansfont{\engine@font@family}[Scale=1.0,FontFace={sb}{n}{Font=* SemiBold}]}%
          \engine@tmp\engine@poppinstrue
        }{\engine@bundledpoppins}}}
    \def\engine@tmp{bundled}\ifx\engine@fonts\engine@tmp
      \engine@bundledpoppins
    \else\ifdefined\engine@font@installed
      \edef\engine@tmp{\noexpand\IfFontExistsTF{\engine@installed@base@regular}}%
      \engine@tmp{\engine@installedfonts}{\engine@brandfonts}%
    \else
      \engine@brandfonts
    \fi\fi
  \else
    \PackageWarningNoLine{engine_livery}{fonts=\engine@fonts\space needs XeLaTeX or
      LuaLaTeX; falling back to Helvetica}%
  \fi
\fi

% the headings family (typography.headings with files of its own, \engine@headfont@* from
% livery.sty): \engineheadingfont, which the font theme gives the titles, unless the
% installed headings faces took its place
\ifengine@installedhead\else\iftutex\ifdefined\engine@headfont@family
  \RequirePackage{fontspec}
  \edef\engine@tmp{\noexpand\newfontfamily\noexpand\engineheadingfont{\engine@headfont@family}[%
    Scale          = 1.0,
    Path           = \engine@headfont@dir,
    Extension      = \engine@headfont@ext,
    UprightFont    = \engine@headfont@regular,
    BoldFont       = \engine@headfont@bold,
    ItalicFont     = \engine@headfont@italic,
    BoldItalicFont = \engine@headfont@bolditalic]}%
  \engine@tmp
\fi\fi\fi

\ifengine@poppins\else
  \iftutex
    \RequirePackage{fontspec}
    \IfFontExistsTF{TeX Gyre Heros}{\setsansfont{TeX Gyre Heros}[Scale=1.0]}{}%
  \else
    \IfFileExists{lmodern.sty}{\RequirePackage{lmodern}}{}% Type 1 outlines for T1 (esp. the code font): no bitmap fonts
    \RequirePackage[T1]{fontenc}
    \IfFileExists{helvet.sty}{\RequirePackage[scaled=0.92]{helvet}}{}%
  \fi
\fi

% Poppins has no warning sign or arrows: borrow them from DejaVu Sans (TeX
% Live's copy, by file name), so `## ⚠︎ Title' and `A → B' need no raw LaTeX.
% U+FE0E (text presentation, which keeps browsers off the emoji) prints nothing.
\iftutex
  \IfFontExistsTF{DejaVuSans.ttf}{%
    \RequirePackage{newunicodechar}%
    \newfontfamily\engine@symbols{DejaVuSans}[Extension=.ttf, BoldFont=*-Bold]%
    % the bookmark gets the character itself (read here, before it turns active)
    \def\engine@symbol#1#2{\texorpdfstring{{\engine@symbols\symbol{#1}}}{#2}}%
    \AtBeginDocument{\providecommand\texorpdfstring[2]{#1}}%
    \newunicodechar{^^^^26a0}{\engine@symbol{"26A0}{^^^^26a0}}%
    \newunicodechar{^^^^2192}{\engine@symbol{"2192}{^^^^2192}}%
    \newunicodechar{^^^^2190}{\engine@symbol{"2190}{^^^^2190}}%
    \newunicodechar{^^^^2194}{\engine@symbol{"2194}{^^^^2194}}%
    \newunicodechar{^^^^21d2}{\engine@symbol{"21D2}{^^^^21d2}}%
    \newunicodechar{^^^^fe0e}{}%
  }{}
\fi

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Math font (mathfont=)
%
% Poppins has no math.  Left alone, beamer sets math letters in Poppins
% Italic among Computer Modern symbols, which reads as a novelty face once an
% equation has any weight to it.  The default is a serif math font, scaled
% up a little to sit with Poppins' large x-height (unicode-math, so under
% XeLaTeX or LuaLaTeX; pdfLaTeX gets Computer Modern math).
%
%   mathfont=serif    New Computer Modern Math (Book), else Latin Modern Math
%   mathfont=lm       Latin Modern Math
%   mathfont=stix     STIX Two Math
%   mathfont=pagella  TeX Gyre Pagella Math
%   mathfont=sans     a sans math font: Lete Sans Math (else Fira Math)
%   mathfont=fira     Fira Math
%   mathfont=poppins  beamer's sans math: Poppins letters, CM symbols (the
%                     look of theme versions before 2.3)
%   mathfont=keep     leave the document's math setup alone
%   mathfont=<font>   any OpenType math font, by name or file
%
% Presets fall back to the document's math font, with a warning, if the font
% is not installed.  The beamer theme reads \ifengine@cmmath for pdfLaTeX.
%
% \enginemathfont{<preset or font>} selects one later in the preamble, and
% \enginemathversion{<version>}{<preset or font>} sets one up as a math version
% for comparing them in one document (examples/mathfonts.tex):
% \mathversion{<version>} switches to it.  (poppins cannot be a version:
% unicode-math's range= ignores version=.)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newif\ifengine@cmmath \engine@cmmathfalse
\def\engine@mathversionopt{}
% \engine@setmath{<font>}{<fontspec options>}: the math font, if it exists
\def\engine@setmath#1#2{%
  \IfFontExistsTF{#1}{%
    \@ifpackageloaded{unicode-math}{}{\RequirePackage{unicode-math}}%
    \edef\engine@tmp{\noexpand\setmathfont{#1}[\unexpanded{#2},\engine@mathversionopt]}%
    \engine@tmp
  }{%
    \PackageWarningNoLine{engine_livery}{math font "#1" not found; keeping
      the document's math font}%
    % a math version must still exist to switch to: Latin Modern Math there
    \ifx\engine@mathversionopt\@empty\else
      \@ifpackageloaded{unicode-math}{}{\RequirePackage{unicode-math}}%
      \edef\engine@tmp{\noexpand\setmathfont{latinmodern-math.otf}[\engine@mathversionopt]}%
      \engine@tmp
    \fi}}
% \engine@setmathor{<font>}{<fallback font>}{<options>}
\def\engine@setmathor#1#2#3{\IfFontExistsTF{#1}{\engine@setmath{#1}{#3}}{\engine@setmath{#2}{#3}}}
% Scale: between matching Poppins' x-height (1.27 for Computer Modern) and
% its cap height (1.02), so lowercase reads and capitals do not shout
\@namedef{engine@mathpreset@serif}{\engine@setmathor{NewCMMath-Book.otf}{latinmodern-math.otf}{Scale=1.10}}
\@namedef{engine@mathpreset@lm}{\engine@setmath{latinmodern-math.otf}{Scale=1.10}}
\@namedef{engine@mathpreset@stix}{\engine@setmath{STIXTwoMath-Regular.otf}{Scale=1.10}}
\@namedef{engine@mathpreset@pagella}{\engine@setmath{texgyrepagella-math.otf}{Scale=1.08}}
\@namedef{engine@mathpreset@sans}{\engine@setmathor{LeteSansMath.otf}{FiraMath-Regular.otf}{Scale=1.10}}
\@namedef{engine@mathpreset@fira}{\engine@setmath{FiraMath-Regular.otf}{Scale=1.02}}
\@namedef{engine@mathpreset@keep}{}
% poppins: nothing, and beamer substitutes Poppins for the letters at
% \begin{document}.  If unicode-math is already loaded (Quarto's template
% loads it), it has disabled that substitution, so lay Poppins over the
% letter and digit ranges of Latin Modern Math instead.
\@namedef{engine@mathpreset@poppins}{%
  \@ifpackageloaded{unicode-math}{%
    \engine@setmath{latinmodern-math.otf}{Scale=1.0}%
    \ifengine@bundledpoppins
      \edef\engine@tmp{\noexpand\setmathfont{\engine@font@italic\engine@font@ext}[range=it/{latin,Latin},
        Path=\engine@font@dir,\engine@mathversionopt]%
        \noexpand\setmathfont{\engine@font@regular\engine@font@ext}[range=up/{latin,Latin,num},
        Path=\engine@font@dir,\engine@mathversionopt]}%
      \engine@tmp
    \else\ifengine@poppins
      \edef\engine@tmp{\noexpand\setmathfont{\engine@font@family\space Italic}[range=it/{latin,Latin},\engine@mathversionopt]%
        \noexpand\setmathfont{\engine@font@family}[range=up/{latin,Latin,num},\engine@mathversionopt]}%
      \engine@tmp
    \fi\fi
  }{}}
% \engine@mathselect{<preset or font>}
\def\engine@mathselect#1{%
  \ifcsname engine@mathpreset@#1\endcsname
    \csname engine@mathpreset@#1\endcsname
  \else
    \engine@setmath{#1}{Scale=MatchLowercase}%
  \fi}
\newcommand\enginemathfont[1]{%
  \iftutex\engine@mathselect{#1}\else
    \PackageWarningNoLine{engine_livery}{\string\enginemathfont\space needs
      XeLaTeX or LuaLaTeX}%
  \fi}
\newcommand\enginemathversion[2]{%
  \iftutex
    \def\engine@mathversionopt{version=#1}%
    \engine@mathselect{#2}%
    \def\engine@mathversionopt{}%
  \else
    \PackageWarningNoLine{engine_livery}{\string\enginemathversion\space needs
      XeLaTeX or LuaLaTeX}%
  \fi}
\iftutex
  \engine@mathselect{\engine@mathfont}%
\else
  \def\engine@tmp{serif}\ifx\engine@mathfont\engine@tmp\engine@cmmathtrue\else
  \def\engine@tmp{poppins}\ifx\engine@mathfont\engine@tmp\else
  \def\engine@tmp{keep}\ifx\engine@mathfont\engine@tmp\else
    \PackageWarningNoLine{engine_livery}{mathfont=\engine@mathfont\space needs
      XeLaTeX or LuaLaTeX; using Computer Modern math}%
    \engine@cmmathtrue
  \fi\fi\fi
\fi

% semibold where available (Poppins SemiBold), else bold
\ifengine@poppins
  \DeclareRobustCommand{\sbseries}{\fontseries{sb}\selectfont}
\else
  \DeclareRobustCommand{\sbseries}{\bfseries}
\fi
\DeclareTextFontCommand{\textsb}{\sbseries}

\newcommand{\supertinyfont}[1]{{\fontsize{5}{6}\selectfont #1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Logos: the livery's light (on white and the surface color) and dark (on the brand
% field) lockups, \engine@logo@light and \engine@logo@dark from livery.sty.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% \enginelogo[<includegraphics opts>]{light|dark}
\newcommand{\enginelogo}[2][height=1cm]{%
  \includegraphics[#1]{\csname engine@logo@#2\endcsname}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Small marks
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage{pifont}
\newcommand{\cmark}{{\color{BrandPrimaryContrast}\ding{51}}}
\newcommand{\xmark}{{\color{BrandText!70}\ding{55}}}
\newcommand{\pmark}{{\color{BrandAccent}\ding{108}}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Code listings
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% loaded unconditionally, as v1 did (existing decks rely on \lstset)
\IfFileExists{listings.sty}{\RequirePackage{listings}}{}
\AddToHook{begindocument/before}{%
  \@ifpackageloaded{listings}{%
    \lstdefinestyle{engine}{
      backgroundcolor=\color{BrandSurface},
      basicstyle=\footnotesize\ttfamily\color{BrandDark},
      keywordstyle=\color{BrandPrimaryContrast}\bfseries,
      commentstyle=\color{BrandText!55}\itshape,
      stringstyle=\color{BrandHighlight},
      numberstyle=\tiny\color{BrandText!50},
      frame=leftline, framerule=2pt, rulecolor=\color{BrandPrimary},
      xleftmargin=6pt, framexleftmargin=4pt, aboveskip=6pt, belowskip=6pt,
      columns=fullflexible, keepspaces=true,
      breaklines=true, showstringspaces=false, captionpos=b,
      numbers=none, numbersep=5pt, tabsize=2,
    }%
    \lstdefinestyle{ncar}{style=engine}% the style's old name
    \lstset{style=engine}%
  }{}%
}

\endinput
