{
  "text-color": "$dark",
  "background-color": "$surface",
  "line-number-color": "$muted",
  "line-number-background-color": null,
  "text-styles": {
    "Keyword": {
      "text-color": "$primary-contrast",
      "bold": true
    },
    "ControlFlow": {
      "text-color": "$primary-contrast",
      "bold": true
    },
    "DataType": {
      "text-color": "$foreground"
    },
    "BuiltIn": {
      "text-color": "$foreground"
    },
    "Function": {
      "text-color": "$foreground",
      "bold": true
    },
    "Operator": {
      "text-color": "$dark"
    },
    "DecVal": {
      "text-color": "$highlight"
    },
    "BaseN": {
      "text-color": "$highlight"
    },
    "Float": {
      "text-color": "$highlight"
    },
    "Constant": {
      "text-color": "$highlight"
    },
    "Char": {
      "text-color": "$highlight"
    },
    "SpecialChar": {
      "text-color": "$highlight"
    },
    "String": {
      "text-color": "$highlight"
    },
    "VerbatimString": {
      "text-color": "$highlight"
    },
    "SpecialString": {
      "text-color": "$highlight"
    },
    "Import": {
      "text-color": "$primary-contrast"
    },
    "Preprocessor": {
      "text-color": "$primary-contrast"
    },
    "Attribute": {
      "text-color": "$foreground"
    },
    "Variable": {
      "text-color": "$dark"
    },
    "Extension": {
      "text-color": "$dark"
    },
    "Other": {
      "text-color": "$foreground"
    },
    "Comment": {
      "text-color": "$muted",
      "italic": true
    },
    "Documentation": {
      "text-color": "$muted",
      "italic": true
    },
    "Annotation": {
      "text-color": "$muted",
      "italic": true,
      "bold": true
    },
    "CommentVar": {
      "text-color": "$muted",
      "italic": true,
      "bold": true
    },
    "Information": {
      "text-color": "$muted",
      "italic": true,
      "bold": true
    },
    "Warning": {
      "text-color": "$alert-text",
      "italic": true,
      "bold": true
    },
    "Alert": {
      "text-color": "$alert-text",
      "bold": true
    },
    "Error": {
      "text-color": "$alert-text",
      "bold": true
    },
    "RegionMarker": {
      "text-color": "$muted"
    }
  }
}
