\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerouterthemeEngine}[2026/09/30 v2.3 engine beamer outer theme]
%
% Page furniture, following the brand's slide template (Brand Guide p26):
%   content frames: accent tab at the left edge beside a bold title, hairline
%   rule, the mark top-right (geometry.logo.corner: top-right | top-left | none),
%   page number bottom-left (geometry.pagenumber.corner), and the livery's
%   sign-off lockup at the foot when it has one (signoff.*).
%
% Every page is drawn by the `background' template according to a page
% style: normal | title | section | closing | feature.
%   * frame keys (enginebg=, engineclosing) set \engine@framestyle locally, so the
%     style holds for every overlay of that frame;
%   * the title/section page templates set \engine@bodystyle globally from
%     inside the frame body; it is reset after each shipout.
%
\mode<presentation>
\@ifpackageloaded{engine_livery}{}{\RequirePackage{engine_livery}}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\providecommand\engine@footer{minimal}
\providecommand\engine@titlestyle{dark}
\@ifundefined{ifengine@framelogo}{\newif\ifengine@framelogo\engine@framelogotrue}{}
\@ifundefined{ifengine@waves}{\newif\ifengine@waves\engine@wavestrue}{}

\def\engine@framestyle{normal}
\def\engine@bodystyle{}
\AddToHook{shipout/after}{\gdef\engine@bodystyle{}}
\def\engine@style{\ifx\engine@bodystyle\@empty\engine@framestyle\else\engine@bodystyle\fi}
% \engine@ifstyle{<style>}{<true>}{<false>}
\def\engine@ifstyle#1{%
  \edef\engine@tmpa{\engine@style}\def\engine@tmpb{#1}%
  \ifx\engine@tmpa\engine@tmpb\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\def\engine@ifplainstyle#1#2{% true for everything except normal frames
  \engine@ifstyle{normal}{#2}{#1}}

% ---------------------------------------------------------------------------
% geometry (relative to the paper, so 16:9, 16:10 and 4:3 all work)
% ---------------------------------------------------------------------------
% (the fractions are the livery's: engine@geom@* in its build/livery.sty)
\newdimen\engine@margin      \engine@margin=\engine@geom@margin\paperwidth
\newdimen\engine@tabwidth    \engine@tabwidth=\engine@geom@tab\paperwidth
\newdimen\engine@logoheight  \engine@logoheight=\engine@geom@logoheight\paperheight
\newdimen\engine@logotop     \engine@logotop=\engine@geom@logotop\paperheight
\providecommand\engine@geom@logocorner{top-right}
\providecommand\engine@geom@pagenumbercorner{bottom-left}
% \engine@ifcorner{<macro>}{<value>}{<true>}{<false>}
\def\engine@ifcorner#1#2{\edef\engine@tmpa{#1}\def\engine@tmpb{#2}%
  \ifx\engine@tmpa\engine@tmpb\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\setbeamersize{text margin left=\engine@margin,text margin right=\engine@margin}

% brand lockup shown at the top right of content frames
\def\engine@framelogo{\enginelogo[height=\engine@logoheight]{light}}
% a user \logo{...} (or Quarto's `logo:') is beamer's secondary logo: set in
% the footline, bottom right, at its natural size (as in beamer's default
% themes and the v1 theme), so beamer reserves room for it and content stops
% above it -- scaled down only if unreasonably tall
\newsavebox\engine@userlogo
\def\engine@userlogorow{%
  \ifbeamertemplateempty{logo}{}{%
    \sbox\engine@userlogo{\insertlogo}%
    \ifdim\ht\engine@userlogo>0.35\paperheight
      \sbox\engine@userlogo{\resizebox{!}{0.15\paperheight}{\usebox\engine@userlogo}}%
    \fi
    \hbox to\paperwidth{\hfil\usebox\engine@userlogo
      \ifdim\wd\engine@userlogo<0.8\paperwidth\hskip\engine@margin\fi}%
    \vskip0.01\paperheight}}
\newdimen\engine@logowidth
\AtBeginDocument{%
  \settowidth\engine@logowidth{\engine@framelogo}%
  \ifengine@framelogo\else\engine@logowidth=0pt\fi
  \engine@ifcorner{\engine@geom@logocorner}{none}{\engine@logowidth=0pt}{}}
% the sign-off lockup (signoff in livery.yml), at the foot, when the livery has one
\def\engine@signoff#1{%
  \ifcsname engine@signoff@#1\endcsname
    \engine@ifcorner{\engine@signoffcorner}{bottom-right}{%
      \node[anchor=south east,inner sep=0pt] at (\paperwidth-\engine@margin,\engine@signoffbottom\paperheight)
        {\includegraphics[height=\engine@signoffheight\paperheight]{\csname engine@signoff@#1\endcsname}};
    }{%
      \node[anchor=south west,inner sep=0pt] at (\engine@margin,\engine@signoffbottom\paperheight)
        {\includegraphics[height=\engine@signoffheight\paperheight]{\csname engine@signoff@#1\endcsname}};
    }%
  \fi}

% ---------------------------------------------------------------------------
% frame title
% ---------------------------------------------------------------------------
\defbeamertemplate*{frametitle}{Engine}{%
  \nointerlineskip
  \@tempdima=\paperwidth
  \advance\@tempdima by -2\engine@margin
  \ifdim\engine@logowidth>0pt
    \engine@ifstyle{normal}{\advance\@tempdima by -\engine@logowidth
      \advance\@tempdima by -0.03\paperwidth}{}%
  \fi
  \setbox\@tempboxa=\vbox{%
    \hsize=\@tempdima \raggedright
    \usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}%
    \strut\insertframetitle\strut\par
    \ifx\insertframesubtitle\@empty\else
      \vskip-0.25ex{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
        \strut\insertframesubtitle\strut\par}%
    \fi}%
  \vbox{%
    \vskip0.045\paperheight
    \hbox{%
      \hskip-\beamer@leftmargin % frametitle is typeset at the text margin
      \engine@ifstyle{normal}{%
        {\usebeamercolor[fg]{frametitle tab}%
         \vrule width\engine@tabwidth height\ht\@tempboxa depth\dp\@tempboxa}%
        \hskip\dimexpr\engine@margin-\engine@tabwidth\relax
        % a top-left mark: the title starts beside it
        \engine@ifcorner{\engine@geom@logocorner}{top-left}{%
          \ifdim\engine@logowidth>0pt\hskip\dimexpr\engine@logowidth+0.03\paperwidth\relax\fi}{}%
      }{\hskip\engine@margin}%
      \box\@tempboxa}%
    \vskip0.6ex
    \engine@ifstyle{normal}{%
      \hbox{{\usebeamercolor[fg]{frametitle rule}%
        \vrule width\dimexpr\paperwidth-2\engine@margin\relax height0.4pt}}%
    }{}%
    \vskip0.02\paperheight}%
}

% ---------------------------------------------------------------------------
% headline (empty -- the logo is drawn on the background) & footline
% ---------------------------------------------------------------------------
\setbeamertemplate{headline}{}
% beamer's default `sidebar right' also typesets \insertlogo (and the
% navigation symbols); the logo lives in our footline instead
\setbeamertemplate{sidebar right}{}
\defbeamertemplate*{footline}{Engine}{%
  \engine@ifstyle{normal}{\engine@footline}{%
    \engine@ifstyle{full}{\engine@footline}{%
    \engine@ifstyle{feature}{{\color{white}\engine@footline}}{%
      \vbox to 0.075\paperheight{\vfil}}}}}
\def\engine@footline{%
  \engine@userlogorow
  \vbox to 0.075\paperheight{%
    \vfil
    \hbox to\paperwidth{%
      \hskip\engine@margin
      \engine@ifcorner{\engine@geom@pagenumbercorner}{bottom-right}{}{%
        {\usebeamerfont{page number in head/foot}\insertframenumber}}%
      \def\engine@tmp{full}\ifx\engine@footer\engine@tmp
        \hfil
        {\usebeamerfont{footline}\usebeamercolor[fg]{footline}%
          \ifx\insertsectionhead\@empty\else
            \insertsectionhead\enspace\textbar\enspace\fi
          \insertshorttitle\ifx\insertshortdate\@empty\else
          \enspace\textbar\enspace\insertshortdate\fi}%
      \else\hfil\fi
      \engine@ifcorner{\engine@geom@pagenumbercorner}{bottom-right}{%
        {\usebeamerfont{page number in head/foot}\insertframenumber}}{}%
      \hskip\engine@margin}%
    \vskip0.035\paperheight}}

% ---------------------------------------------------------------------------
% backgrounds
% ---------------------------------------------------------------------------
% The livery's wave lines (art.waves in its livery.yml, three lines of two cubics each,
% from the top edge to the bottom): \engine@wave@<n>@down{<dx>} and @up come from its
% build/livery.sty, with \engine@waveshift@<kind>. A livery without them draws none.
\newif\ifengine@haswaves
\ifdefined\engine@wave@i@down\engine@haswavestrue\fi
% \engine@wdown{<n>}{<dx>} / \engine@wup{<n>}{<dx>}: line n (1-3), shifted right by dx
\def\engine@wdown#1#2{\csname engine@wave@\romannumeral#1 @down\endcsname{#2}}
\def\engine@wup#1#2{\csname engine@wave@\romannumeral#1 @up\endcsname{#2}}
% \engine@field{<n>}{<dx>}{<fill>}: fill the page left of line n (the left half without waves)
\def\engine@field#1#2#3{%
  \ifengine@haswaves
    \fill[#3] (0,0) -- (0,\paperheight) -- \engine@wdown{#1}{#2} -- cycle;
  \else
    \fill[#3] (0,0) rectangle (0.5\paperwidth,\paperheight);
  \fi}
% \engine@band{<n>}{<m>}{<dx>}{<fill>}{<opacity>}: fill between lines n and m
\def\engine@band#1#2#3#4#5{%
  \ifengine@haswaves\fill[#4,opacity=#5] \engine@wdown{#1}{#3} -- \engine@wup{#2}{#3} -- cycle;\fi}
% \engine@lines{<dx>}{<color>}: the three lines
\def\engine@lines#1#2{%
  \ifengine@haswaves
    \draw[#2,line width=0.8pt] \engine@wdown{1}{#1};
    \draw[#2,line width=0.8pt] \engine@wdown{2}{#1};
    \draw[#2,line width=0.8pt] \engine@wdown{3}{#1};
  \fi}
% \engine@waves{<dx>}{<color>}: lines with the brand's translucent bands between
% them (the "banded color transition blocks", Brand Guide p24)
\def\engine@waves#1#2{%
  \ifengine@haswaves
    \engine@band{1}{2}{#1}{#2}{0.18}%
    \engine@band{2}{3}{#1}{#2}{0.10}%
    \engine@lines{#1}{#2}%
  \fi}

% cover-scaled image clipped to the region right of line 1
\newsavebox\engine@imgbox
\def\engine@photo#1{% #1 = image box
  \begin{scope}
    \ifengine@haswaves
      \clip \engine@wdown{1}{0} -- (\paperwidth,0) -- (\paperwidth,\paperheight) -- cycle;
    \else
      \clip (0.5\paperwidth,0) rectangle (\paperwidth,\paperheight);
    \fi
    \node[anchor=north east,inner sep=0pt] at (\paperwidth,\paperheight) {#1};
  \end{scope}}
% \engine@coverbox{<width>}{<height>}{<image-or-box>}: scale to cover
\newcommand\engine@coverbox[3]{%
  \sbox\engine@imgbox{#3}%
  \@tempdima=\dimexpr#2*\wd\engine@imgbox/\ht\engine@imgbox\relax
  \ifdim\@tempdima<#1\relax
    \resizebox{#1}{!}{\usebox\engine@imgbox}%
  \else
    \resizebox{!}{#2}{\usebox\engine@imgbox}%
  \fi}

% field behind the title/closing slides (title=dark|light)
\def\engine@tmp{light}\ifx\engine@titlestyle\engine@tmp
  \colorlet{EngineTitleField}{BrandBackground}\else\colorlet{EngineTitleField}{BrandPrimary}\fi
\def\engine@titlefield{EngineTitleField}

% \engine@art{<kind>}: the livery's static background for a slide kind, if it names one
\def\engine@art#1{%
  \ifcsname engine@art@#1\endcsname
    \node[anchor=south west,inner sep=0pt] at (0,0)
      {\includegraphics[width=\paperwidth,height=\paperheight]{\csname engine@art@#1\endcsname}};
  \fi}

\defbeamertemplate*{background}{Engine}{%
  \begin{tikzpicture}[x=1pt,y=1pt]
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \engine@ifstyle{normal}{%
      \engine@art{content}%
      \ifengine@waves\engine@lines{\engine@waveshift@content}{BrandSurface}\fi
      \ifengine@framelogo
        \engine@ifcorner{\engine@geom@logocorner}{top-left}{%
          \node[anchor=north west,inner sep=0pt]
            at (\engine@margin,\paperheight-\engine@logotop) {\engine@framelogo};
        }{\engine@ifcorner{\engine@geom@logocorner}{none}{}{%
          \node[anchor=north east,inner sep=0pt]
            at (\paperwidth-\engine@margin,\paperheight-\engine@logotop) {\engine@framelogo};
        }}%
      \fi
      \engine@signoff{light}%
    }{}%
    \engine@ifstyle{title}{\engine@drawtitlebg}{}%
    \engine@ifstyle{closing}{\engine@drawclosingbg}{}%
    \engine@ifstyle{section}{\engine@drawsectionbg}{}%
    \engine@ifstyle{feature}{\engine@drawfeaturebg}{}%
    \engine@ifstyle{full}{\engine@drawfullbg}{}%
  \end{tikzpicture}}

% title page: field + (photo | waves).  With a photo, the brand's cover: the
% field runs to line 2, is translucent between lines 2 and 3, and the photo
% shows right of that.
\def\engine@drawtitlebg{%
  \ifx\inserttitlegraphic\@empty
    \engine@drawclosingbg
  \else
    \engine@photo{\engine@coverbox{0.52\paperwidth}{\paperheight}{\inserttitlegraphic}}%
    \engine@field{2}{0}{\engine@titlefield}%
    \engine@band{2}{3}{0}{\engine@titlefield}{0.65}%
    \engine@lines{0}{BrandSecondary}%
    \engine@signoff{dark}%
  \fi}
\def\engine@drawclosingbg{%
  \fill[\engine@titlefield] (0,0) rectangle (\paperwidth,\paperheight);
  \engine@ifstyle{title}{\engine@art{title}}{\engine@art{closing}}%
  \engine@waves{\engine@waveshift@title}{BrandSecondary}%
  \engine@signoff{dark}}
\def\engine@drawsectionbg{%
  \fill[BrandPrimary] (0,0) rectangle (\paperwidth,\paperheight);
  \engine@art{section}%
  \engine@waves{\engine@waveshift@section}{BrandSecondary}%
  \engine@signoff{dark}}
\def\engine@drawfeaturebg{%
  \node[anchor=center,inner sep=0pt] at (0.5\paperwidth,0.5\paperheight)
    {\engine@coverbox{\paperwidth}{\paperheight}{\includegraphics{\engine@featureimage}}};
  \ifx\engine@featuretitle\@empty\else\ifx\beamer@frametitle\@empty\else
    \fill[BrandDark,opacity=0.72] (0,\paperheight) rectangle
      (\paperwidth,\paperheight-\engine@featuretitle);
  \fi\fi}

% full frame: the image contained (never cropped) between a thin margin and
% the footline, with the caption line, if any, just above the footline
\newdimen\engine@fullpad    \engine@fullpad=\engine@geom@fullpad\paperwidth
\newdimen\engine@fullfloor
\def\engine@drawfullbg{%
  \engine@fullfloor=\engine@geom@fullfloor\paperheight
  \ifx\engine@fullcaption\@empty\else
    \node[anchor=south,inner sep=0pt,text width=0.8\paperwidth,align=center,
      font=\scriptsize,text=BrandMuted] at (0.5\paperwidth,\engine@fullfloor) {\engine@fullcaption};
    \advance\engine@fullfloor \engine@geom@fullcaption\paperheight
  \fi
  \node[anchor=center,inner sep=0pt]
    at (0.5\paperwidth,{0.5*(\paperheight-\engine@fullpad+\engine@fullfloor)})
    {\includegraphics[width=\dimexpr\paperwidth-2\engine@fullpad\relax,
      height=\dimexpr\paperheight-\engine@fullpad-\engine@fullfloor\relax,
      keepaspectratio]{\engine@fullimage}};}

% ---------------------------------------------------------------------------
% frame keys
% ---------------------------------------------------------------------------
% Frame keys are processed *outside* any group, so everything they change
% must be reset at the start of the next frame.  Beamer applies the
% `environment' key to every frame before the user's keys, which makes it the
% reset point.  Key handlers run inside \setkeys{beamerframe}, where
% \setbeamercolor would clobber keyval's state, so color changes are deferred
% to \engine@framehook; that runs from \beamer@calculateheadfoot, which beamer
% calls right after the keys (\beamer@frametemplate is unusable: `plain'
% replaces it).  Colors touched by the hook are snapshotted at
% \begin{document} and restored on reset.
\def\engine@framehook{}
\def\engine@atframe#1{%
  \expandafter\def\expandafter\engine@framehook\expandafter{\engine@framehook#1}}
\let\engine@calculateheadfoot\beamer@calculateheadfoot
\def\beamer@calculateheadfoot{\engine@framehook\engine@calculateheadfoot}

\def\engine@touchedcolors{normal text,title,subtitle,author,institute,date,%
frametitle,framesubtitle,structure,item,subitem,subsubitem,local structure,%
enumerate item,alerted text,block title,block body,block title example,%
block body example,block title alerted,block body alerted}
\def\engine@colorslots{thcfg,thcbg,thcinherits,thcuse}
\def\engine@copycolors#1#2{% #1 -> #2 prefixes, for every touched color & slot
  \@for\engine@c:=\engine@touchedcolors\do{%
    \@for\engine@s:=\engine@colorslots\do{%
      \expandafter\let\csname #2\engine@s @\engine@c\expandafter\endcsname
        \csname #1\engine@s @\engine@c\endcsname}}}
\AtBeginDocument{\engine@copycolors{beamer@}{engine@saved@}}
\def\engine@resetframe{%
  \def\engine@framestyle{normal}\def\engine@featuretitle{}%
  \def\engine@framehook{}\engine@translucentfalse
  \engine@copycolors{engine@saved@}{beamer@}}
\let\engine@envkey\KV@beamerframe@environment
\def\KV@beamerframe@environment#1{\engine@resetframe\engine@envkey{#1}}

% [enginebg=<image>]: full-bleed photo; no logo (never on busy photos)
\define@key{beamerframe}{enginebg}{%
  \def\engine@framestyle{feature}\def\engine@featureimage{#1}%
  \def\engine@featuretitle{0.2\paperheight}%
  \engine@atframe{%
    \setbeamercolor{frametitle}{fg=white}%
    \setbeamercolor{framesubtitle}{fg=BrandSecondary}%
    \engine@featureblocks}}
% [enginefull=<image>]: the image fills the frame; no title, logo, rule or
% waves, the frame number kept.  \enginefullcaption{...} in the body (global:
% the background is drawn after the body) adds a caption line.
\define@key{beamerframe}{enginefull}{%
  \def\engine@framestyle{full}\def\engine@fullimage{#1}\gdef\engine@fullcaption{}}
\def\engine@fullcaption{}
\newcommand\enginefullcaption[1]{\gdef\engine@fullcaption{#1}}
% [engineclosing]: brand field, like the title slide
\define@key{beamerframe}{engineclosing}[true]{%
  \def\engine@framestyle{closing}%
  \engine@atframe{\engine@darkfieldcolors}}

% colors for text sitting on the brand field (title=dark) or white (light)
\def\engine@darkfieldcolors{%
  \def\engine@tmp{light}\ifx\engine@titlestyle\engine@tmp\else
    \setbeamercolor{normal text}{fg=BrandPrimaryText}%
    \usebeamercolor[fg]{normal text}%
    \setbeamercolor{title}{fg=BrandPrimaryText}%
    \setbeamercolor{subtitle}{fg=BrandPrimaryText}%
    \setbeamercolor{author}{fg=BrandPrimaryText}%
    \setbeamercolor{institute}{fg=BrandPrimaryText}%
    \setbeamercolor{date}{fg=BrandPrimaryText}%
    \setbeamercolor{frametitle}{fg=BrandPrimaryText}%
    \setbeamercolor{structure}{fg=BrandPrimaryText}%
    \setbeamercolor{item}{fg=BrandPrimaryText}%
    \setbeamercolor{subitem}{fg=BrandPrimaryText}%
    \setbeamercolor{local structure}{fg=BrandPrimaryText}%
    \setbeamercolor{alerted text}{fg=BrandAccent}%
  \fi}

\mode<all>
