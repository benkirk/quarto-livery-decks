{
  "name": "quarto-livery-decks",
  "image": "ghcr.io/benkirk/quarto-livery-decks:main",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "postCreateCommand": "/usr/local/bin/entrypoint.sh true",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "decks (python3 -m http.server)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["quarto.quarto"]
    }
  }
}
