# Make.common in a container: DECKS_RUNTIME=docker, podman or apptainer (docs/container.md
# "From your deck's Makefile"). The goals become ONE run of the same make in the published image:
# this framework checkout's recipes (mounted, so a consumer's pinned framework is the one that
# builds) on the image's toolchain. Host paths are mounted at their own (real) paths, so the deck
# Makefile's relative include, the _quarto.yml/_extensions/_livery links and fragments included
# from ../ resolve alike on both sides. The host needs make (3.81 does) and the runtime, nothing
# else: no Python, no Quarto. Command-line variables (LIVERY=cu, DECKS="a b") reach the inner make
# through MAKEFLAGS; its own DECKS_RUNTIME=native keeps it from dispatching again.

# The image (DECKS_IMAGE, DECKS_IMAGE_TAG, DECKS_CONTAINER_IMAGE) and the installation's SIF of it.
include $(FRAMEWORK_ROOT)common/image.mk
# Apptainer runs that SIF when the installation has one (`make sif`) and nothing names another
# image: a shared checkout's users need no setting. APPTAINER_SIF names any other.
ifeq ($(origin APPTAINER_SIF)$(origin DECKS_IMAGE)$(origin DECKS_CONTAINER_IMAGE),undefinedfilefile)
APPTAINER_SIF := $(wildcard $(sif_file))
endif

# The container's own HOME, on the host, one per release: what your own tools keep in your HOME (a
# conda env's Jupyter and IPython settings, matplotlib's font list, TeX trees, personal fonts)
# never reaches the image's, and the build's caches persist without touching yours. Every runtime
# uses it; the entrypoint seeds matplotlib's font cache into it, and a deck's own packages (`make
# deps`, Make.common's DECKS_DEPS, which the inner make reads under this HOME) install under it.
DECKS_HOME ?= $(HOME)/.cache/quarto-livery-decks/home-$(DECKS_IMAGE_TAG)
ifneq ($(filter command line environment,$(origin DECKS_DEPS)),)
$(warning DECKS_DEPS is for a native build; under $(DECKS_RUNTIME_USED) a deck's packages live under DECKS_HOME=$(DECKS_HOME))
endif

# What the container sees, at the same paths: the deck's repository (its git toplevel, else the
# deck directory), this framework, a LIVERY_DIR outside both, a DECK_META file's directory (a
# prerequisite of every deck: unmounted, the inner make has no rule for it), and DECKS_BINDS, a
# site's file systems (an installation's site.mk sets them; each only where it exists, so one list
# serves hosts with different mounts); FONTS_DIR on /opt/fonts. Real paths: macOS's /tmp and an
# HPC system's linked project directories are symlinks the container lacks.
DECKS_BINDS  ?=
deck_pwd    := $(realpath $(CURDIR))
mount_base   := $(sort $(realpath $(or $(shell git rev-parse --show-toplevel 2>/dev/null),$(CURDIR)) \
                  $(FRAMEWORK_ROOT) $(LIVERY_DIR) $(wildcard $(DECKS_BINDS))) \
                  $(if $(DECK_META),$(patsubst %/,%,$(dir $(realpath $(DECK_META))))))
# Symlinks in the deck directory (an image linked in): a target none of the above covers is mounted
# too, a directory itself or a file's directory, so the link resolves inside. A target whose path
# has a space is skipped with a warning: make splits words on it, so it cannot be a mount (find
# -print0 would not help: make's /bin/sh, dash, has no read -d). (The case patterns' leading "("
# keeps $(shell)'s parentheses balanced.)
linked_targets := $(shell bases='$(mount_base)'; \
  find . -maxdepth 3 \( -name .quarto -o -name '*_files' -o -name _qa \) -prune -o -type l \
    ! -name _quarto.yml ! -name _extensions ! -name _livery -print 2>/dev/null | \
  while read -r l; do t=$$(realpath "$$l" 2>/dev/null) || continue; [ -e "$$t" ] || continue; \
    [ -d "$$t" ] || t=$$(dirname "$$t"); c=; \
    case "$$t" in (*[[:space:]]*) echo "Make.container: not mounting $$t, $$l's target: a path with a space cannot be a mount" >&2; continue;; esac; \
    for m in $$bases; do case "$$t/" in ("$$m"/*) c=1;; esac; done; [ -n "$$c" ] || echo "$$t"; done)
mounts := $(sort $(mount_base) $(linked_targets))
fonts_mount  := $(if $(FONTS_DIR),$(realpath $(FONTS_DIR)))

ifeq ($(DECKS_RUNTIME_USED),docker)
# --user: the outputs are yours; --init: Ctrl-C stops make
container_run = docker run --rm --init --user $(shell id -u):$(shell id -g) -e MAKEFLAGS \
  -v $(DECKS_HOME):$(DECKS_HOME) -e HOME=$(DECKS_HOME) \
  $(foreach m,$(mounts),-v $(m):$(m)) $(if $(fonts_mount),-v $(fonts_mount):/opt/fonts:ro) \
  -w $(deck_pwd) $(DECKS_CONTAINER_IMAGE)
else ifeq ($(DECKS_RUNTIME_USED),podman)
# rootless: the container's root is you. label=disable rather than :Z, which would relabel the
# whole repository and framework for SELinux.
container_run = podman run --rm --init --security-opt label=disable -e MAKEFLAGS \
  -v $(DECKS_HOME):$(DECKS_HOME) -e HOME=$(DECKS_HOME) \
  $(foreach m,$(mounts),-v $(m):$(m)) $(if $(fonts_mount),-v $(fonts_mount):/opt/fonts:ro) \
  -w $(deck_pwd) $(DECKS_CONTAINER_IMAGE)
else ifeq ($(DECKS_RUNTIME_USED),apptainer)
# runs as you, --home the container's own (your real HOME is not mounted); `run`, not `exec`, so
# the entrypoint seeds matplotlib's font cache.
# --cleanenv: the image's environment alone, as under Docker and Podman. Apptainer would pass yours
# in, and what it names need not exist inside (a profile's TMPDIR=$SCRATCH/tmp stopped Quarto,
# LC_ALL=en_US.UTF-8 warned); MAKEFLAGS crosses as APPTAINERENV_MAKEFLAGS, which --cleanenv keeps.
# APPTAINER_SIF: a pulled image, skipping docker://.
container_run = APPTAINERENV_MAKEFLAGS="$$MAKEFLAGS" apptainer run --cleanenv --home $(DECKS_HOME) \
  $(foreach m,$(mounts),--bind $(m)) \
  $(if $(fonts_mount),--bind $(fonts_mount):/opt/fonts:ro) --pwd $(deck_pwd) \
  $(or $(APPTAINER_SIF),docker://$(DECKS_CONTAINER_IMAGE))
else
$(error DECKS_RUNTIME=$(DECKS_RUNTIME): native, docker, podman, apptainer or auto)
endif

# Before the run: is the image there? A release's image appears when its tag is cut, so between
# the version bump and the tag the default (this checkout's version) is not pullable, and the
# runtime's own "manifest unknown" said nothing of what to do (#133). Docker and Podman look
# locally, then pull; Apptainer checks a named SIF (a docker:// pull stays its own, cached).
# the month's tag is offered only for a release's tag (YY.MM.N): `main`, `sha-<commit>` and `pr-N` have no month
image_month = $(if $(word 3,$(subst ., ,$(DECKS_IMAGE_TAG))),DECKS_IMAGE_TAG=$(firstword $(subst ., ,$(DECKS_IMAGE_TAG))).$(word 2,$(subst ., ,$(DECKS_IMAGE_TAG))) (the month's newest) or)
define image_missing
{ echo "quarto-livery-decks: image $(or $(APPTAINER_SIF),$(DECKS_CONTAINER_IMAGE)) is not available." >&2; \
  echo "  A release's image appears when its tag is cut. Build with $(strip $(image_month) DECKS_IMAGE_TAG=latest)," >&2; \
  echo "  or natively after \`source etc/config_env.sh\` (docs/container.md \"Which image\")." >&2; exit 1; }
endef
ifeq ($(DECKS_RUNTIME_USED),apptainer)
image_check = $(if $(APPTAINER_SIF),test -f $(APPTAINER_SIF) || $(image_missing),true)
else
image_check = $(DECKS_RUNTIME_USED) image inspect $(DECKS_CONTAINER_IMAGE) >/dev/null 2>&1 || $(DECKS_RUNTIME_USED) pull $(DECKS_CONTAINER_IMAGE) || $(image_missing)
endif

# Every goal waits on the one run. publish builds the site inside and pushes from here, where
# your git credentials are. A QUARTO_DECKS from the environment (new-deck's Makefile reads it) is
# passed on: the container's environment is the image's, and the deck must include the same
# framework inside as here.
goals := $(or $(MAKECMDGOALS),pptx)
.PHONY: $(goals) decks-container
$(goals): decks-container
	@:
decks-container:
	@echo "DECKS_RUNTIME=$(DECKS_RUNTIME_USED): $(if $(APPTAINER_SIF),$(APPTAINER_SIF),$(DECKS_CONTAINER_IMAGE))" >&2
	@$(image_check)
	@mkdir -p $(DECKS_HOME)
	$(container_run) make $(patsubst publish,site,$(MAKECMDGOALS)) DECKS_RUNTIME=native \
	  $(if $(filter environment,$(origin QUARTO_DECKS)),QUARTO_DECKS=$(QUARTO_DECKS))
ifneq ($(filter publish,$(MAKECMDGOALS)),)
	$(publish_push)
endif
